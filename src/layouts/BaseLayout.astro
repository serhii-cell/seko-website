---
import "@/styles/global.css";
import BaseHead from "@/components/Utility/BaseHead.astro";
import SkipLink from "@/components/Global/SkipLink.astro";
import Nav from "@/components/Global/Nav.astro";
import Footer from "@/components/Global/Footer.astro";
import SmoothScroll from "@/components/Global/SmoothScroll.astro";
import ScrollReveal from "@/components/Global/ScrollReveal.astro";
import PageTransition from "@/components/Global/PageTransition.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fade each block of content in the first time it scrolls into view.
   * Blocks already on screen when the page loads stay as they are.
   */
  reveal?: boolean;
};

const {
  theme = "inherit",
  reveal = false,
  ...seo
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <PageTransition />
    <Nav />
    <main id="main" tabindex="-1" data-reveal={reveal ? "" : undefined}>
      <slot />
    </main>
    <Footer />
    <SmoothScroll />
    {reveal && <ScrollReveal />}
  </body>
</html>
