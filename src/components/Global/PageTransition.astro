---
import Icon from "@/components/Media/Icon.astro";
import logo from "@/assets/logo/logo.svg";
---

<div class="page-transition_curtain" transition:persist aria-hidden="true">
  <div class="page-transition_logo">
    <Icon src={logo} variant="full-width" />
    <div class="page-transition_fill">
      <Icon src={logo} variant="full-width" />
    </div>
  </div>
  <div class="page-transition_bar"></div>
</div>

<script is:inline>
  if (!document.documentElement.classList.contains("stacki-designer")) {
    document.documentElement.classList.add("page-intro");
  }
</script>

<script>
  import { gsap } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";

  const root = document.documentElement;
  const curtainDuration = 1;
  /* The loader shows at least this long, so it never just flashes past. */
  const minimumLoad = 1.3;
  /* Fades start a little before the curtain's edge reaches the first text. */
  const lead = 0.03;

  let played = false;

  /* When the rising curtain's bottom edge passes the top of `anchor`. */
  function edgeTime(anchor: Element | null) {
    if (!anchor) return curtainDuration / 2;
    const top = anchor.getBoundingClientRect().top / innerHeight;
    return riseTime(gsap.utils.clamp(0, 1, 1 - (top - lead)));
  }

  /* When the curtain has risen by `risen`, a share of the screen's height. */
  function riseTime(risen: number) {
    const ease = gsap.parseEase("curtain");
    let low = 0;
    let high = 1;
    for (let step = 0; step < 30; step++) {
      const mid = (low + high) / 2;
      if (ease(mid) < risen) low = mid;
      else high = mid;
    }
    return ((low + high) / 2) * curtainDuration;
  }

  function afterFrames(count: number, done: () => void) {
    let frame = 0;
    const step = () => {
      if (++frame >= count) done();
      else requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  onPage(() => {
    if (played || !root.classList.contains("page-intro")) return;
    played = true;

    const curtain = document.querySelector<HTMLElement>(
      ".page-transition_curtain",
    );
    const bar = curtain?.querySelector<HTMLElement>(".page-transition_bar");
    const started = performance.now();
    let timeline: gsap.core.Timeline | undefined;
    let cancelled = false;

    /* While the page loads, the logo fills and the bar grows most of the way,
       slowing as they go; they finish once it's ready. */
    const loading = curtain
      ? gsap.to(curtain, {
          "--_progress": 0.85,
          duration: 2.5,
          ease: "power2.out",
        })
      : undefined;

    /* Two signals, each sent once and at the latest when the intro ends:
       `page-intro:done` as the curtain is half way up (the hero's ASCII
       container opens), and `page-intro:content` as its edge reaches the
       first heading (the page's first screen of content starts to appear,
       see ScrollReveal). */
    const sent = new Set<string>();
    const signal = (name: string) => {
      if (sent.has(name)) return;
      sent.add(name);
      document.dispatchEvent(new Event(name));
    };
    const reveal = () => signal("page-intro:done");
    const content = () => signal("page-intro:content");

    const finish = () => {
      root.classList.remove("page-intro", "page-intro-playing");
      if (curtain) gsap.set(curtain, { clearProps: "all" });
      if (bar) gsap.set(bar, { clearProps: "opacity" });
      reveal();
      content();
    };

    const play = () => {
      if (cancelled || timeline) return;
      clearTimeout(fallback);
      loading?.kill();
      root.classList.add("page-intro-playing");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const elapsed = (performance.now() - started) / 1000;
      const fill = Math.max(0.35, minimumLoad - elapsed);
      timeline = gsap.timeline({ onComplete: finish });
      if (curtain) {
        timeline
          .to(curtain, {
            "--_progress": 1,
            duration: fill,
            ease: "power1.inOut",
          })
          .to(
            curtain,
            reduced
              ? { opacity: 0, duration: 0.7, ease: "power1.inOut" }
              : { yPercent: -100, duration: curtainDuration, ease: "curtain" },
            "+=0.15",
          )
          .addLabel("rise", "<")
          .call(reveal, undefined, `rise+=${reduced ? 0.35 : riseTime(0.5)}`);
        /* The bar is gone by the time the curtain is halfway up. */
        if (bar) {
          timeline.to(
            bar,
            { opacity: 0, duration: curtainDuration / 2, ease: "power1.out" },
            "rise",
          );
        }
      }
      const enter = curtain
        ? fill +
          0.15 +
          (reduced ? 0.25 : edgeTime(document.querySelector("main .heading")))
        : 0;
      timeline.call(content, undefined, enter);
    };

    /* Waits until the page is loaded, on screen and painting, so a page
       opened in a background tab doesn't play its intro unseen. */
    const onScreen = () => {
      if (document.visibilityState !== "visible") return;
      document.removeEventListener("visibilitychange", onScreen);
      afterFrames(12, () => setTimeout(play, 150));
    };
    const loaded = new Promise<void>((resolve) =>
      document.readyState === "complete"
        ? resolve()
        : addEventListener("load", () => resolve(), { once: true }),
    );
    const fonts = Promise.race([
      document.fonts.ready,
      new Promise((resolve) => setTimeout(resolve, 1500)),
    ]);
    Promise.all([loaded, fonts]).then(() => {
      document.addEventListener("visibilitychange", onScreen);
      onScreen();
    });
    /* Never leave the page covered. */
    const fallback = setTimeout(play, 6000);

    return () => {
      cancelled = true;
      clearTimeout(fallback);
      document.removeEventListener("visibilitychange", onScreen);
      loading?.kill();
      timeline?.kill();
      finish();
    };
  });
</script>

<style is:global>
  @layer components {
    .page-transition_curtain {
      display: none;
    }

    .page-intro {
      & .page-transition_curtain {
        --_progress: 0;
        display: block;
        position: fixed;
        inset: 0;
        /* Above the nav, so the whole page appears from under it. */
        z-index: 101;
        background-color: black;
        pointer-events: none;
      }
    }

    /* The logo in grey, with a white copy over it revealed left to right. */
    .page-transition_logo {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 7.5rem;
      translate: -50% -50%;
      color: color-mix(in lab, var(--light-100) 22%, transparent);
    }

    .page-transition_fill {
      position: absolute;
      inset: 0;
      color: var(--light-100);
      clip-path: inset(0 calc((1 - var(--_progress)) * 100%) 0 0);
    }

    .page-transition_bar {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 0.25rem;
      background-color: var(--brand-500);
      transform-origin: left;
      scale: var(--_progress) 1;
    }
  }
</style>
