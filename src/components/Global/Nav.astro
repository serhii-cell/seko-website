---
import Icon from "@/components/Media/Icon.astro";
import NavLink from "@/components/Global/NavLink.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/logo/logo.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <header class="nav_wrap">
      <div class="nav_inner">
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <NavLink href="#" data-intro>Work</NavLink>
              <NavLink href="#" data-intro>Services</NavLink>
              <NavLink href="#" data-intro>About</NavLink>
              <NavLink href="#" data-intro>Contact</NavLink>
            </ul>
          </div>
        </nav>
        <a class="nav_logo" href="/" aria-label={SITE_NAME} data-intro>
          <Icon src={logo} variant="full-width" />
        </a>
        <div class="nav_aside">
          <p class="nav_clock" data-intro>
            <time class="nav_clock_time">--:-- --</time>
            <span class="nav_clock_place">Ukraine</span>
          </p>
          <Button element="link" href="#" class="nav_button" data-intro>
            Book a Call
          </Button>
        </div>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
    .nav_clock {
      visibility: hidden;
    }
  </style>
</noscript>

<script>
  import { onPage } from "@/utils/lifecycle.ts";

  const kyiv = new Intl.DateTimeFormat("en-US", {
    timeZone: "Europe/Kyiv",
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
  });

  onPage(() => {
    const time = document.querySelector<HTMLTimeElement>(".nav_clock_time");
    if (!time) return;

    let timer = 0;
    const tick = () => {
      const now = new Date();
      time.textContent = kyiv.format(now).replace(/\s+/g, " ");
      time.dateTime = now.toISOString();
      timer = window.setTimeout(tick, 1000 - (now.getTime() % 1000) + 5);
    };
    tick();

    return () => clearTimeout(timer);
  });

  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  /* Scrolling down past the bar hides it: the menus and the clock fade
     out and the logo slides up out of view. Scrolling up brings it back. */
  if (nav) {
    let lastY = scrollY;
    const onScroll = () => {
      const y = scrollY;
      if (nav.classList.contains("open")) {
        lastY = y;
        return;
      }
      if (y < nav.offsetHeight) nav.classList.remove("hidden");
      else if (y > lastY + 4) nav.classList.add("hidden");
      else if (y < lastY - 4) nav.classList.remove("hidden");
      if (Math.abs(y - lastY) > 4) lastY = y;
    };
    addEventListener("scroll", onScroll, { passive: true });
  }

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 64rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    /* Fixed over the page and see-through; only its own parts take clicks,
       so the band it covers stays usable when it hides. */
    .nav_wrap {
      position: fixed;
      inset-inline: 0;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      color: var(--text);
      pointer-events: none;
    }

    .nav_inner {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      min-height: var(--nav-height);
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 0 var(--space-3);
      & > * {
        pointer-events: auto;
      }
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 4.75rem;
      color: color-mix(in lab, currentcolor 30%, transparent);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--light-100);
        }
      }
    }

    .nav_aside {
      display: none;
      align-items: center;
      gap: var(--space-5);
      justify-self: end;
    }

    .nav_clock {
      display: flex;
      align-items: center;
      color: color-mix(in lab, currentcolor 40%, transparent);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-huge);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .nav_clock_time::after {
      content: ",";
    }

    .nav_clock_place {
      margin-left: 0.3em;
    }

    .nav_button.button_wrap {
      min-height: 2.5rem;
      padding-block: 0;
      padding-inline: var(--space-4);
      border-radius: var(--radius-round);
      font-weight: var(--primary-semibold);
    }

    .nav_toggle {
      --_icon-width: 1.125rem;
      --_bar-gap: 0.3125rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      justify-self: end;
      width: 2.5rem;
      height: 2.5rem;
      background-color: var(--background-2);
      border: var(--border-width) solid var(--stroke);
      color: inherit;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: var(--border-width);
      &::before,
      &::after {
        content: "";
        position: absolute;
        left: 0;
        width: 100%;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        transform: translateY(calc(var(--_bar-gap) / -2));
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / 2));
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    /* Below 64rem the menu drops down from the bar. */
    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border: var(--border-width) solid var(--stroke);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--space-4) var(--space-4);
      font-size: var(--text-main);
      & > li + li {
        border-top: var(--border-width) solid var(--stroke);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--brand-500);
      text-decoration: none;
      transition:
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
    }

    /* Hidden on scroll: everything in the bar slides up and fades out
       together, and comes back down from the top. */
    .nav_logo,
    .nav_aside,
    .nav_toggle {
      transition:
        color var(--hover-duration) var(--hover-ease),
        opacity 0.45s var(--open-ease),
        translate 0.55s var(--open-ease),
        visibility 0.55s var(--open-ease);
    }

    .nav_wrap.hidden {
      & .nav_logo,
      & .nav_aside,
      & .nav_toggle {
        opacity: 0;
        visibility: hidden;
        translate: 0 calc(var(--nav-height) * -0.75);
      }
    }

    @media (width >= 64rem) {
      .nav_inner {
        grid-template-columns: 1fr auto 1fr;
      }

      .nav_toggle {
        display: none;
      }

      .nav_logo {
        order: 0;
      }

      .nav_aside {
        display: flex;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background: none;
        border: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_menu {
        transition:
          opacity 0.45s var(--open-ease),
          translate 0.55s var(--open-ease),
          visibility 0.55s var(--open-ease);
      }

      .nav_wrap.hidden .nav_menu {
        opacity: 0;
        visibility: hidden;
        translate: 0 calc(var(--nav-height) * -0.75);
      }

      .nav_links {
        flex-direction: row;
        gap: 0.75rem;
        padding: 0;
        & > li + li {
          border-top: 0;
        }
      }

      /* Pills; the outline turns green on hover. */
      .nav_link {
        display: flex;
        align-items: center;
        min-height: 2.5rem;
        padding: 0 var(--space-3);
        background-color: var(--background);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-round);
        line-height: var(--line-height-huge);
        @media (hover: hover) {
          &:hover {
            border-color: var(--brand-500);
          }
        }
      }
    }

    /* Narrow: the logo leads on the left, the toggle on the right. */
    @media (width < 64rem) {
      .nav_logo {
        order: -1;
      }
    }
  }
</style>
