---
import NavLink from "@/components/Global/NavLink.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/home/hero/seko-logo.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

const links = [
  { label: "Work", href: "#work" },
  { label: "Services", href: "#services" },
  { label: "Payment model", href: "#pricing" },
  { label: "Testimonials", href: "#testimonials" },
];
---

{
  render && (
    <Fragment>
      <div class="nav_frame dashed dashed-bottom" aria-hidden="true">
        <div class="nav_frame_inner dashed dashed-inline" />
      </div>
      <header class="nav_wrap">
        <div class="nav_backdrop dashed dashed-bottom" aria-hidden="true">
          <div class="nav_backdrop_inner dashed dashed-inline" />
        </div>
        <div class="nav_inner">
          <a
            class="nav_logo"
            href="/"
            aria-label={SITE_NAME}
            data-intro
            data-step="1"
          >
            <img
              class="nav_logo_mark"
              src={logo.src}
              width={logo.width}
              height={logo.height}
              alt=""
            />
          </a>
          <div class="nav_call" data-step="3">
            <Button element="link" href="#contact" size="medium" data-intro>
              Book a Call
            </Button>
          </div>
          <button
            class="nav_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
          >
            <span class="nav_toggle_icon" />
          </button>
          <nav class="nav_menu" id="nav-menu" aria-label="Main">
            <div class="nav_menu_inner">
              <ul class="nav_links" data-step="2">
                {links.map((link) => (
                  <NavLink href={link.href} data-intro>
                    {link.label}
                  </NavLink>
                ))}
              </ul>
            </div>
          </nav>
          <div class="nav_aside" data-step="3">
            <p class="nav_clock" data-intro>
              <time class="nav_clock_time">--:-- --</time>, Ukraine
            </p>
            <Button
              element="link"
              href="#contact"
              size="medium"
              class="nav_button"
              data-intro
            >
              Book a Call
            </Button>
          </div>
        </div>
      </header>
    </Fragment>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
    .nav_clock {
      visibility: hidden;
    }
  </style>
</noscript>

<script>
  import { onPage } from "@/utils/lifecycle.ts";

  const kyiv = new Intl.DateTimeFormat("en-US", {
    timeZone: "Europe/Kyiv",
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
  });

  onPage(() => {
    const nav = document.querySelector<HTMLElement>(".nav_wrap");
    if (!nav) return;
    const toggle = nav.querySelector<HTMLButtonElement>(".nav_toggle");
    const time = nav.querySelector<HTMLTimeElement>(".nav_clock_time");
    const logo = nav.querySelector<HTMLAnchorElement>(".nav_logo");
    const cleanups: (() => void)[] = [];
    const listen = (
      target: EventTarget,
      type: string,
      handler: (event: Event) => void,
      options?: AddEventListenerOptions,
    ) => {
      target.addEventListener(type, handler, options);
      cleanups.push(() => target.removeEventListener(type, handler, options));
    };

    /* The live Kyiv clock, ticking on the second. */
    if (time) {
      let timer = 0;
      let shown = "";
      const tick = () => {
        const now = new Date();
        const label = kyiv.format(now).replace(/\s+/g, " ");
        if (label !== shown) {
          shown = label;
          time.textContent = label;
          time.dateTime = now.toISOString();
        }
        timer = window.setTimeout(tick, 60000 - (now.getTime() % 60000) + 5);
      };
      tick();
      cleanups.push(() => clearTimeout(timer));
    }

    /* On the page it links to, the logo scrolls back to the top instead of
       reloading. */
    if (logo) {
      listen(logo, "click", (event) => {
        if (logo.pathname !== location.pathname) return;
        event.preventDefault();
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        scrollTo({ top: 0, behavior: still ? "auto" : "smooth" });
      });
    }

    /* Scroll-spy: the link whose section crosses the line 40% down the
       screen is marked current. */
    const spied = [...nav.querySelectorAll<HTMLAnchorElement>(".nav_link")]
      .map((link) => {
        const id = link.hash.slice(1);
        const section = id ? document.getElementById(id) : null;
        return section ? { link, section } : null;
      })
      .filter((entry) => entry !== null);
    let current: HTMLAnchorElement | null = null;
    const spy = () => {
      const line = innerHeight * 0.4;
      let active: HTMLAnchorElement | null = null;
      for (const { link, section } of spied) {
        const { top, bottom } = section.getBoundingClientRect();
        if (top <= line && bottom > line) active = link;
      }
      if (active === current) return;
      current?.removeAttribute("aria-current");
      active?.setAttribute("aria-current", "location");
      current = active;
    };

    /* Off the top of the page the bar stays, shorter and on a solid
       backdrop, so it never sits on the content. */
    let frame = 0;
    const onScroll = () => {
      nav.classList.toggle("solid", scrollY > 0);
      if (spied.length > 0 && !frame) {
        frame = requestAnimationFrame(() => {
          frame = 0;
          spy();
        });
      }
    };
    listen(window, "scroll", onScroll, { passive: true });
    listen(window, "resize", spy);
    nav.classList.toggle("solid", scrollY > 0);
    spy();
    cleanups.push(() => cancelAnimationFrame(frame));

    if (toggle) {
      const setOpen = (open: boolean) => {
        nav.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", String(open));
      };

      listen(toggle, "click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      nav.querySelectorAll("a").forEach((link) => {
        listen(link, "click", () => setOpen(false));
      });

      listen(document, "keydown", (event) => {
        if (
          (event as KeyboardEvent).key === "Escape" &&
          nav.classList.contains("open")
        ) {
          setOpen(false);
          toggle.focus();
        }
      });

      listen(document, "click", (event) => {
        const target = event.target;
        if (!nav.classList.contains("open") || !(target instanceof Node)) return;
        if (!nav.contains(target)) setOpen(false);
      });

      /* Tabbing past the last link closes the menu behind it. */
      listen(nav, "focusout", (event) => {
        const next = (event as FocusEvent).relatedTarget;
        if (!nav.classList.contains("open") || !(next instanceof Node)) return;
        if (!nav.contains(next)) setOpen(false);
      });

      listen(matchMedia("(width >= 64rem)"), "change", (event) => {
        if ((event as MediaQueryListEvent).matches) setOpen(false);
      });

      cleanups.push(() => setOpen(false));
    }

    return () => {
      cleanups.forEach((cleanup) => cleanup());
      nav.classList.remove("solid");
    };
  });
</script>

<style is:global>
  @layer components {
    /* The header's share of the page frame: the working area's rails and a
       rule across the page under the bar. It stays at the top of the page
       while the bar itself is fixed. */
    .nav_frame {
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: var(--nav-height);
      display: flex;
      justify-content: center;
      pointer-events: none;
    }

    .nav_frame_inner {
      width: var(--site-width);
      max-width: var(--max-width-frame);
      height: 100%;
    }

    /* Fixed over the page and see-through; only its own parts take clicks,
       so the band it covers stays usable when it hides. */
    .nav_wrap {
      --_inset: var(--space-7);
      position: fixed;
      inset-inline: 0;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      color: var(--text);
      pointer-events: none;
      @media (width < 48rem) {
        --_inset: var(--site-gutter);
      }
    }

    /* The bar's own backdrop once the page is scrolled: the page colour, the
       working area's rails and a rule across the page, as at the top. */
    .nav_backdrop {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: center;
      background-color: var(--background);
      opacity: 0;
      visibility: hidden;
    }

    .nav_backdrop_inner {
      width: var(--site-width);
      max-width: var(--max-width-frame);
      height: 100%;
    }

    .nav_wrap.solid {
      & .nav_backdrop {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }
      & .nav_inner {
        min-height: var(--nav-height-compact);
      }
    }

    /* Inset from inside the rails, as Figma counts them. */
    .nav_inner {
      position: relative;
      width: var(--site-width);
      max-width: var(--max-width-frame);
      min-height: var(--nav-height);
      transition: min-height var(--open-duration) var(--open-ease);
      padding-inline: calc(var(--_inset) + var(--border-width));
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 0 var(--space-3);
      & > * {
        pointer-events: auto;
      }
    }

    /* The wordmark: 30% at rest, 60% on hover and focus, full when pressed. */
    .nav_logo {
      display: flex;
      align-items: center;
      justify-self: start;
      width: 4.75rem;
      max-width: 100%;
      border-radius: 0.125rem;
      opacity: 0.3;
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
      &:focus-visible {
        opacity: 0.6;
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: 0;
      }
      &:active {
        opacity: 1;
      }
    }

    .nav_logo_mark {
      display: block;
      width: 100%;
      height: auto;
    }

    .nav_aside {
      display: none;
      align-items: center;
      gap: var(--space-5);
    }

    /* Book a Call beside the toggle while the aside is folded away. */
    .nav_call {
      display: flex;
    }

    .nav_clock {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      margin: 0;
      color: color-mix(in lab, currentcolor 40%, transparent);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-huge);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
      /* Between 64rem and 75rem the pills and the button need the room. */
      @media (width < 75rem) {
        display: none;
      }
    }

    .nav_toggle {
      --_icon-width: 1.125rem;
      --_bar-gap: 0.3125rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      justify-self: end;
      width: 2.5rem;
      height: 2.5rem;
      background-color: var(--background);
      border: var(--border-width) solid var(--stroke);
      border-radius: var(--radius-round);
      color: var(--brand-500);
      transition: border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: var(--brand-500);
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: var(--border-width);
      &::before,
      &::after {
        content: "";
        position: absolute;
        left: 0;
        width: 100%;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        transform: translateY(calc(var(--_bar-gap) / -2));
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / 2));
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    /* Below 64rem the menu drops down from the bar. */
    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border: var(--border-width) solid var(--stroke);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--_inset) var(--space-4);
      font-size: var(--text-main);
      & > li + li {
        border-top: var(--border-width) solid var(--stroke);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--brand-500);
      line-height: var(--line-height-huge);
      text-decoration: none;
      transition:
        color var(--hover-duration) var(--hover-ease),
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      &[aria-current] {
        color: var(--brand-300);
      }
    }

    .nav_backdrop {
      transition:
        opacity var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    @media (width >= 64rem) {
      .nav_inner {
        display: flex;
        justify-content: flex-start;
        gap: 3.5rem;
      }

      .nav_toggle,
      .nav_call {
        display: none;
      }

      .nav_aside {
        display: flex;
        margin-left: auto;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background: none;
        border: 0;
        transition: none;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        gap: 0.75rem;
        padding: 0;
        & > li + li {
          border-top: 0;
        }
      }

      /* Outlined; Current marks the section in view. */
      .nav_link {
        display: flex;
        align-items: center;
        height: 2rem;
        padding: 0 0.75rem;
        border: var(--border-width) solid var(--stroke);
        border-radius: var(--radius-button);
        color: var(--text);
        font-size: 0.8125rem;
        font-weight: var(--primary-medium);
        white-space: nowrap;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        transition:
          color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease),
          scale 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        @media (hover: hover) {
          &:hover {
            border-color: color-mix(in lab, var(--text) 40%, transparent);
          }
        }
        &[aria-current] {
          border-color: var(--brand-500);
          color: var(--brand-500);
        }
        &:focus-visible {
          outline: var(--focus-width) solid var(--brand-300);
          outline-offset: 0;
        }
        &:active {
          scale: 0.955 0.925;
        }
      }
    }
  }
</style>
