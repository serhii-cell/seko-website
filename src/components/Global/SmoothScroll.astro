<script>
  import Lenis from "lenis";
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import { bindLenis, guardWheel } from "@/utils/scroll-limits.ts";

  const designing =
    document.documentElement.classList.contains("stacki-designer");

  if (!designing) {
    /* Pages open at the top, a reload included, unless the address points
       at a part of the page. */
    if (!location.hash) scrollTo(0, 0);

    const lenis = new Lenis({
      /* How far the page closes on the wheel each frame: well above Lenis's
         0.1, so the smoothing is only just felt. */
      lerp: 0.35,
      autoToggle: true,
      allowNestedScroll: true,
      respectReducedMotion: true,
      /* Parts of the page that must play through can hold the wheel. */
      virtualScroll: guardWheel,
    });
    bindLenis(lenis);

    lenis.on("scroll", ScrollTrigger.update);

    /* When a media query flips (a phone turned to landscape, say), GSAP
       rebuilds what depends on it and ScrollTrigger refreshes; a pin created
       in that rebuild can leave the page at the top. Put the reader back
       where they were. */
    /* GSAP fires these around a flip; its typings leave them out. */
    const events = gsap as unknown as {
      addEventListener(type: "matchMediaInit", callback: () => void): void;
    };
    let saved: number | null = null;
    events.addEventListener("matchMediaInit", () => {
      if (saved === null) saved = scrollY;
    });
    /* The refresh that follows the flip is the one that moves the page. */
    ScrollTrigger.addEventListener("refresh", () => {
      if (saved === null) return;
      const y = Math.min(saved, ScrollTrigger.maxScroll(window));
      saved = null;
      if (Math.abs(scrollY - y) <= 1) return;
      /* Straight away, so a second flip in the same change (orientation,
         say) records this position rather than the top. */
      window.scrollTo(0, y);
      lenis.scrollTo(y, { immediate: true, force: true });
    });
    gsap.ticker.add((time) => lenis.raf(time * 1000), false, true);
    gsap.ticker.lagSmoothing(0);
  }
</script>

<style is:global>
  @layer components {
    html.lenis,
    html.lenis body {
      height: auto;
    }

    /* The scrollbar's space is always kept. With autoToggle, Lenis holds the
       page's `overflow: hidden` a frame longer than whatever set it (the
       loader, an open modal), so for that frame there is no scrollbar and,
       without this, the whole page shifts sideways and back. */
    html {
      scrollbar-gutter: stable;
    }

    .lenis:not(.lenis-autoToggle).lenis-stopped {
      overflow: clip;
    }

    .lenis [data-lenis-prevent],
    .lenis [data-lenis-prevent-wheel],
    .lenis [data-lenis-prevent-touch],
    .lenis [data-lenis-prevent-vertical],
    .lenis [data-lenis-prevent-horizontal] {
      overscroll-behavior: contain;
    }

    .lenis.lenis-smooth iframe {
      pointer-events: none;
    }

    .lenis.lenis-autoToggle {
      transition-property: overflow;
      transition-duration: 1ms;
      transition-behavior: allow-discrete;
    }
  }
</style>
