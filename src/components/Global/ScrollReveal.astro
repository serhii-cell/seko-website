<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";
  import { createMarker, isMarkerText, type Marker } from "@/utils/marker.ts";

  const blocks = [
    ".section > .container > .layout > * > *",
    ".section > .container > .grid > *",
    ".section > .container > :not(.layout, .grid)",
  ].join(", ");

  onPage(() => {
    const main = document.querySelector<HTMLElement>("main[data-reveal]");
    const designing =
      document.documentElement.classList.contains("stacki-designer");
    if (!main || designing) return;

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", (context) => {
      const targets = gsap.utils
        .toArray<HTMLElement>(blocks, main)
        .filter(
          (block) =>
            !block.hasAttribute("data-intro") &&
            !block.closest('[data-reveal="own"]') &&
            block.getClientRects().length > 0 &&
            getComputedStyle(block).visibility !== "hidden" &&
            !ScrollTrigger.isInViewport(block),
        );
      /* Headings and body text get the marker; everything else fades. */
      const markers = new Map<Element, Marker>(
        targets
          .filter(isMarkerText)
          .map((block) => [block, createMarker(block)]),
      );
      const faders = targets.filter((block) => !markers.has(block));
      const opacity = new Map<Element, string>(
        faders.map((block) => [block, getComputedStyle(block).opacity]),
      );

      const settle = "opacity,visibility";

      const reveal = context.add("reveal", (batch: Element[]) => {
        const passed = batch.filter(
          (block) => block.getBoundingClientRect().bottom <= 0,
        );
        const entering = batch.filter((block) => !passed.includes(block));

        if (passed.length > 0) gsap.set(passed, { clearProps: settle });
        if (entering.length > 0) {
          gsap.to(entering, {
            autoAlpha: (_: number, block: Element) =>
              Number(opacity.get(block)),
            stagger: 0.08,
            clearProps: settle,
          });
        }
      });

      gsap.set(faders, { autoAlpha: 0 });
      ScrollTrigger.batch(faders, {
        start: "top 90%",
        once: true,
        onEnter: (batch) => reveal(batch),
      });

      /* Text starts as soon as its first line is fully on screen. Ending at
         the page's end means a block already scrolled past plays at once. */
      const firstLine = (block: Element) => {
        const style = getComputedStyle(block);
        const height = parseFloat(style.lineHeight);
        return Number.isNaN(height) ? parseFloat(style.fontSize) * 1.2 : height;
      };
      markers.forEach((marker, block) => {
        ScrollTrigger.create({
          trigger: block,
          start: () => `top+=${firstLine(block)} bottom`,
          end: "max",
          once: true,
          onEnter: () => marker.play(),
        });
      });

      return () => markers.forEach((marker) => marker.revert());
    });

    return () => mm.revert();
  });
</script>
