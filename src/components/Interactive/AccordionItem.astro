---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Icon from "@/components/Media/Icon.astro";
import chevron from "@/assets/icons/chevron-down.svg";
import { slotContent } from "@/utils/slots.ts";

type HeadingTag = "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The item's title, on the control that opens it. */
  heading?: string;
  /** Heading level, for the page outline. Every accordion heading is the same size. */
  headingTag?: HeadingTag;
  /** Opens the item on load. */
  open?: boolean;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  open = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && heading && content && (
    <details
      class:list={["accordion_item", className]}
      open={open}
      data-accordion-group
      {...rest}
    >
      <summary class="accordion_toggle">
        <span class="accordion_tile" aria-hidden="true">
          <Icon class="accordion_icon" src={chevron} />
        </span>
        <Heading tag={headingTag} variant="large" class="accordion_title">
          {heading}
        </Heading>
      </summary>

      <div class="accordion_body text-style-main margin-trim" data-lines="off">
        <Fragment set:html={content} />
      </div>
    </details>
  )
}

<style is:global>
  @layer components {
    .accordion_item {
      --_pad: var(--space-7);
      --_tile: 2rem;
      --_gap: var(--space-4);
      --_fill: transparent;
      --_edge: var(--stroke);
      --_title: light-dark(
        var(--text),
        color-mix(in srgb, var(--text) 60%, transparent)
      );
      interpolate-size: allow-keywords;
      position: relative;
      color: var(--text);
      background-color: var(--_fill);
      border: var(--border-width) solid var(--_edge);
      border-top: 0;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (width < 48rem) {
        --_pad: var(--space-4);
        --_gap: var(--space-3);
      }
      &:is([open], .stacki-opened) {
        --_fill: var(--background-2);
        --_title: var(--text);
      }
      &:has(> .accordion_toggle:focus-visible) {
        --_title: var(--text);
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: calc(var(--focus-width) * -1);
      }
      @media (hover: hover) {
        &:hover {
          --_fill: var(--background-2);
          --_title: var(--text);
        }
        &:is([open], .stacki-opened):hover {
          --_fill: light-dark(
            var(--background-2),
            color-mix(in srgb, var(--background-2), var(--text) 1%)
          );
          --_edge: var(--brand-500);
        }
      }
    }

    .accordion_toggle {
      display: flex;
      align-items: center;
      gap: var(--_gap);
      padding: var(--_pad) calc(var(--_pad) - var(--border-width))
        calc(var(--_pad) - var(--border-width));
      list-style: none;
      cursor: pointer;
      transition: padding-bottom var(--open-duration) var(--open-ease);
      &::-webkit-details-marker {
        display: none;
      }
      &:focus-visible {
        outline: none;
      }
    }

    .accordion_tile {
      flex: none;
      display: grid;
      place-items: center;
      width: var(--_tile);
      height: var(--_tile);
      border-radius: 0.125rem;
      color: var(--brand-500);
      background-color: light-dark(
        color-mix(in srgb, var(--brand-500) 20%, transparent),
        var(--brand-tint)
      );
    }

    .accordion_tile .accordion_icon {
      --_size: 1.5rem;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .accordion_title {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      flex: 1;
      min-width: 0;
      margin-block: 0;
      color: var(--_title);
      transition: color var(--hover-duration) var(--hover-ease);
    }

    .accordion_item:is([open], .stacki-opened) > .accordion_toggle,
    .stacki-designer .accordion_wrap.preview .accordion_toggle {
      align-items: start;
      padding-bottom: calc(var(--space-3) - 0.125rem);
    }

    .accordion_item:is([open], .stacki-opened) .accordion_icon,
    .stacki-designer .accordion_wrap.preview .accordion_icon {
      rotate: 180deg;
    }

    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
      transition:
        block-size var(--open-duration) var(--open-ease),
        content-visibility var(--open-duration) var(--open-ease) allow-discrete;
    }

    .accordion_item:is([open], .stacki-opened)::details-content,
    .stacki-designer .accordion_wrap.preview .accordion_item::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .accordion_body {
      padding: 0 calc(var(--_pad) - var(--border-width))
        calc(var(--_pad) - var(--border-width))
        calc(var(--_pad) + var(--_tile) + var(--_gap) - var(--border-width));
      color: color-mix(in srgb, var(--text) 60%, transparent);
      & :is(p, .text) {
        --_trim-top: 0.5lh;
        --_trim-bottom: 0.5lh;
      }
    }
  }
</style>
