---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import Icon from "@/components/Media/Icon.astro";
import close from "@/assets/home/modals/icon-close.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"dialog"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * What opens it: `[data-modal-open="<id>"]`, a link to `#<id>`, or the
   * `?modal=<id>` query. Nothing is output without one.
   */
  id?: string;
  /** Names the dialog for a screen reader. */
  label?: string;
  /**
   * How it arrives.
   *
   * - `small` — a centred card that rises into place (default)
   * - `side-panel` — a full-height column sliding in from the end edge
   * - `full-screen` — fills the viewport, the content fading up
   * - `sheet` — a wide page of its own over the blurred site, scrolled as
   *   one long sheet that rises into place
   */
  variant?: "small" | "side-panel" | "full-screen" | "sheet";
  /** Hold it open while the visual builder is in design mode. */
  preview?: boolean;
};

const {
  render = true,
  id,
  label,
  variant = "small",
  preview = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);

if (import.meta.env.DEV && render && content && !id) {
  console.warn(
    "[lumos] <Modal> rendered without an `id`, so nothing could open it and nothing was output.",
  );
}
---

{
  render && id && content && (
    <dialog
      id={id}
      class:list={[
        "modal_wrap",
        variant !== "small" && variant,
        preview && "preview",
        className,
      ]}
      aria-label={label}
      data-lenis-prevent={variant === "sheet" ? "" : undefined}
      tabindex={variant === "sheet" ? -1 : undefined}
      {...rest}
    >
      <div class="modal_content">
        {variant === "sheet" ? (
          <button
            class="modal_close modal_icon-button"
            type="button"
            aria-label="Close"
            data-modal-close
          >
            <Icon src={close} />
          </button>
        ) : (
          <Button
            class="modal_close"
            variant="close"
            emphasis="secondary"
            data-modal-close
          />
        )}
        <div class="modal_scroll" data-modal-scroll>
          <div class="modal_body margin-trim">
            <Fragment set:html={content} />
          </div>
        </div>
      </div>
    </dialog>
  )
}

<script>
  import { onPage } from "@/utils/lifecycle.ts";

  onPage(() => {
    const modals = document.querySelectorAll<HTMLDialogElement>(".modal_wrap");
    if (modals.length === 0) return;

    const listening = new AbortController();
    const { signal } = listening;

    for (const modal of modals) {
      const scroll = modal.querySelector<HTMLElement>("[data-modal-scroll]");

      const open = () => {
        if (modal.open) return;
        if (scroll) scroll.scrollTop = 0;
        modal.scrollTop = 0;
        const root = document.documentElement;
        root.toggleAttribute(
          "data-modal-gutter",
          window.innerWidth > root.clientWidth,
        );
        modal.showModal();
        if (modal.classList.contains("sheet")) modal.focus();
        modal.dispatchEvent(new CustomEvent("modal-open", { bubbles: true }));
      };

      modal.addEventListener(
        "close",
        () =>
          modal.dispatchEvent(new CustomEvent("modal-close", { bubbles: true })),
        { signal },
      );

      let fromBackdrop = false;

      modal.addEventListener(
        "mousedown",
        (event) => {
          fromBackdrop = event.target === modal;
        },
        { signal },
      );

      modal.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest("[data-modal-close]")) modal.close();
          else if (fromBackdrop && target === modal) modal.close();
          fromBackdrop = false;
        },
        { signal },
      );

      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const trigger = target.closest(
            `[data-modal-open="${modal.id}"], a[href="#${modal.id}"]`,
          );
          if (!trigger) return;
          event.preventDefault();
          open();
        },
        { signal },
      );

      const url = new URL(location.href);
      if (url.searchParams.get("modal") === modal.id) {
        open();
        url.searchParams.delete("modal");
        history.replaceState(history.state, "", url);
      }
    }

    return () => {
      listening.abort();
      for (const modal of modals) if (modal.open) modal.close();
    };
  });
</script>

<style is:global>
  @layer components {
    html:has(.modal_wrap[open]) {
      overflow: hidden;
      &[data-modal-gutter] {
        scrollbar-gutter: stable;
      }
    }

    .modal_wrap {
      --_leaving: calc(var(--open-duration) * 0.7);
      --_from: 0 2rem;
      --_body: 0 0;
      --_backdrop: color-mix(in lab, black 60%, transparent);
      --_close: calc(2.75em + var(--space-4) * 2);
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      margin: 0;
      padding: var(--site-margin);
      align-items: center;
      justify-content: center;
      background: none;
      border: 0;
      color: var(--text);
      overflow: clip;
      transition:
        display var(--_leaving) allow-discrete,
        overlay var(--_leaving) allow-discrete;

      &[open] {
        display: flex;
        transition:
          display var(--open-duration) allow-discrete,
          overlay var(--open-duration) allow-discrete;
      }

      .stacki-designer &.preview,
      &.stacki-opened {
        display: flex;
        position: fixed;
        inset: 0;
        z-index: 100;
        background-color: var(--_backdrop);
      }

      &::backdrop {
        background-color: var(--_backdrop);
        opacity: 0;
        transition: opacity var(--_leaving) var(--open-ease);
      }

      &[open]::backdrop {
        opacity: 1;
        transition: opacity var(--open-duration) var(--open-ease);
      }

      @starting-style {
        &[open]::backdrop {
          opacity: 0;
        }
      }

      &.side-panel {
        --_panel: 28rem;
        --_from: var(--_panel) 0;
        padding: 0;
        align-items: stretch;
        justify-content: end;
      }

      &.full-screen {
        --_from: 0 0;
        --_body: 0 2rem;
        padding: 0;
        align-items: stretch;
      }

      &.sheet {
        --_from: 0 3rem;
        --_backdrop: color-mix(in srgb, var(--dark-900) 10%, transparent);
        padding: 10rem var(--site-margin) 0;
        align-items: start;
        overflow-y: auto;
        overscroll-behavior: contain;
        html[data-modal-gutter] & {
          scrollbar-gutter: stable both-edges;
        }
        @media (width < 64rem) {
          padding-top: var(--space-11);
        }
        &:focus-visible {
          outline: 0;
        }
        &::backdrop {
          backdrop-filter: blur(1.5rem);
        }
      }
    }

    .modal_content {
      position: relative;
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 34rem;
      max-height: 100%;
      background-color: var(--background);
      border-radius: var(--radius-main);
      overflow: hidden;
      opacity: 0;
      translate: var(--_from);
      transition:
        opacity var(--_leaving) var(--open-ease),
        translate var(--_leaving) var(--open-ease);

      .modal_wrap.side-panel & {
        max-width: var(--_panel);
        max-height: none;
        border-radius: 0;
      }

      .modal_wrap.full-screen & {
        max-width: none;
        max-height: none;
        border-radius: 0;
      }

      .modal_wrap.sheet & {
        flex: none;
        max-width: 71.9375rem;
        max-height: none;
        border-radius: 0.125rem 0.125rem 0 0;
      }

      .modal_wrap:is([open], .stacki-opened) &,
      .stacki-designer .modal_wrap.preview & {
        opacity: 1;
        translate: 0 0;
        transition:
          opacity var(--open-duration) var(--open-ease),
          translate var(--open-duration) var(--open-ease);
      }

      @starting-style {
        .modal_wrap[open] & {
          opacity: 0;
          translate: var(--_from);
        }
      }
    }

    .modal_close {
      position: absolute;
      top: var(--space-4);
      inset-inline-end: var(--space-4);
      z-index: 1;
    }

    .modal_icon-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      padding: 0;
      background-color: color-mix(in srgb, var(--light-100) 4%, transparent);
      color: var(--dark-750);
      border: 0;
      border-radius: 0.125rem;
      font-size: 1rem;
      cursor: pointer;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--light-250);
        }
      }
      &:active {
        background-color: var(--dark-750);
        color: var(--light-100);
      }
      &:focus-visible {
        outline: var(--focus-width) solid var(--dark-950);
        outline-offset: 0;
      }
    }

    .modal_scroll {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;

      .modal_wrap.full-screen & {
        height: 100%;
      }

      .modal_wrap.sheet & {
        overflow: visible;
      }
    }

    .modal_body {
      padding: var(--_close) var(--space-6) var(--space-7);
      translate: var(--_body);
      transition: translate var(--_leaving) var(--open-ease);

      .modal_wrap.full-screen & {
        min-height: 100%;
        display: grid;
        align-content: center;
      }

      .modal_wrap.sheet & {
        padding: 0;
      }

      .modal_wrap:is([open], .stacki-opened) &,
      .stacki-designer .modal_wrap.preview & {
        translate: 0 0;
        transition: translate var(--open-duration) var(--open-ease);
      }

      @starting-style {
        .modal_wrap[open] & {
          translate: var(--_body);
        }
      }
    }
  }
</style>
