---
import type { HTMLAttributes } from "astro/types";
import { slug } from "@/utils/text.ts";
import { uid } from "@/utils/uid.ts";

type InputVariant =
  | "text"
  | "first-name"
  | "last-name"
  | "email"
  | "phone"
  | "date"
  | "zip-code"
  | "number"
  | "search"
  | "password"
  | "url";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The text above the field. Defaults to the wording of the variant. */
  label?: string;
  /** What the field starts out holding. */
  value?: string;
  /**
   * What the field is for. It settles the input's type, keyboard, autofill
   * and wording together, so a field only has to say which one it is.
   *
   * - `text` — anything else, with no assumptions (default)
   * - `first-name`, `last-name`, `zip-code` — autofilled from an address
   * - `email`, `phone`, `url`, `number`, `date` — a keyboard and validation
   *   to match
   * - `search`, `password` — the browser's own handling of each
   */
  variant?: InputVariant;
  /** The name it submits under. Taken from the label where it is not set. */
  name?: string;
  /** The text shown in an empty field. Defaults to the wording of the variant. */
  placeholder?: string;
  /** Marks the field as needed, and stars its label. */
  required?: boolean;
  /** Keeps the label for a screen reader, and takes it off the page. */
  labelHidden?: boolean;
  /** Shown under the field when what it holds will not do. Defaults to `Please check this field`. */
  error?: string;
}

const {
  render = true,
  label,
  value,
  variant = "text",
  name,
  placeholder,
  required = false,
  labelHidden = false,
  error = "Please check this field",
  class: className,
  ...rest
} = Astro.props;

type InputAttrs = HTMLAttributes<"input">;

const KINDS: Record<
  InputVariant,
  {
    label: string;
    type: NonNullable<InputAttrs["type"]>;
    mode: NonNullable<InputAttrs["inputmode"]>;
    fill: NonNullable<InputAttrs["autocomplete"]>;
  }
> = {
  text: { label: "Text", type: "text", mode: "text", fill: "on" },
  "first-name": {
    label: "First Name",
    type: "text",
    mode: "text",
    fill: "given-name",
  },
  "last-name": {
    label: "Last Name",
    type: "text",
    mode: "text",
    fill: "family-name",
  },
  email: { label: "Email", type: "email", mode: "email", fill: "email" },
  phone: { label: "Phone", type: "tel", mode: "tel", fill: "tel" },
  date: { label: "Date", type: "date", mode: "text", fill: "bday" },
  "zip-code": {
    label: "Zip Code",
    type: "text",
    mode: "numeric",
    fill: "postal-code",
  },
  number: { label: "Number", type: "number", mode: "numeric", fill: "off" },
  search: { label: "Search", type: "search", mode: "search", fill: "off" },
  password: {
    label: "Password",
    type: "password",
    mode: "text",
    fill: "current-password",
  },
  url: { label: "URL", type: "url", mode: "url", fill: "url" },
};

const kind = KINDS[variant];
const text = label ?? kind.label;
const errorId = uid("field-error");
---

{
  render && (
    <label class:list={["field", "form-input", className]}>
      <span
        class:list={["field-label", labelHidden && "sr-only"]}
      >
        <span>{text}</span>
        {required && (
          <span class="field-star" aria-hidden="true">
            *
          </span>
        )}
      </span>
      <input
        class="field-control form-input_field text-style-small"
        type={kind.type}
        name={name ?? slug(text)}
        placeholder={placeholder ?? text}
        inputmode={kind.mode}
        autocomplete={kind.fill}
        required={required || undefined}
        value={value}
        aria-describedby={errorId}
        {...rest}
      />
      <span class="field-error" id={errorId}>
        {error}
      </span>
    </label>
  )
}

<style is:global>
  @layer components {
    .form-input {
      --_error: #ff6b5e;
      gap: var(--space-1);

      & .field-label {
        color: var(--text-2);
        font-size: 0.75rem;
        line-height: var(--line-height-huge);
      }

      & .field-error {
        display: none;
        color: var(--_error);
        font-size: 0.75rem;
        line-height: var(--line-height-huge);
      }

      &:has(.form-input_field:disabled) .field-label {
        color: color-mix(in srgb, var(--text) 30%, transparent);
      }

      &:has(.form-input_field:user-invalid),
      .form_wrap[data-checked] &:has(.form-input_field:invalid) {
        & .field-error {
          display: block;
        }
        & .form-input_field {
          border-color: var(--_error);
        }
      }
    }

    .form-input_field {
      min-height: 2.5rem;
      padding: 0 0.75rem;
      background-color: transparent;
      border-color: var(--stroke);
      border-radius: 0.125rem;
      &::placeholder {
        color: color-mix(in srgb, var(--text) 20%, transparent);
      }
      @media (hover: hover) {
        &:hover:not(:disabled, :focus) {
          background-color: transparent;
          border-color: var(--text);
        }
      }
      &:focus,
      &:focus-visible {
        border-color: var(--brand-500);
        outline: 0;
      }
      &:disabled {
        opacity: 1;
        background-color: color-mix(in srgb, var(--text) 4%, transparent);
        color: color-mix(in srgb, var(--text) 20%, transparent);
      }
    }
  }
</style>
