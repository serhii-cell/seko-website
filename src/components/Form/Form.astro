---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"form"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** What the form is called, which is what it submits under. */
  name?: string;
  /** Where it posts. Left unset, it sends nothing and reports success. */
  action?: string;
  /** Shown in place of the fields once it has sent. */
  successMessage?: string;
  /** Shown beneath the fields when it could not send. */
  errorMessage?: string;
}

const {
  render = true,
  name,
  action,
  successMessage = "Thanks — we will be in touch.",
  errorMessage = "That did not send. Please try again.",
  method = "post",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && name && content && (
    <div
      class:list={["form_wrap", className]}
      data-state="idle"
      data-endpoint={action}
    >
      <form
        class="form_fields"
        name={name}
        action={action}
        method={method}
        novalidate
        {...rest}
      >
        <Fragment set:html={content} />
      </form>

      <p class="form_note form_note-sent text-style-main" role="status">
        {successMessage}
      </p>
      <p class="form_note form_note-failed text-style-main" role="alert">
        {errorMessage}
      </p>
    </div>
  )
}

<script>
  import { onPage } from "@/utils/lifecycle.ts";

  onPage(() => {
    const forms = document.querySelectorAll<HTMLElement>(".form_wrap");
    if (forms.length === 0) return;

    const listening = new AbortController();

    for (const form of forms) {
      const fields = form.querySelector<HTMLFormElement>(".form_fields");
      if (!fields) continue;

      const submit = fields.querySelector<
        HTMLButtonElement | HTMLInputElement
      >('button:not([type]), button[type="submit"], input[type="submit"]');

      fields.addEventListener(
        "submit",
        async (event) => {
          const endpoint = form.dataset.endpoint;
          event.preventDefault();
          if (form.dataset.state === "sending") return;

          if (!fields.checkValidity()) {
            form.dataset.checked = "";
            fields
              .querySelector<HTMLElement>(
                "input:invalid, select:invalid, textarea:invalid",
              )
              ?.focus();
            return;
          }

          form.dataset.state = "sending";
          submit?.setAttribute("aria-busy", "true");

          try {
            if (endpoint) {
              const answer = await fetch(endpoint, {
                method: fields.method || "post",
                body: new FormData(fields),
                headers: { Accept: "application/json" },
              });
              if (!answer.ok) throw new Error(String(answer.status));
            }
            form.dataset.state = "sent";
            delete form.dataset.checked;
            fields.reset();
          } catch {
            form.dataset.state = "failed";
          } finally {
            submit?.removeAttribute("aria-busy");
          }
        },
        { signal: listening.signal },
      );
    }

    return () => listening.abort();
  });
</script>

<style is:global>
  @layer components {
    .form_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
    }

    .form_fields {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .form_note {
      display: none;
      padding: var(--space-4) var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
    }

    .form_wrap[data-state="sent"] {
      & .form_fields {
        display: none;
      }
      & .form_note-sent {
        display: block;
      }
    }

    .form_wrap[data-state="failed"] .form_note-failed {
      display: block;
      color: var(--text);
    }
  }
</style>
