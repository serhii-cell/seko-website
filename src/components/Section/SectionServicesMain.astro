---
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Odometer from "@/components/Typography/Odometer.astro";

type Stat = {
  /** The figure, as written. */
  value: string;
  /** What the figure is out of, set dimmer after a slash. */
  total?: string;
  /** The caption under the figure. */
  label: string;
};

type Service = {
  /** The id of the modal the card opens. */
  modal: string;
  title: string;
  description: string;
  /** The outcome tags. */
  outcomes: string[];
  /** The 120 × 120 illustration tile. */
  illustration: ImageMetadata;
};

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The small label above the heading. */
  label?: string;
  /** The heading. Nothing is output without it. */
  heading?: string;
  /** The figures in a row under the heading. */
  stats?: Stat[];
  /**
   * The service cards, front of the deck first. Clicking a card behind the
   * front one brings it forward; the front one opens its modal.
   */
  services?: Service[];
}

const { render = true, label, heading, stats = [], services = [] } = Astro.props;
---

{
  render && heading && (
    <Section
      id="services"
      theme="dark"
      frame
      class="services-main_wrap dashed dashed-bottom"
      containerClass="services-main_container hatched"
    >
      <div class="services-main_intro">
        <div class="services-main_title">
          <Paragraph
            variant="label"
            class="services-main_label"
            render={!!label}
          >
            {label}
          </Paragraph>
          <Heading tag="h2" class="services-main_heading">
            {heading}
          </Heading>
        </div>
        {stats.length > 0 && (
          <ul class="services-main_stats" role="list" data-odometer-group>
            {stats.map((stat) => (
              <li class="services-main_stat">
                <Paragraph variant="h3" class="services-main_value">
                  <Odometer value={stat.value} />{" "}
                  {stat.total && (
                    <span class="services-main_total">/ {stat.total}</span>
                  )}
                </Paragraph>
                <Paragraph variant="label" class="services-main_label">
                  {stat.label}
                </Paragraph>
              </li>
            ))}
          </ul>
        )}
      </div>
      {services.length > 0 && (
        <div
          class="services-main_deck"
          role="group"
          aria-label="Services"
          data-lines="off"
        >
          {services.map((service, index) => (
            <article
              class="services-main_card theme-light"
              data-pos={index}
              data-modal={service.modal}
              data-modal-open={index === 0 ? service.modal : undefined}
              aria-labelledby={`${service.modal}-title`}
            >
              <div class="services-main_bg" aria-hidden="true" />
              <div class="services-main_body" inert={index !== 0}>
                <div class="services-main_header">
                  <div class="services-main_name">
                    <img
                      class="services-main_tile"
                      src={service.illustration.src}
                      width="120"
                      height="120"
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <Heading
                      tag="h3"
                      class="services-main_card-title"
                      id={`${service.modal}-title`}
                    >
                      {service.title}
                    </Heading>
                  </div>
                  <button
                    type="button"
                    class="services-main_expand"
                    data-modal-open={service.modal}
                    aria-haspopup="dialog"
                    aria-label={`More about ${service.title}`}
                  >
                    <svg
                      class="services-main_icon"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        class="services-main_arrow-start"
                        d="M5 19V13H7V17H11V19H5Z"
                      />
                      <path
                        class="services-main_arrow-end"
                        d="M17 11V7H13V5H19V11H17Z"
                      />
                    </svg>
                  </button>
                </div>
                <div class="services-main_divider dashed dashed-top" />
                <div class="services-main_details">
                  <div class="services-main_column">
                    <Paragraph variant="label" class="color-faded">
                      What we do
                    </Paragraph>
                    <Paragraph variant="main" class="color-faded">
                      {service.description}
                    </Paragraph>
                  </div>
                  <div class="services-main_column">
                    <Paragraph variant="label" class="color-faded">
                      Outcomes
                    </Paragraph>
                    <ul class="services-main_outcomes" role="list">
                      {service.outcomes.map((outcome) => (
                        <li class="services-main_outcome text-style-label">{outcome}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
              <div class="services-main_cover" aria-hidden="true" />
              <button
                type="button"
                class="services-main_peek"
                aria-label={`Show ${service.title}`}
                tabindex={index === 0 ? -1 : undefined}
              />
            </article>
          ))}
        </div>
      )}
    </Section>
  )
}

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";
  import { dissolveCards } from "@/utils/dissolve.ts";
  import { createLines, type Lines } from "@/utils/lines.ts";

  const CARD = ".services-main_card";
  /* Seconds the deck takes to catch up with the scroll: small, so it
     follows the page as closely as the rest of it does. */
  const SCRUB = 0.3;
  /* How far each step back leans toward the cursor (at half a screen from
     the front card's centre, or more), in px, and how quickly it follows. */
  const LEAN = { x: 8, y: 5, time: 0.6 };

  /* The least space kept above the title and below the deck while held. */
  const MIN_GAP = 24;
  /* While held, the deck shrinks to leave at least `room` px above the title
     and below the deck, but to no less than `smallest` of its size. */
  const FIT = { room: 32, smallest: 0.6, space: "var(--space-6)" };

  const navHeight = () => {
    const root = getComputedStyle(document.documentElement);
    return (parseFloat(root.getPropertyValue("--nav-height")) || 0) * parseFloat(root.fontSize);
  };

  /* As the works section does: while pinned, the title, the figures and the
     deck are centred together in the space under the nav, and the section's
     bottom edge (its dashed line) sits on the screen's bottom, as far below
     the deck as the title is below the nav. Returns that space and where the
     title holds, in px from the top of the screen. */
  function holdAt(title: HTMLElement, deck: HTMLElement) {
    const room = innerHeight - navHeight();
    const height = deck.getBoundingClientRect().bottom - title.getBoundingClientRect().top;
    const gap = Math.max(MIN_GAP, (room - height) / 2);
    return { gap, top: innerHeight - gap - height };
  }

  onPage(() => {
    const decks = document.querySelectorAll<HTMLElement>(".services-main_deck");
    if (decks.length === 0) return;

    const abort = new AbortController();
    const { signal } = abort;
    const ctx = gsap.context(() => {});
    const mm = gsap.matchMedia();
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    decks.forEach((deck) => {
      const cards = gsap.utils.toArray<HTMLElement>(CARD, deck);
      if (cards.length < 2) return;
      const posOf = (card: HTMLElement) => Number(card.dataset.pos);
      let moving = false;
      /* Straightens the cards behind (set below), when the deck reorders. */
      let leanBack = () => {};
      /* Set while the page's scroll drives the deck. */
      let scrolled: { trigger: ScrollTrigger; order: HTMLElement[]; length: number } | null = null;
      /* A card asked for from the keyboard, to focus once it is in front. */
      let pending: HTMLElement | null = null;

      /* Only the front card can be used: the rest are inert, and its
         whole surface opens its modal. */
      const sync = (focus: boolean) => {
        cards.forEach((card) => {
          const front = posOf(card) === 0;
          const body = card.querySelector<HTMLElement>(".services-main_body");
          const peek = card.querySelector<HTMLElement>(".services-main_peek");
          if (body) body.inert = !front;
          /* Cards that have dropped out (negative positions) take no clicks. */
          if (peek) peek.tabIndex = posOf(card) > 0 ? 0 : -1;
          if (front && card.dataset.modal)
            card.setAttribute("data-modal-open", card.dataset.modal);
          else card.removeAttribute("data-modal-open");
          if (front && focus)
            card.querySelector<HTMLElement>(".services-main_expand")?.focus();
        });
      };

      /* Where a card sits at each depth: raised one step and inset 1rem a
         side per step back, the front one free to grow past its edges. */
      const place = (pos: number) => {
        const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
        const step = Number(getComputedStyle(deck).getPropertyValue("--_step")) || 1;
        const side = pos === 0 ? -0.5 * rem : pos * rem;
        const top = pos === 0 || pos === 2 ? -0.5 * rem : 0;
        const bottom = pos === 0 ? -0.5 * rem : 0;
        return {
          y: -pos * step * rem,
          clipPath: `inset(${top}px ${side}px ${bottom}px ${side}px round ${0.125 * rem}px)`,
        };
      };
      const slab = (pos: number) =>
        getComputedStyle(deck).getPropertyValue(`--_slab-${Math.min(pos, 2)}`);

      const bringForward = (target: HTMLElement, focus: boolean) => {
        const depth = posOf(target);
        if (moving || depth === 0) return;
        const total = cards.length;
        const next = new Map(
          cards.map((card) => [card, (posOf(card) - depth + total) % total]),
        );

        const settle = () => {
          cards.forEach((card) => {
            card.dataset.pos = String(next.get(card));
            gsap.set(card, { clearProps: "all" });
            gsap.set(card.querySelector(".services-main_cover"), {
              clearProps: "all",
            });
          });
          deck.classList.remove("is-moving");
          moving = false;
          sync(focus);
        };

        if (reduced.matches) {
          /* The click that asked for it is still on its way to the modal's
             listener, so the new front card only opens on the next one. */
          requestAnimationFrame(settle);
          return;
        }

        moving = true;
        leanBack();
        deck.classList.add("is-moving");
        ctx.add(() => {
          const timeline = gsap.timeline({ onComplete: settle });
          cards.forEach((card) => {
            const from = posOf(card);
            const to = next.get(card) ?? 0;
            const cover = card.querySelector(".services-main_cover");
            const end = place(to);
            if (from === 0) {
              /* The front card drops out, then slides in at the back. */
              timeline
                .set(card, { zIndex: total + 1 }, 0)
                .to(
                  card,
                  { y: "+=24", autoAlpha: 0, duration: 0.3, ease: "power2.in" },
                  0,
                )
                .set(card, { zIndex: total - to, ...end, y: end.y + 16 }, 0.3)
                .set(cover, { opacity: 1, backgroundColor: slab(to) }, 0.3)
                .to(card, { y: end.y, autoAlpha: 1, duration: 0.5 }, 0.3);
            } else {
              timeline
                .set(card, { zIndex: total - to }, 0)
                .fromTo(
                  card,
                  { clipPath: place(from).clipPath },
                  { ...end, duration: 0.7 },
                  0.1,
                )
                .to(
                  cover,
                  to === 0
                    ? { opacity: 0, duration: 0.5 }
                    : { backgroundColor: slab(to), duration: 0.5 },
                  0.1,
                );
            }
          });
        });
      };

      deck.addEventListener(
        "click",
        (event) => {
          const peek = (event.target as Element).closest(".services-main_peek");
          const card = peek?.closest<HTMLElement>(CARD);
          if (!card) return;
          if (scrolled) {
            /* Scroll the page to where that card is at the front. */
            const { trigger, order, length } = scrolled;
            const at = order.indexOf(card) / length;
            if ((event as MouseEvent).detail === 0) pending = card;
            window.scrollTo({
              top: trigger.start + at * (trigger.end - trigger.start),
              behavior: "smooth",
            });
            return;
          }
          /* A keyboard press reports no clicks; hand focus on to the card it
             brought forward. */
          bringForward(card, (event as MouseEvent).detail === 0);
        },
        { signal },
      );

      /* The cards behind the front one lean toward the cursor, the further
         back the more, so their strips slide sideways and rise or sink. */
      const lean = (nx: number, ny: number, instant = false) => {
        cards.forEach((card) => {
          const depth = Math.max(0, posOf(card));
          gsap.to(card, {
            "--_lean-x": nx * LEAN.x * depth,
            "--_lean-y": ny * LEAN.y * depth,
            duration: instant ? 0 : LEAN.time,
            ease: "power3.out",
            overwrite: "auto",
          });
        });
      };
      leanBack = () => lean(0, 0, true);

      /* Wherever the cursor is on the page: measured from the front card's
         centre, half a screen away is the full lean. Only while the deck is
         on screen. */
      window.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerType !== "mouse" || moving || reduced.matches) return;
          const front = cards.find((card) => posOf(card) === 0);
          const box = front?.getBoundingClientRect();
          if (!box || box.bottom < 0 || box.top > innerHeight) return;
          const nx = (event.clientX - (box.left + box.width / 2)) / (innerWidth / 2);
          const ny = (event.clientY - (box.top + box.height / 2)) / (innerHeight / 2);
          lean(gsap.utils.clamp(-1, 1, nx), gsap.utils.clamp(-1, 1, ny));
        },
        { signal },
      );
      document.documentElement.addEventListener("pointerleave", () => lean(0, 0), { signal });

      /* The glow on the front card's border follows the cursor. */
      deck.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerType !== "mouse" || moving) return;
          const card = (event.target as Element).closest<HTMLElement>(CARD);
          const bg = card?.querySelector(".services-main_bg");
          if (!card || !bg || posOf(card) !== 0) return;
          const box = bg.getBoundingClientRect();
          /* In the card's own px: the deck may be scaled down to fit. */
          const scale = box.width / (bg as HTMLElement).offsetWidth || 1;
          card.style.setProperty("--_glow-x", `${(event.clientX - box.left) / scale}px`);
          card.style.setProperty("--_glow-y", `${(event.clientY - box.top) / scale}px`);
        },
        { signal },
      );

      /* From 48rem up, with motion, the section holds with its title, figures
         and deck centred under the nav, and scrolling drops the front card down
         out of the deck, uncovering the next one as the cards behind step
         forward; once the last card is at the front the page carries on.
         Scrolling back brings them up again. */
      const section = deck.closest<HTMLElement>(".services-main_wrap");
      if (!section || document.documentElement.classList.contains("stacki-designer")) return;
      mm.add("(width >= 48rem) and (prefers-reduced-motion: no-preference)", () => {
        const total = cards.length;
        const order = [...cards].sort((a, b) => posOf(a) - posOf(b));
        const covers = order.map((card) => card.querySelector(".services-main_cover"));
        let front = 0;
        /* A card's content comes in when it reaches the front: its name,
           labels and text with the page's line reveal, its outcome tags
           rising and fading in one after another. Each card keeps its own
           reveal, so one coming forward again plays it afresh. */
        const reveals = new Map<HTMLElement, { lines: Lines[]; tags: HTMLElement[] }>();
        const textsOf = (card: HTMLElement) => [
          ...card.querySelectorAll<HTMLElement>(
            ".services-main_body :is(.heading, p.text)",
          ),
        ];
        const tagsOf = (card: HTMLElement) => [
          ...card.querySelectorAll<HTMLElement>(".services-main_outcome"),
        ];
        const conceal = (card: HTMLElement | undefined) => {
          if (!card) return;
          reveals.get(card)?.lines.forEach((lines) => lines.revert());
          const tags = tagsOf(card);
          gsap.killTweensOf(tags);
          gsap.set(tags, { y: "0.75rem", autoAlpha: 0 });
          reveals.set(card, { lines: textsOf(card).map(createLines), tags });
        };
        /* Plays a hidden card's content in; one already showing is left as
           it is, so nothing flickers. */
        const reveal = (card: HTMLElement | undefined, delay = 0) => {
          if (!card) return;
          const found = reveals.get(card);
          if (!found) return;
          found.lines.forEach((lines, i) => lines.play(delay + i * 0.08));
          gsap.to(found.tags, {
            y: 0,
            autoAlpha: 1,
            duration: 0.8,
            ease: "power3.out",
            stagger: 0.08,
            delay: delay + 0.3,
            clearProps: "transform,opacity,visibility",
          });
          reveals.delete(card);
        };
        /* Going back, a card simply shows what it holds. */
        const uncover = (card: HTMLElement | undefined) => {
          if (!card) return;
          const found = reveals.get(card);
          if (!found) return;
          found.lines.forEach((lines) => lines.revert());
          gsap.killTweensOf(found.tags);
          gsap.set(found.tags, { clearProps: "transform,opacity,visibility" });
          reveals.delete(card);
        };
        const show = (index: number) => {
          if (index === front) return;
          if (index > front) {
            /* Forward: the card's content has waited hidden behind the one
               in front, and comes in as that one goes. */
            reveal(order[index], 0.05);
          } else {
            /* Back: the card returning shows what it holds; the one going
               behind hides its content again, ready to come in afresh. */
            uncover(order[index]);
            conceal(order[front]);
          }
          front = index;
          leanBack();
          const active = document.activeElement;
          order.forEach((card, i) => (card.dataset.pos = String(i - index)));
          sync(false);
          /* Focus follows to the new front card when a keyboard asked for
             it, or when the control that had focus has just gone. */
          const lost =
            active instanceof HTMLElement &&
            deck.contains(active) &&
            (!!active.closest("[inert]") || active.offsetParent === null);
          if (pending === order[index] || lost) {
            pending = null;
            order[index]
              .querySelector<HTMLElement>(".services-main_expand")
              ?.focus({ preventScroll: true });
          }
        };

        order.forEach((card, i) => {
          gsap.set(card, { zIndex: total - i, ...place(i) });
          gsap.set(covers[i], i === 0 ? { opacity: 0 } : { opacity: 1, backgroundColor: slab(i) });
          card.style.willChange = "transform";
          const cover = covers[i];
          if (cover instanceof HTMLElement) cover.style.willChange = "opacity";
        });

        /* One unit of time per card, scrubbed by the scroll: each card
           drops and dissolves as the page moves, and stops where it stops. */
        const timeline = gsap.timeline({
          paused: true,
          defaults: { ease: "power2.inOut", duration: 1 },
          /* A card counts as gone once it is halfway down. */
          onUpdate: () => show(Math.min(total - 1, Math.floor(timeline.time() + 0.5))),
        });
        for (let step = 0; step < total - 1; step++) {
          timeline
            .to(order[step], { yPercent: 110, ease: "power1.in" }, step)
            /* The dissolve (below) takes the card away well before this;
               the fade only makes sure it is gone where it can't run. */
            .to(order[step], { autoAlpha: 0, duration: 0.1, ease: "none" }, step + 0.9);
          for (let next = step + 1; next < total; next++) {
            const depth = next - step - 1;
            /* The clip's start is given in full: read back from the page it
               comes shortened, and its numbers would pair up wrongly. */
            timeline
              .fromTo(
                order[next],
                { clipPath: place(depth + 1).clipPath },
                { ...place(depth), immediateRender: false },
                step,
              )
              .to(
                covers[next],
                depth === 0 ? { opacity: 0 } : { backgroundColor: slab(depth) },
                step,
              );
          }
        }
        /* Every card's content starts hidden; each comes in when its card
           reaches the front, so none shows through the one in front. */
        order.forEach(conceal);

        /* The last card holds a moment before the page moves on. */
        timeline.to({}, { duration: 0.3 });
        const steps = total - 1;

        /* On a screen too short for all of it, the deck shrinks (`--_fit`,
           with `--_fit-cut` taking back the space it no longer fills), so the
           title and the deck always fit together. */
        const title =
          section.querySelector<HTMLElement>(".services-main_title") ?? deck;
        const fit = () => {
          deck.style.removeProperty("--_fit");
          deck.style.removeProperty("--_fit-cut");
          section.style.removeProperty("--_hold-space");
          const above = () => deck.getBoundingClientRect().top - title.getBoundingClientRect().top;
          const height = deck.offsetHeight;
          const room = () => innerHeight - navHeight() - above() - FIT.room * 2;
          /* First the space between the title, the figures and the deck
             closes up, then the deck shrinks. */
          if (room() < height) section.style.setProperty("--_hold-space", FIT.space);
          const scale = Math.min(1, Math.max(FIT.smallest, room() / height));
          if (scale < 1) {
            deck.style.setProperty("--_fit", String(scale));
            deck.style.setProperty("--_fit-cut", `${height * (1 - scale)}px`);
          }
          section.style.setProperty("--_hold-gap", `${holdAt(title, deck).gap}px`);
        };
        fit();
        ScrollTrigger.addEventListener("refreshInit", fit);

        const trigger = ScrollTrigger.create({
          trigger: title,
          start: () => `top ${holdAt(title, deck).top}`,
          /* A screen of scroll per card. */
          end: () => `+=${innerHeight * (steps + 0.3)}`,
          pin: section,
          /* Off by default inside a flex parent like <main>. */
          pinSpacing: true,
          invalidateOnRefresh: true,
          animation: timeline,
          scrub: SCRUB,
          /* Arriving from below (a reload further down, say), the front
             card's content comes in as the deck is held again. */
          onEnterBack: () => reveal(order[front], 0.1),
        });
        /* The first card's content starts coming in as soon as the card's
           top is in view, before the deck is held. */
        const arrival = ScrollTrigger.create({
          trigger: deck,
          start: "top 70%",
          onEnter: () => reveal(order[front]),
        });

        scrolled = { trigger, order, length: steps + 0.3 };
        /* Each card but the last dissolves into ASCII as it drops. */
        const undissolve = dissolveCards(order.slice(0, -1));
        return () => {
          ScrollTrigger.removeEventListener("refreshInit", fit);
          deck.style.removeProperty("--_fit");
          deck.style.removeProperty("--_fit-cut");
          section.style.removeProperty("--_hold-gap");
          section.style.removeProperty("--_hold-space");
          trigger.kill();
          arrival.kill();
          order.forEach(uncover);
          timeline.kill();
          undissolve();
          scrolled = null;
          pending = null;
          order.forEach((card, i) => {
            card.dataset.pos = String(i);
            card.style.willChange = "";
            const cover = covers[i];
            if (cover instanceof HTMLElement) cover.style.willChange = "";
          });
          sync(false);
        };
      });
    });

    return () => {
      abort.abort();
      mm.revert();
      ctx.revert();
    };
  });
</script>

<style is:global>
  @layer components {
    .services-main_container {
      align-items: center;
      /* Closer together on short screens while held (set from the script). */
      gap: var(--_hold-space, var(--section-space-small));
      padding-block: var(--section-space-xlarge);
      /* While held, the bottom edge sits on the screen's bottom (set from
         the script). */
      padding-bottom: var(--_hold-gap, var(--section-space-xlarge));
      & :is(.heading, .text) {
        margin: 0;
      }
      /* Labels keep their full line box, as drawn. */
      & .text-style-label {
        --_trim-top: 0.5lh;
        --_trim-bottom: 0.5lh;
      }
    }

    /* ---------- Heading and figures ---------- */

    .services-main_intro {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--_hold-space, var(--section-space-small));
      width: 100%;
      text-align: center;
    }

    .services-main_title {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
    }

    .services-main_label {
      color: color-mix(in srgb, currentColor 40%, transparent);
    }

    .services-main_heading {
      max-width: 32.5rem;
    }

    .services-main_stats {
