---
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Chart from "@/assets/charts/product-complexity.svg";
import Point from "@/assets/charts/point.svg";
import { smoothCurve, type Point as CurvePoint } from "@/utils/curve.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The small label beside the statement. */
  label?: string;
  /**
   * The statement. Nothing is output without it. Words wrapped in
   * `<strong>` are set in the accent colour.
   */
  heading?: string;
  /** The paragraph under the statement. */
  text?: string;
  /** The label beside the chart. The chart is left out without it. */
  chartLabel?: string;
}

const { render = true, label, heading, text, chartLabel } = Astro.props;

/* Positions on the 861 × 200 chart, as drawn: the time axis along the top
   40px, and below it an 861 × 160 plot with a divider at each 215px period,
   an issue tag over a point on the curve in the middle of each, and the
   curve itself: a smooth line through the four issues that steepens past
   the last one and runs on beyond the right edge. */
const WIDTH = 861;
const ticks = [
  { text: "Product launch", x: 0, anchor: "start" },
  { text: "6 months", x: 215, anchor: "middle" },
  { text: "12 months", x: 430, anchor: "middle" },
  { text: "18 months", x: 645, anchor: "middle" },
  { text: "24 months", x: WIDTH, anchor: "end" },
];
const dividers = [0, 215, 430, 645, 860];
const curvePoints: CurvePoint[] = [
  [1, 129],
  [108, 125],
  [323, 112],
  [538, 94],
  [753, 84],
  [950, 53],
];
const curve = smoothCurve(curvePoints);
const issues = [
  { text: "Incoherent design system", x: 108 },
  { text: "UI errors", x: 323 },
  { text: "Different UX patterns", x: 538 },
  { text: "Growing design debt", x: 753 },
].map((issue) => ({ ...issue, y: curve.y(issue.x) }));
const at = (x: number, y: number) =>
  `left: ${(x / WIDTH) * 100}%; top: ${(y / 160) * 100}%`;
---

{
  render && heading && (
    <Section
      theme="light"
      frame
      class="observations-main_wrap"
      containerClass="observations-main_frame"
    >
      <div class="observations-main_content">
        <div class="observations-main_row">
          <Paragraph
            variant="label"
            class="observations-main_label color-faded"
            render={!!label}
          >
            {label}
          </Paragraph>
          <div class="observations-main_statement">
            <Heading tag="h2" class="observations-main_heading heading-accent">
              <Fragment set:html={heading} />
            </Heading>
            <Paragraph
              variant="main"
              class="observations-main_text"
              render={!!text}
            >
              {text}
            </Paragraph>
          </div>
        </div>
        {chartLabel && (
          <div class="observations-main_row">
            <Paragraph
              variant="label"
              class="observations-main_label color-faded"
            >
              {chartLabel}
            </Paragraph>
            <div class="observations-main_scroll">
              <div class="observations-main_chart">
                <div class="observations-main_ticks">
                  {ticks.map((tick) => (
                    <span
                      class:list={[
                        "observations-main_tick text-style-label",
                        tick.anchor,
                      ]}
                      style={`left: ${(tick.x / WIDTH) * 100}%`}
                    >
                      {tick.text}
                    </span>
                  ))}
                </div>
                <div
                  class="observations-main_plot"
                  data-curve={JSON.stringify(curvePoints)}
                >
                  <Chart class="observations-main_graph" />
                  <svg
                    class="observations-main_curve"
                    viewBox={`0 0 ${WIDTH} 160`}
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    <path d={curve.path} />
                  </svg>
                  <svg
                    class="observations-main_dividers"
                    viewBox={`0 0 ${WIDTH} 160`}
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    {dividers.map((x) => (
                      <line
                        x1={x + 0.5}
                        x2={x + 0.5}
                        y1="0"
                        y2="160"
                        vector-effect="non-scaling-stroke"
                        shape-rendering="crispEdges"
                      />
                    ))}
                  </svg>
                  {issues.map((issue) => (
                    <>
                      <Point
                        class="observations-main_point"
                        style={at(issue.x, issue.y)}
                        data-x={issue.x}
                      />
                      <span
                        class="observations-main_issue"
                        style={at(issue.x, issue.y)}
                      >
                        <span class="observations-main_tag">{issue.text}</span>
                      </span>
                    </>
                  ))}
                  <span class="observations-main_track" aria-hidden="true">
                    <span class="observations-main_runner" />
                  </span>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </Section>
  )
}

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";
  import { smoothCurve, type Point } from "@/utils/curve.ts";

  /* The visible plot is 861 × 160. The runner goes on past the right edge,
     where its track clips it. */
  const WIDTH = 861;
  const END = WIDTH + 40;
  /* The dot moves in stages, one issue at a time: each leg eases in and
     out, taking longer the further it goes, and it rests at each issue
     while that issue's point and tag pop up. */
  const SPEED = 520;
  const MIN_LEG = 0.45;
  const REST = 0.45;
  const LEG_EASE = "power2.inOut";
  /* The whole sequence plays at this speed, keeping the proportions of the
     timings above: 1.5 runs it half as fast again. */
  const PACE = 1.5;

  /* A glowing dot runs along the curve from left to right, drawing it as it
     goes. It stops at each issue: the point pops in and its tag springs up
     out of it, then the dot moves on. It leaves through the right edge, and
     what remains is the chart as drawn. */
  function buildTimeline(chart: HTMLElement) {
    const plot = chart.querySelector<HTMLElement>(".observations-main_plot");
    const runner = chart.querySelector<HTMLElement>(
      ".observations-main_runner",
    );
    const points = gsap.utils.toArray<SVGElement>(
      ".observations-main_point",
      chart,
    );
    const issues = gsap.utils.toArray<HTMLElement>(
      ".observations-main_issue",
      chart,
    );
    if (!plot || !runner) return null;
    const curve = smoothCurve(
      JSON.parse(plot.dataset.curve ?? "[]") as Point[],
    );

    const travel = { x: 0 };
    const place = () => {
      runner.style.left = `${(travel.x / WIDTH) * 100}%`;
      runner.style.top = `${(curve.y(travel.x) / 160) * 100}%`;
      plot.style.setProperty("--_drawn", String(Math.min(1, travel.x / WIDTH)));
    };

    const timeline = gsap.timeline({ paused: true });
    timeline.fromTo(
      runner,
      { autoAlpha: 0 },
      { autoAlpha: 1, duration: 0.15 },
      0,
    );
    /* `at` is when the next leg starts, in seconds. */
    let at = 0;
    let from = 0;
    const leg = (to: number, ease = LEG_EASE) => {
      const duration = Math.max(MIN_LEG, (to - from) / SPEED);
      timeline.fromTo(
        travel,
        { x: from },
        { x: to, duration, ease, onUpdate: place, immediateRender: false },
        at,
      );
      from = to;
      at += duration;
    };
    points.forEach((point, index) => {
      leg(Number(point.dataset.x) || 0);
      const issue = issues[index];
      const tag = issue?.querySelector(".observations-main_tag");
      timeline.fromTo(
        point,
        { scale: 0, autoAlpha: 0 },
        { scale: 1, autoAlpha: 1, duration: 0.45, ease: "back.out(3)" },
        at - 0.08,
      );
      if (issue && tag) {
        timeline
          .fromTo(
            issue,
            { autoAlpha: 0 },
            { autoAlpha: 1, duration: 0.2, ease: "power1.out" },
            at,
          )
          .fromTo(
            tag,
            { scale: 0.6, y: 10, transformOrigin: "50% 100%" },
            { scale: 1, y: 0, duration: 0.6, ease: "back.out(2.2)" },
            at,
          );
      }
      at += REST;
    });
    /* Off through the right edge, picking up speed as it goes. */
    leg(END, "power2.in");
    place();
    timeline.timeScale(PACE);
    return timeline;
  }

  function setUp(section: HTMLElement) {
    const chart = section.querySelector<HTMLElement>(
      ".observations-main_chart",
    );
    if (!chart) return () => {};

    /* When the chart comes into view the dot runs once by itself; scrolling
       back past it doesn't replay or reverse it. */
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const timeline = buildTimeline(chart);
      if (!timeline) return;
      const trigger = ScrollTrigger.create({
        trigger: chart,
        start: "top 80%",
        once: true,
        onEnter: () => {
          timeline.play();
        },
      });
      return () => {
        trigger.kill();
        timeline.progress(1).kill();
      };
    });
    return () => mm.revert();
  }

  onPage(() => {
    const cleanups = [
      ...document.querySelectorAll<HTMLElement>(".observations-main_wrap"),
    ].map(setUp);
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style is:global>
  @layer components {
    /* The dashed rails run the full height, so the space above and below
       sits inside the framed container rather than on the section. */
    .observations-main_frame {
      padding-block: var(--section-space-xlarge);
    }

    .observations-main_content {
      display: flex;
      flex-direction: column;
      gap: var(--section-space-small);
      width: 100%;
    }

    /* A label in a narrow column, the content in a wide one, as drawn on
       the 1640px working area: 228, a 162 gap, then 1250 holding an 860
       measure. The measure never drops below the chart's 40rem, so on
       narrower screens it takes the free space on the right first. Text is
       BG normal (#121212); only the paragraph keeps the theme's text. */
    .observations-main_row {
      --_measure: max(calc(860 / 1250 * 100%), 40rem);
      display: grid;
      gap: var(--space-4);
      color: var(--dark-900);
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 228fr) minmax(0, 162fr) minmax(
            0,
            1250fr
          );
        column-gap: 0;
        & > :nth-child(2) {
          grid-column: 3;
        }
      }
    }

    .observations-main_label,
    .observations-main_heading,
    .observations-main_text {
      margin: 0;
    }

    /* The labels keep their full 18px line, as drawn, so their text sits
       below the heading's cap line and level with the time axis. */
    .observations-main_label {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      @media (width >= 64rem) {
        white-space: nowrap;
      }
    }

    .observations-main_statement {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    /* Trimmed to Archivo's cap height and baseline as Figma trims it: the
       box is 201px for four lines at 44px, with the glyphs placed in it
       where Figma draws them (ascenders 2px above the box). */
    .observations-main_heading {
      --_trim-top: 0.341em;
      --_trim-bottom: 0.328em;
      @media (width >= 64rem) {
        max-width: var(--_measure);
      }
    }

    /* The paragraph keeps its full line height, as drawn: only the heading
       is trimmed to its cap height. */
    .observations-main_text {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      max-width: 35.5rem;
      color: color-mix(in srgb, var(--text) 60%, transparent);
    }

    /* From 48rem the chart fits its column. Below that it keeps 40rem and
       scrolls sideways, running out under the rails like the works row and
       always at least 5rem past them, so it reads as a scroller. */
    .observations-main_scroll {
      @media (width < 48rem) {
        --_inset: calc(var(--_frame-inset) - var(--border-width));
        margin-inline: calc(var(--_inset) * -1);
        padding-inline: var(--_inset);
        overflow-x: auto;
        overflow-y: hidden;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        &::-webkit-scrollbar {
          display: none;
        }
      }
      @media (width >= 64rem) {
        max-width: var(--_measure);
      }
    }

    .observations-main_chart {
      @media (width < 48rem) {
        width: max(40rem, 100% + 5rem);
      }
    }

    .observations-main_ticks {
      position: relative;
      height: 2.5rem;
    }

    /* The first time sits on its divider, the middle three are centred on
       theirs and the last ends on the plot's right edge. */
    .observations-main_tick {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      position: absolute;
      top: 0;
      white-space: nowrap;
      color: color-mix(in srgb, currentColor 40%, transparent);
      &.middle {
        translate: -50% 0;
      }
      &.end {
        translate: -100% 0;
      }
    }

    /* Only the running dot is clipped, as it leaves past the right edge;
       the first tag may spill a little left on a narrow chart. */
    .observations-main_plot {
      --_drawn: 1;
      position: relative;
      aspect-ratio: 861 / 160;
    }

    .observations-main_track {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .observations-main_graph,
    .observations-main_curve {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* A dotted accent line, drawn up to the running dot. The clip is on the
       svg, which spans the plot exactly; on the path it would be measured
       from the path's own box, which runs on past the right edge. */
    .observations-main_curve {
      clip-path: inset(0 calc((1 - var(--_drawn)) * 100%) 0 0);
      & path {
        fill: none;
        stroke: var(--brand-500);
        stroke-dasharray: 2 2;
      }
    }

    /* Drawn as crisp 1px strokes so each divider snaps to one pixel at any
       width or zoom, rather than smearing across two. */
    .observations-main_dividers {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      stroke: var(--stroke);
      stroke-width: 1;
    }

    .observations-main_point {
      position: absolute;
      translate: -50% -50%;
    }

    /* Each tag is centred over its point, its bottom 17px above the point's
       centre. The script moves the anchor, so the tag keeps its own offset. */
    .observations-main_issue {
      position: absolute;
    }

    .observations-main_tag {
      position: absolute;
      left: 0;
      bottom: 1.0625rem;
      translate: -50% 0;
      padding: 0.25rem 0.625rem;
      background-color: var(--stroke);
      border-radius: var(--radius-small);
      font-size: 0.75rem;
      font-weight: var(--primary-medium);
      line-height: var(--line-height-huge);
      white-space: nowrap;
    }

    .observations-main_runner {
      position: absolute;
      left: 0;
      top: 80%;
      width: 0.75rem;
      height: 0.75rem;
      translate: -50% -50%;
      border-radius: 50%;
      background-color: var(--brand-500);
      box-shadow:
        0 0 0.5rem 0.125rem color-mix(in lab, var(--brand-500) 70%, transparent),
        0 0 1.5rem 0.375rem color-mix(in lab, var(--brand-500) 35%, transparent);
      visibility: hidden;
    }
  }
</style>
