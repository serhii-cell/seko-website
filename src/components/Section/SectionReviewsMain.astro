---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Icon from "@/components/Media/Icon.astro";
import ArrowBack from "@/assets/home/reviews/icon-arrow-back.svg";
import ArrowForward from "@/assets/home/reviews/icon-arrow-forward.svg";

type Review = {
  /** The client's name, listed in the selector. */
  client: string;
  /** What the client said. */
  quote: string;
  /** The client's logotype, an SVG imported from `src/assets`. */
  logo?: SvgComponent;
  /** One line on who the client is, set beside the logo. */
  tagline?: string;
};

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The small label above the heading. */
  label?: string;
  /** The section heading. Nothing is output without it. */
  heading?: string;
  /** The short introduction beside the heading. */
  text?: string;
  /** One story per client, in the order they are listed. Nothing is output without one. */
  reviews?: Review[];
}

const {
  render = true,
  label,
  heading,
  text,
  reviews = [],
  class: className,
  ...rest
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
---

{
  render && heading && reviews.length > 0 && (
    <Section
      frame
      gap="0"
      class:list={["reviews-main_wrap dashed dashed-bottom", className]}
      containerClass="reviews-main_frame hatched"
      {...rest}
    >
      <header class="reviews-main_header dashed dashed-bottom">
        <div class="reviews-main_title">
          <Paragraph variant="label" class="reviews-main_label">
            {label}
          </Paragraph>
          <Heading tag="h2">{heading}</Heading>
        </div>
        <Paragraph class="reviews-main_intro color-faded">{text}</Paragraph>
      </header>

      <div class="reviews-main_body" data-reviews>
        <div
          class="reviews-main_list"
          role="tablist"
          aria-orientation="vertical"
          aria-label="Clients"
        >
          {reviews.map((review, i) => (
            <button
              type="button"
              class:list={["reviews-main_client", i === 0 && "is-active"]}
              id={`review-tab-${uid}-${i}`}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`review-panel-${uid}-${i}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="reviews-main_name" data-lines>
                {review.client}
              </span>
              <span class="reviews-main_dot" aria-hidden="true" />
            </button>
          ))}
        </div>

        <div class="reviews-main_arrows" data-fade>
          <button
            type="button"
            class="reviews-main_arrow is-previous"
            aria-label="Previous client story"
            data-reviews-step="-1"
          >
            <Icon src={ArrowBack} class="reviews-main_icon" />
          </button>
          <button
            type="button"
            class="reviews-main_arrow is-next"
            aria-label="Next client story"
            data-reviews-step="1"
          >
            <Icon src={ArrowForward} class="reviews-main_icon" />
          </button>
        </div>

        <p class="sr-only" aria-live="polite" data-reviews-status />

        <div class="reviews-main_panels" data-lines="off">
          {reviews.map((review, i) => {
            const Logo = review.logo;
            return (
              <figure
                class:list={["reviews-main_panel", i === 0 && "is-active"]}
                id={`review-panel-${uid}-${i}`}
                role="tabpanel"
                aria-labelledby={`review-tab-${uid}-${i}`}
                tabindex="0"
              >
                <blockquote class="reviews-main_quote">
                  <Paragraph variant="h3">{review.quote}</Paragraph>
                </blockquote>
                <figcaption class="reviews-main_source">
                  {Logo && (
                    <Logo
                      class="reviews-main_logo"
                      role="img"
                      aria-label={review.client}
                      data-fade
                    />
                  )}
                  <Paragraph variant="label" class="reviews-main_tagline">
                    {review.tagline}
                  </Paragraph>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </Section>
  )
}

<noscript>
  <style>
    .reviews-main_list,
    .reviews-main_arrows {
      display: none;
    }
    .reviews-main_panels {
      gap: var(--section-space-small);
    }
    .reviews-main_panel {
      grid-area: auto;
      opacity: 1;
      visibility: visible;
    }
  </style>
</noscript>

<script>
  import { gsap, SplitText } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";

  /* Osmo's Line Reveal Testimonials: the story going out slides up out of
     its line masks as its logo wipes away; the one coming in rises line by
     line into place as its logo wipes in. */
  const HIDDEN = "inset(0% 100% 0% 0%)";
  const GONE = "inset(0% 0% 0% 100%)";
  const SHOWN = "inset(0% 0% 0% 0%)";

  onPage(() => {
    const controller = new AbortController();
    const { signal } = controller;
    const cleanups: (() => void)[] = [];
    const moving =
      !matchMedia("(prefers-reduced-motion: reduce)").matches &&
      !document.documentElement.classList.contains("stacki-designer");

    for (const root of document.querySelectorAll<HTMLElement>(
      "[data-reviews]",
    )) {
      const tabs = [
        ...root.querySelectorAll<HTMLButtonElement>(".reviews-main_client"),
      ];
      const panels = [
        ...root.querySelectorAll<HTMLElement>(".reviews-main_panel"),
      ];
      const status = root.querySelector<HTMLElement>("[data-reviews-status]");
      if (tabs.length === 0 || tabs.length !== panels.length) continue;

      let current = Math.max(
        0,
        tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true"),
      );

      /* With motion, every story stays laid out and its lines are masked
         off instead; only the one shown can be reached. */
      let timeline: gsap.core.Timeline | null = null;
      const slides = moving
        ? panels.map((panel, i) => {
            const targets = [
              panel.querySelector<HTMLElement>(".reviews-main_quote .text"),
              panel.querySelector<HTMLElement>(".reviews-main_tagline"),
            ].filter((el): el is HTMLElement => !!el);
            const splits = targets.map((el) =>
              SplitText.create(el, {
                type: "lines",
                mask: "lines",
                linesClass: "reviews-main_line",
                autoSplit: true,
                onSplit(self) {
                  gsap.set(self.lines, { yPercent: i === current ? 0 : 110 });
                },
              }),
            );
            const logo = panel.querySelector<SVGElement>(".reviews-main_logo");
            if (logo) gsap.set(logo, { clipPath: i === current ? SHOWN : HIDDEN });
            panel.inert = i !== current;
            return {
              panel,
              logo,
              splits,
              lines: () => splits.flatMap((split) => split.lines),
            };
          })
        : null;
      if (slides) {
        root.querySelector(".reviews-main_panels")?.classList.add("is-split");
        cleanups.push(() => {
          timeline?.kill();
          slides.forEach(({ panel, logo, splits }) => {
            panel.inert = false;
            splits.forEach((split) => split.revert());
            if (logo) gsap.set(logo, { clearProps: "clipPath" });
          });
        });
      }

      const reveal = (from: number, to: number) => {
        if (!slides || from === to) return;
        timeline?.progress(1);
        const out = slides[from];
        const into = slides[to];
        out.panel.inert = true;
        into.panel.inert = false;
        gsap.set(into.lines(), { yPercent: 110 });
        if (into.logo) gsap.set(into.logo, { clipPath: HIDDEN });
        timeline = gsap
          .timeline()
          .to(
            out.lines(),
            { yPercent: -110, duration: 0.6, ease: "power4.inOut", stagger: { amount: 0.25 } },
            0,
          );
        if (out.logo)
          timeline.to(out.logo, { clipPath: GONE, duration: 0.6, ease: "power4.inOut" }, 0);
        timeline.to(
          into.lines(),
          { yPercent: 0, duration: 0.7, ease: "power4.inOut", stagger: { amount: 0.4 } },
          ">-=0.3",
        );
        if (into.logo)
          timeline.to(into.logo, { clipPath: SHOWN, duration: 0.75, ease: "power4.inOut" }, "<");
      };

      const show = (next: number, focus = false, announce = false) => {
        const index = (next + tabs.length) % tabs.length;
        reveal(current, index);
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel, i) =>
          panel.classList.toggle("is-active", i === index),
        );
        current = index;
        if (focus) tabs[index].focus();
        // The arrows keep focus, so say which story they brought up.
        if (announce && status) {
          status.textContent = `${tabs[index].textContent?.trim()}, story ${index + 1} of ${tabs.length}`;
        }
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => show(i), { signal });
        tab.addEventListener(
          "keydown",
          (event) => {
            const moves: Record<string, number> = {
              ArrowDown: current + 1,
              ArrowRight: current + 1,
              ArrowUp: current - 1,
              ArrowLeft: current - 1,
              Home: 0,
              End: tabs.length - 1,
            };
            if (!(event.key in moves)) return;
            event.preventDefault();
            show(moves[event.key], true);
          },
          { signal },
        );
      });

      for (const step of root.querySelectorAll<HTMLButtonElement>(
        "[data-reviews-step]",
      )) {
        step.addEventListener(
          "click",
          () => show(current + Number(step.dataset.reviewsStep), false, true),
          { signal },
        );
      }
    }

    return () => {
      controller.abort();
      cleanups.forEach((cleanup) => cleanup());
    };
  });
</script>

<style is:global>
  @layer components {
    .reviews-main_wrap {
      --_label-trim: 0.27rem;
      --_fade: var(--hover-duration);
      --_arrow: 7.5rem;
      --_arrow-inset: var(--space-4);
      --_muted: color-mix(in lab, currentcolor 40%, transparent);
      @media (width < 48rem) {
        --_arrow: 4.5rem;
        --_arrow-inset: var(--space-3);
      }
      & :is(.heading, .text) {
        margin: 0;
      }
    }

    /* Header: label and heading, the introduction beside them */
    .reviews-main_header {
      align-self: stretch;
      display: grid;
      row-gap: var(--space-5);
      /* Runs out to the rails but stops inside them, as the 1px rails do in
         Figma; the bottom padding leaves room for the 1px dashed rule. */
      margin-inline: calc((var(--_frame-inset) - var(--border-width)) * -1);
      padding: calc(var(--section-space-medium) + var(--_label-trim))
        var(--_frame-inset)
        calc(var(--section-space-small) + var(--border-width));
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 681fr) minmax(0, 957fr);
        align-items: end;
      }
    }
    .reviews-main_title {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .reviews-main_label,
    .reviews-main_tagline {
      color: var(--_muted);
    }
    .reviews-main_header .reviews-main_intro {
      max-width: 17.25rem;
      @media (width >= 64rem) {
        margin-bottom: 0.375rem;
      }
    }

    /* Body: client list and arrows, the story beside them */
    .reviews-main_body {
      align-self: stretch;
      display: grid;
      /* On narrow screens the arrows sit under the list they step through,
         above the story, so they stay put whatever the story's length. */
      grid-template-areas: "list" "arrows" "panels";
      row-gap: var(--section-space-small);
      padding-block: var(--section-space-small) var(--section-space-medium);
      /* Content starts inside the 1px rails, not on them. */
      padding-inline: var(--border-width);
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 681fr) minmax(0, 957fr);
        grid-template-rows: auto 1fr;
        grid-template-areas: "list panels" "arrows panels";
      }
    }
    .reviews-main_list {
      grid-area: list;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-2);
    }
    .reviews-main_client {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      min-height: 1.5rem;
      color: color-mix(in lab, var(--text) 60%, transparent);
      border-radius: 0.125rem;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
      &:focus-visible {
        color: var(--text);
        outline-color: var(--brand-500);
        outline-offset: 0;
      }
      &.is-active {
        color: var(--brand-500);
        /* The dot's halo reaches 4px past the button; room for it while
           focused, so the outline clears the ring. At rest the button keeps
           Figma's width (label + 24 + 6). */
        &:focus-visible {
          padding-right: 0.25rem;
        }
      }
    }
    .reviews-main_dot {
      display: none;
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      background-color: var(--brand-500);
      box-shadow: 0 0 0 0.25rem
        color-mix(in lab, var(--brand-500) 20%, transparent);
      .reviews-main_client.is-active & {
        display: block;
      }
    }

    .reviews-main_arrows {
      grid-area: arrows;
      align-self: start;
      display: flex;
    }
    .reviews-main_arrow {
      position: relative;
      width: var(--_arrow);
      height: var(--_arrow);
      color: var(--brand-500);
      border: var(--border-width) solid var(--stroke);
      font-size: 1rem;
      transition: background-color var(--hover-duration) var(--hover-ease);
      &.is-previous {
        border-right-width: 0;
      }
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-2);
        }
      }
      &:active {
        background-color: color-mix(in srgb, var(--background-2), var(--text) 1%);
      }
      &:focus-visible {
        outline: none;
        box-shadow: inset 0 0 0 var(--focus-width) var(--brand-500);
      }
    }
    /* Inset from the arrow's outer edge, so less its 1px border */
    .reviews-main_icon {
      --_inset: calc(var(--_arrow-inset) - var(--border-width));
      position: absolute;
      bottom: var(--_inset);
      .reviews-main_arrow.is-previous & {
        left: var(--_inset);
      }
      .reviews-main_arrow.is-next & {
        right: var(--_inset);
      }
    }

    /* Stories, stacked in one cell and cross-faded. Each is as tall as the
       longest, its source pinned to the bottom, so the logo row stays put
       whatever the length of the quote above it. */
    .reviews-main_panels {
      grid-area: panels;
      display: grid;
      align-items: stretch;
    }
    .reviews-main_panel {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      gap: var(--section-space-small);
      /* Figma's column is 860, but Archivo sets a touch narrower here than in
         Figma; 856 gives every quote the line breaks drawn in Figma. */
      max-width: 53.5rem;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--_fade) var(--hover-ease),
        visibility 0s linear var(--_fade);
      &.is-active {
        opacity: 1;
        visibility: visible;
        transition: opacity calc(var(--_fade) * 1.5) var(--hover-ease)
          calc(var(--_fade) * 0.75);
      }
      &:focus-visible {
        outline-offset: var(--space-3);
      }
    }
    /* With motion every story stays laid out in the one cell and the
       script masks its lines off instead of fading it. */
    .reviews-main_panels.is-split .reviews-main_panel {
      opacity: 1;
      visibility: visible;
      transition: none;
    }

    /* Trim the quote's last line to its baseline, as Figma's cap-height
       trim does, so the logo row lands 80px below it */
    .reviews-main_quote .text {
      --_trim-bottom: 0.25em;
    }
    .reviews-main_source {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      margin-top: auto;
      @media (width < 48rem) {
        flex-direction: column;
        align-items: start;
        gap: var(--space-4);
      }
    }
    .reviews-main_logo {
      flex: none;
      width: auto;
      height: 2rem;
      opacity: 0.4;
      @media (width < 48rem) {
        height: 1.5rem;
      }
    }
    }
  }
</style>
