---
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import ButtonWipe from "@/components/ButtonWipe.astro";
import AsciiStage from "@/components/Media/AsciiStage.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The page's main heading. Nothing is output without it. */
  heading?: string;
  /** The paragraph beside the heading. */
  text?: string;
  /** The button's label. The button is left out without it. */
  buttonText?: string;
  /** Where the button goes. */
  buttonHref?: string;
}

const {
  render = true,
  heading,
  text,
  buttonText,
  buttonHref = "#",
} = Astro.props;
---

{
  render && heading && (
    <Section class="hero-main_wrap" containerClass="hero-main_container">
      <div class="hero-main_stage">
        <AsciiStage />
      </div>
      <ContentWrapper
        variant="columns"
        class="hero-main_intro"
        column1Class="align-self-start"
      >
        <Heading tag="h1" variant="h1" class="hero-main_title" data-intro>
          {heading}
        </Heading>
        <Fragment slot="column2">
          <Paragraph
            variant="large"
            class="hero-main_text color-faded"
            data-intro
            render={!!text}
          >
            {text}
          </Paragraph>
          <ButtonWrapper data-intro render={!!buttonText}>
            <ButtonWipe
              text={buttonText}
              href={buttonHref}
              class="hero-main_button"
            />
          </ButtonWrapper>
        </Fragment>
      </ContentWrapper>
    </Section>
  )
}

<style is:global>
  @layer components {
    /* One screen tall, less the site margin left free under the button; the
       section gap follows it. */
    .hero-main_wrap {
      height: calc(100svh - var(--nav-height) - var(--site-margin));
      min-height: 30rem;
      /* What follows sits as far below the button as the stage's line sits
         above the heading, in place of the page's usual section rhythm. */
      margin-bottom: calc(var(--space-8) - var(--section-space-medium));
    }

    .hero-main_container {
      flex: 1 1 auto;
      min-height: 0;
      align-items: stretch;
    }

    /* Out to the page frame's lines, ruled below; the nav's line is above. */
    .hero-main_stage {
      flex: 1 1 auto;
      min-height: 7.5rem;
      margin-inline: calc(var(--content-inset) * -1);
      --_line: linear-gradient(var(--border-faint) 0 0);
      padding-bottom: var(--border-width);
      background: var(--_line) bottom / 100% var(--border-width) no-repeat;
    }

    .hero-main_intro {
      flex: none;
      row-gap: var(--space-4);
      @media (width >= 64rem) {
        &.columns {
          grid-template-columns: var(--layout-split);
        }
      }
    }

    /* Short screens: the type gives way so the hero still fits one screen. */
    @media (width >= 48rem) and (height <= 51.25rem) {
      .hero-main_title {
        font-size: min(var(--h1), 6.2svh);
      }

      .hero-main_text {
        font-size: max(1rem, min(var(--text-large), 2.5svh));
      }
    }
  }
</style>
