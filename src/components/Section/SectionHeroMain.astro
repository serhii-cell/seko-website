---
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import AsciiStage from "@/components/Media/AsciiStage.astro";
import ContentStatsMain, {
  type Stat,
} from "@/components/Content/ContentStatsMain.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The page's main heading. Nothing is output without it. */
  heading?: string;
  /** The paragraph under the heading. */
  text?: string;
  /** Short facts beside the paragraph, each a label and its value. */
  facts?: { label: string; value: string }[];
  /** The figures in the band under the hero, each with its client's logo. */
  stats?: Stat[];
}

const { render = true, heading, text, facts = [], stats = [] } = Astro.props;
---

{
  render && heading && (
    <Section
      class="hero-main_wrap overflow-x-clip"
      containerClass="hero-main_container"
      frame={true}
      gap="0"
    >
      <div class="hero-main_layout" data-step="4">
        <div class="hero-main_content">
          <div class="hero-main_head dashed dashed-bottom">
            <Heading tag="h1" class="hero-main_title">
              {heading}
            </Heading>
          </div>
          <div class="hero-main_details">
            <div class="hero-main_intro">
              <Paragraph class="hero-main_text" render={!!text}>
                {text}
              </Paragraph>
            </div>
            {facts.length > 0 && (
              <dl class="hero-main_facts">
                {facts.map((fact) => (
                  <div class="hero-main_fact">
                    <dt class="text-style-label color-faded" data-lines>
                      {fact.label}
                    </dt>
                    <dd class="hero-main_value" data-lines>
                      {fact.value}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
        <div class="hero-main_visual">
          <AsciiStage class="hero-main_stage" />
        </div>
      </div>
      <ContentStatsMain stats={stats} data-step="5" />
    </Section>
  )
}

<style is:global>
  @layer components {
    /* Flush to the working area's rails: the cells set their own insets, and
       the ASCII panel runs to the right rail. */
    .hero-main_container.framed {
      padding-inline: 0;
    }

    .hero-main_layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      @media (width >= 64rem) {
        /* The panel starts where the third stat tile does (half the row
           plus half the tiles' 1rem gap), so it is always exactly as wide
           as two tiles. */
        grid-template-columns: minmax(0, calc(50% + 0.5rem)) minmax(0, 1fr);
      }
    }

    .hero-main_content {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .hero-main_head {
      padding: var(--_frame-inset);
      @media (width >= 64rem) {
        padding-right: 0;
      }
    }

    .hero-main_title {
      max-width: 42.125rem;
      margin: 0;
    }

    /* The design sets these on their full line height, untrimmed. */
    .hero-main_title,
    .hero-main_text,
    .hero-main_fact dt {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
    }

    /* Paragraph and facts side by side wherever the text column is wide
       enough: the full width below 64rem, the left half from 100rem. */
    .hero-main_details {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      @media (48rem <= width < 64rem) or (width >= 100rem) {
        grid-template-columns: minmax(0, 434fr) minmax(0, 442fr);
        & .hero-main_intro {
          padding-bottom: var(--section-space-medium);
        }
        & .hero-main_facts {
          padding-bottom: var(--space-6);
        }
      }
    }

    .hero-main_intro {
      padding: var(--_frame-inset) var(--_frame-inset) 0;
    }

    .hero-main_text,
    .hero-main_value {
      color: color-mix(in srgb, currentcolor 80%, transparent);
    }

    .hero-main_text {
      margin: 0;
    }

    .hero-main_facts {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      margin: 0;
      padding: var(--_frame-inset);
    }

    .hero-main_fact {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      & dd {
        margin: 0;
        line-height: var(--line-height-huge);
      }
    }

    /* The ASCII panel: below 64rem it sits under the text at the panel's
       own shape; from 64rem it fills the right column to the hero's height,
       its left edge a dashed rule. */
    .hero-main_visual {
      position: relative;
      display: grid;
      min-width: 0;
      /* The panel's edge is a fixed grid line: it stays put while the panel
         opens from its centre during the intro, and sits above the panel. */
      &::after {
        content: "";
        position: absolute;
        z-index: 1;
        inset: 0 0 auto;
        height: var(--border-width);
        pointer-events: none;
        background-image: repeating-linear-gradient(
          to right,
          var(--stroke) 0 var(--dash),
          transparent 0 calc(var(--dash) * 2)
        );
        @media (width >= 64rem) {
          inset: 0 auto 0 0;
          width: var(--border-width);
          height: auto;
          background-image: repeating-linear-gradient(
            to bottom,
            var(--stroke) 0 var(--dash),
            transparent 0 calc(var(--dash) * 2)
          );
        }
      }
    }

    .hero-main_stage.ascii-stage_wrap {
      @media (width >= 64rem) {
        aspect-ratio: auto;
        height: 100%;
      }
    }
  }
</style>
