---
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import AsciiModel from "@/components/Media/AsciiModel.astro";
import type { ComponentProps } from "astro/types";

type Problem = {
  heading: string;
  /** Paragraphs under the heading, one string each. */
  text: string[];
  model: ComponentProps<typeof AsciiModel>["variant"];
};

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** One step each: a heading, its paragraphs and the model beside them. */
  problems?: Problem[];
}

const { render = true, problems = [] } = Astro.props;
---

{
  render && problems.length > 0 && (
    <Section
      class="problems-main_wrap"
      containerClass="problems-main_container"
    >
      <div
        class="problems-main_layout"
        data-reveal="own"
        style={`--_steps: ${problems.length}`}
      >
        {problems.map((problem, index) => (
          <div class="problems-main_visual" style={`order: ${index * 2}`}>
            <AsciiModel variant={problem.model} class="problems-main_model" />
          </div>
        ))}
        <div class="problems-main_content">
          <div class="problems-main_sticky">
            {problems.map((problem, index) => (
              <div class="problems-main_step" style={`order: ${index * 2 + 1}`}>
                <Heading tag="h2">{problem.heading}</Heading>
                {problem.text.map((paragraph) => (
                  <Paragraph
                    variant="main"
                    class="problems-main_text color-faded"
                  >
                    {paragraph}
                  </Paragraph>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </Section>
  )
}

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";
  import { createMarker, type Marker } from "@/utils/marker.ts";

  const textOf = (step: Element) => [
    ...step.querySelectorAll<HTMLElement>(".heading, .text"),
  ];

  /* When the first line of `element` is fully on screen. */
  const firstLine = (element: Element) => {
    const style = getComputedStyle(element);
    const height = parseFloat(style.lineHeight);
    return `top+=${Number.isNaN(height) ? parseFloat(style.fontSize) * 1.2 : height} bottom`;
  };

  function setUp(layout: HTMLElement) {
    const visuals = [
      ...layout.querySelectorAll<HTMLElement>(".problems-main_visual"),
    ];
    const models = visuals.map((visual) =>
      visual.querySelector<HTMLElement>(".problems-main_model"),
    );
    const steps = [
      ...layout.querySelectorAll<HTMLElement>(".problems-main_step"),
    ];
    const mm = gsap.matchMedia();

    /* From 64rem up the text holds on the right while the models scroll
       past on the left. As a model reaches the middle of the screen its
       text takes over, the last one fading out and the new one wiped in by
       the marker. */
    mm.add(
      {
        wide: "(width >= 64rem)",
        motion: "(prefers-reduced-motion: no-preference)",
      },
      (context) => {
        const { wide, motion } = context.conditions as {
          wide: boolean;
          motion: boolean;
        };
        if (!wide) return;
        let active = -1;
        let markers: Marker[] = [];

        const show = (index: number) => {
          if (index === active) return;
          markers.forEach((marker) => marker.revert());
          markers = [];
          steps.forEach((step, i) => {
            if (i === index) return;
            gsap.to(step, {
              autoAlpha: 0,
              duration: motion ? 0.25 : 0,
              overwrite: true,
            });
          });
          const step = steps[index];
          gsap.set(step, { autoAlpha: 1, overwrite: true });
          if (motion) {
            markers = textOf(step).map(createMarker);
            markers.forEach((marker, i) => marker.play(i * 0.15));
          }
          active = index;
        };

        gsap.set(steps, { autoAlpha: 0 });
        ScrollTrigger.create({
          trigger: textOf(steps[0])[0],
          start: () => firstLine(textOf(steps[0])[0]),
          end: "max",
          once: true,
          onEnter: () => active === -1 && show(0),
        });
        visuals.slice(1).forEach((visual, i) => {
          ScrollTrigger.create({
            trigger: visual,
            start: "top center",
            onEnter: () => show(i + 1),
            onLeaveBack: () => show(i),
          });
        });

        return () => {
          markers.forEach((marker) => marker.revert());
          gsap.set(steps, { clearProps: "opacity,visibility" });
        };
      },
    );

    /* Narrower, each model sits above its own text: the models fade in and
       the text is wiped in by the marker as each scrolls into view. */
    mm.add(
      "(width < 64rem) and (prefers-reduced-motion: no-preference)",
      () => {
        const markers: Marker[] = [];
        steps.forEach((step) =>
          textOf(step).forEach((element) => {
            if (ScrollTrigger.isInViewport(element)) return;
            const marker = createMarker(element);
            markers.push(marker);
            ScrollTrigger.create({
              trigger: element,
              start: () => firstLine(element),
              end: "max",
              once: true,
              onEnter: () => marker.play(),
            });
          }),
        );
        const hidden = models.filter(
          (model): model is HTMLElement =>
            !!model && !ScrollTrigger.isInViewport(model),
        );
        gsap.set(hidden, { autoAlpha: 0 });
        ScrollTrigger.batch(hidden, {
          start: "top 90%",
          once: true,
          onEnter: (batch) =>
            gsap.to(batch, { autoAlpha: 1, clearProps: "opacity,visibility" }),
        });
        return () => {
          markers.forEach((marker) => marker.revert());
          gsap.set(hidden, { clearProps: "opacity,visibility" });
        };
      },
    );

    return () => mm.revert();
  }

  onPage(() => {
    const cleanups = [
      ...document.querySelectorAll<HTMLElement>(".problems-main_layout"),
    ].map(setUp);
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style is:global>
  @layer components {
    /* Phones and tablets: model, then its text, for each step in turn. */
    .problems-main_layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-8);
      width: 100%;
      @media (width >= 64rem) {
        grid-template-columns: var(--layout-split);
        grid-template-rows: repeat(var(--_steps), auto);
        column-gap: var(--section-space-small);
        row-gap: 0;
      }
    }

    .problems-main_content,
    .problems-main_sticky {
      display: contents;
    }

    .problems-main_step {
      & > :first-child {
        margin-top: 0;
      }
      & > :last-child {
        margin-bottom: 0;
      }
    }

    .problems-main_text {
      font-size: 1rem;
    }

    /* Wide: each model gets a screen of its own on the left, and the text
       holds in the middle of the screen on the right, one step at a time.
       The first model drops the room centring would leave above it, so it
       follows the section before by the page's section gap alone; the text
       column rises by the same room, so the first text still lines up with
       the first model and starts to hold as it reaches the middle. */
    @media (width >= 64rem) {
      .problems-main_layout {
        --_screen: calc(100svh - var(--nav-height));
        --_room: max(0rem, (var(--_screen) - 35rem) / 2);
      }

      .problems-main_visual {
        grid-column: 1;
        order: 0 !important;
        display: flex;
        align-items: center;
        min-height: var(--_screen);
        &:first-child {
          align-items: flex-start;
          min-height: calc(var(--_screen) - var(--_room));
        }
      }

      .problems-main_content {
        display: block;
        grid-column: 2;
        grid-row: 1 / -1;
        margin-top: calc(var(--_room) * -1);
      }

      .problems-main_sticky {
        position: sticky;
        top: var(--nav-height);
        display: grid;
        align-items: center;
        height: var(--_screen);
        pointer-events: none;
      }

      .problems-main_step {
        grid-area: 1 / 1;
        order: 0 !important;
        pointer-events: auto;
      }
    }
  }
</style>
