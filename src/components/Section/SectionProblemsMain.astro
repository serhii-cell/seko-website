---
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import type { ComponentProps } from "astro/types";
import { grip, panel, PLACE, STILL, STEP, W, H } from "@/utils/dial-scene.ts";
import gearTeam from "@/assets/home/problems/problem-2-gear-team.svg?raw";
import {
  BUBBLES,
  glow as gearGlow,
  hub,
  wheel,
  W as GEAR_W,
  H as GEAR_H,
} from "@/utils/gear-scene.ts";
import bicycle from "@/assets/home/problems/problem-3-bicycle.svg?raw";

type Problem = {
  heading: string;
  text: string;
  costs: string[];
};

type SectionProps = ComponentProps<typeof Section>;

interface Props extends Pick<SectionProps, "paddingTop"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The small label beside the heading. */
  label?: string;
  /** The section heading. Nothing is output without it. */
  heading?: string;
  /**
   * The three problems, in order: each one's heading, text and the business
   * costs listed under it. Each takes its own layout and illustration.
   */
  problems?: Problem[];
  /** Text of the button under the problems. Left out without it. */
  buttonLabel?: string;
  /** Where that button goes. Defaults to the contact section. */
  buttonHref?: string;
}

const {
  render = true,
  label,
  heading,
  problems = [],
  buttonLabel,
  buttonHref = "#contact",
  paddingTop = "none",
} = Astro.props;

/* Figma's exports carry a white card, layer names as ids and ids that clash
   between files; the card is drawn in CSS, the parts that move are named
   with data-part and the ids the drawing needs are made unique. */
function prepare(
  source: string,
  prefix: string,
  parts: Record<string, string> = {},
  extra = "",
) {
  const viewBox = source.match(/viewBox="([^"]+)"/)?.[1] ?? "";
  const used = new Set(
    [...source.matchAll(/url\(#([^)]+)\)/g)].map((match) => match[1]),
  );
  return source
    .replace(
      /<svg[^>]*>/,
      `<svg viewBox="${viewBox}" fill="none" xmlns="http://www.w3.org/2000/svg" class="problems-main_drawing" aria-hidden="true" focusable="false">`,
    )
    .replace(/<rect width="[\d.]+" height="[\d.]+" fill="white"\/>/, "")
    .replace(/ id="([^"]+)"/g, (_, id: string) =>
      parts[id]
        ? ` data-part="${parts[id]}"`
        : used.has(id)
          ? ` id="${prefix}-${id}"`
          : "",
    )
    .replace(/url\(#([^)]+)\)/g, `url(#${prefix}-$1)`)
    .replace("</svg>", `${extra}</svg>`);
}

/* One `<g>` of an SVG source, by its id, with everything inside it. */
function group(source: string, id: string) {
  const start = source.indexOf(`<g id="${id}">`);
  if (start < 0) return "";
  const tags = /<g\b|<\/g>/g;
  tags.lastIndex = start;
  let depth = 0;
  for (let match = tags.exec(source); match; match = tags.exec(source)) {
    depth += match[0] === "<g" ? 1 : -1;
    if (depth === 0) return source.slice(start, match.index + 4);
  }
  return "";
}

/* Problem 2: the people from the Figma drawing, the gear drawn in code so
   it can turn, and what the people say, one line at a time, left first.
   The page shows only the first line (both at once would overlap on
   phones); the script plays them all in turn. */
const LINES = [
  "How should it work?",
  "How do we build it?",
  "What's the best practice?",
  "What is the cost?",
];
const gear = `<svg viewBox="0 0 ${GEAR_W} ${GEAR_H}"><g id="PersonLeft">${group(gearTeam, "Person right")}</g><g id="PersonRight">${group(gearTeam, "Person right_2")}</g><g id="Wheel"><g id="Spin">${wheel(0)}</g></g><g id="Hub"><g id="HubBody">${hub()}</g>${gearGlow("gear-light")}</g></svg>`;
const bubbles = (["left", "right"] as const)
  .map(
    (side, index) =>
      `<span class="problems-main_bubble text-style-label${index > 0 ? " is-quiet" : ""}" data-side="${side}" style="left: ${(BUBBLES[side].x * 100).toFixed(2)}%; top: ${(BUBBLES[side].y * 100).toFixed(2)}%"><span class="problems-main_bubble_text">${LINES[index]}</span></span>`,
  )
  .join("");

const visuals = [
  prepare(
    `<svg viewBox="0 0 ${W} ${H}"><g transform="${PLACE}"><g id="Panel">${panel(STILL)}</g><g id="Grip">${grip(STILL * STEP)}</g></g></svg>`,
    "problem-1",
    { Panel: "panel", Grip: "grip" },
  ),
  prepare(gear, "problem-2", {
    PersonLeft: "person-left",
    PersonRight: "person-right",
    Wheel: "wheel",
    Spin: "spin",
    Hub: "hub",
    HubBody: "hub-body",
  }) +
    `<div class="problems-main_bubbles" aria-hidden="true" data-reveal="own" data-said='${JSON.stringify(LINES).replace(/'/g, "&#39;")}'>${bubbles}</div>`,
  prepare(bicycle, "problem-3", { "Rectangle 148": "beam" }),
];
const layouts = ["side", "middle", "top"];
const total = String(Math.min(problems.length, visuals.length));
---

{
  render && heading && (
    <Section
      theme="light"
      frame={true}
      gap="0"
      paddingTop={paddingTop}
      class="problems-main_wrap overflow-x-clip"
    >
      <div class="problems-main_band">
        <div class="problems-main_panel hatched">
          <div class="problems-main_header">
            <Paragraph
              variant="label"
              class="problems-main_label color-faded"
              render={!!label}
            >
              {label}
            </Paragraph>
            <Heading tag="h2" class="problems-main_heading">
              {heading}
            </Heading>
          </div>
          <div
            class="problems-main_divider dashed dashed-top"
            aria-hidden="true"
          />
          {problems.slice(0, visuals.length).map((problem, index) => (
            <Fragment>
              {index > 0 && (
                <div
                  class="problems-main_divider dashed dashed-top"
                  aria-hidden="true"
                />
              )}
              <article class:list={["problems-main_problem", layouts[index]]}>
                <div class="problems-main_meta">
                  <Paragraph variant="label" class="color-faded">
                    Problem
                  </Paragraph>
                  <p class="problems-main_count text-style-label" data-fade>
                    <span>{index + 1}</span>
                    <span class="color-faded" aria-hidden="true">
                      /
                    </span>
                    <span class="sr-only">of</span>
                    <span class="color-faded">{total}</span>
                  </p>
                </div>
                <div class="problems-main_visual" data-fade>
                  <Fragment set:html={visuals[index]} />
                </div>
                <div class="problems-main_body">
                  <div class="problems-main_intro">
                    <Heading tag="h3" class="problems-main_title">
                      {problem.heading}
                    </Heading>
                    <Paragraph
                      variant="main"
                      class="problems-main_text color-faded"
                    >
                      {problem.text}
                    </Paragraph>
                  </div>
                  <div class="problems-main_costs">
                    <Paragraph variant="label" class="color-faded">
                      Business cost
                    </Paragraph>
                    <ul class="problems-main_list">
                      {problem.costs.map((cost) => (
                        <li class="problems-main_cost">
                          <svg
                            class="problems-main_icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                            data-fade
                          >
                            <path
                              fill="currentColor"
                              d="M8.4 17 12 13.4l3.6 3.6 1.4-1.4-3.6-3.6L17 8.4 15.6 7 12 10.6 8.4 7 7 8.4l3.6 3.6L7 15.6 8.4 17Zm3.6 5a9.74 9.74 0 0 1-3.9-.79 10.1 10.1 0 0 1-3.17-2.14 10.1 10.1 0 0 1-2.14-3.17A9.74 9.74 0 0 1 2 12c0-1.38.26-2.68.79-3.9a10.1 10.1 0 0 1 2.14-3.17A10.1 10.1 0 0 1 8.1 2.79 9.74 9.74 0 0 1 12 2c1.38 0 2.68.26 3.9.79a10.1 10.1 0 0 1 3.17 2.14 10.1 10.1 0 0 1 2.14 3.17c.53 1.22.79 2.52.79 3.9s-.26 2.68-.79 3.9a10.1 10.1 0 0 1-2.14 3.17 10.1 10.1 0 0 1-3.17 2.14c-1.22.53-2.52.79-3.9.79Zm0-2c2.23 0 4.13-.78 5.68-2.33C19.23 16.13 20 14.23 20 12s-.78-4.13-2.33-5.68C16.13 4.78 14.23 4 12 4s-4.13.78-5.68 2.32C4.78 7.88 4 9.77 4 12s.78 4.13 2.32 5.67C7.88 19.23 9.77 20 12 20Z"
                            />
                          </svg>
                          <Paragraph
                            variant="main"
                            class="problems-main_cost-text"
                          >
                            {cost}
                          </Paragraph>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
            </Fragment>
          ))}
        </div>
      </div>
      {buttonLabel && (
        <div class="problems-main_cta">
          <Button element="link" href={buttonHref}>
            {buttonLabel}
          </Button>
        </div>
      )}
    </Section>
  )
}

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import {
    ACCENT,
    FRAME_BOUNDS,
    grip,
    knobGlyphs,
    RAMP,
    settingAt,
    STEP,
    STILL,
  } from "@/utils/dial-scene.ts";
  import { HOLE, wheel, wheelGlyphs, hubGlyphs } from "@/utils/gear-scene.ts";
  import { onPage } from "@/utils/lifecycle.ts";

  const START = "top 75%";
  /* Where ScrollReveal starts fading the drawing in. */
  const REVEAL = "top 90%";

  /* A drawing sits on a layer of its own only while it fades in or builds,
     so those frames don't repaint all of it; the layer goes once it is
     still. ScrollReveal clears the drawing's opacity when its fade ends. */
  function layered(visual: HTMLElement) {
    let holds = 0;
    const hold = () => {
      if (holds++ === 0) visual.style.willChange = "opacity";
    };
    const release = () => {
      if (holds > 0 && --holds === 0) visual.style.willChange = "";
    };
    const faded = () => {
      if (visual.style.opacity !== "") return;
      gsap.ticker.remove(faded);
      release();
    };
    ScrollTrigger.create({
      trigger: visual,
      start: REVEAL,
      once: true,
      onEnter: () => {
        hold();
        gsap.ticker.add(faded);
      },
    });
    return {
      hold,
      release,
      stop() {
        gsap.ticker.remove(faded);
        holds = 0;
        visual.style.willChange = "";
      },
    };
  }

  type Layer = ReturnType<typeof layered>;

  type Box = { left: number; top: number; right: number; bottom: number };

  /* Glyphs coming together out of the digital world, the Services cards'
     dissolve in reverse: each appears in the accent somewhere in `box` and
     flies to its cell, setting off at its own moment within `spread`
     seconds and taking `flight`, greying (or keeping its own colour) as it
     lands. `shift` is where the glyphs' layer sits meanwhile, down the
     screen from its own place (negative for up). */
  function assemble(
    timeline: gsap.core.Timeline,
    glyphs: SVGTextElement[],
    {
      box,
      spread,
      flight,
      shift = 0,
      at = 0,
    }: {
      box: Box;
      spread: number;
      flight: number;
      shift?: number;
      at?: number;
    },
  ) {
    const grey =
      glyphs[0]?.parentElement?.getAttribute("fill") ?? "currentColor";
    const ends = glyphs.map((glyph) => glyph.getAttribute("fill") ?? grey);
    const starts = glyphs.map((glyph) => ({
      x:
        gsap.utils.random(box.left, box.right) -
        Number(glyph.getAttribute("x")),
      y:
        gsap.utils.random(box.top, box.bottom) -
        Number(glyph.getAttribute("y")) -
        shift,
    }));
    const delays = glyphs.map(() => Math.random() * spread);
    timeline
      .fromTo(
        glyphs,
        { x: (i) => starts[i].x, y: (i) => starts[i].y },
        {
          x: 0,
          y: 0,
          duration: flight,
          ease: "power2.inOut",
          stagger: (i) => delays[i],
        },
        at,
      )
      .fromTo(
        glyphs,
        { opacity: 0 },
        {
          opacity: 1,
          duration: flight * 0.4,
          ease: "power1.out",
          stagger: (i) => delays[i],
        },
        at,
      )
      .fromTo(
        glyphs,
        { attr: { fill: ACCENT } },
        {
          attr: { fill: (i: number) => ends[i] },
          duration: flight * 0.7,
          ease: "power1.in",
          stagger: (i) => delays[i],
        },
        at + flight * 0.3,
      );
    return spread + flight;
  }

  /* Glyphs flicker to their neighbours on the ramp, so the shape they make
     holds while they do. */
  function flickering(glyphs: SVGTextElement[]) {
    const shades = glyphs.map((glyph) => RAMP.indexOf(glyph.textContent ?? ""));
    return () => {
      for (let i = 0; i < Math.ceil(glyphs.length / 20); i++) {
        const index = Math.floor(Math.random() * glyphs.length);
        const shade = shades[index] + Math.round(Math.random() * 2 - 1);
        glyphs[index].textContent =
          RAMP[Math.min(RAMP.length - 1, Math.max(1, shade))];
      }
    };
  }

  /* The knob can't settle: it turns on two settings, back one, on
     again, and ends where it began, so the loop runs on without a seam. Every
     turn lands on a different setting from the one it left, and none
     overshoots, so the pointer never swings back to where it just was. Each
     setting lights while the pointer rests on it. Only plays while the
     drawing is on screen, once the intro has played. */
  const TURNS: [to: number, duration: number, ease: string, rest: number][] = [
    [STILL + 2, 0.55, "power3.inOut", 0.7],
    [STILL + 1, 0.35, "power2.out", 0.9],
    [STILL + 4, 0.65, "power3.inOut", 0.8],
    [STILL + 3, 0.45, "power2.inOut", 0.8],
    [STILL + 6, 0.7, "power3.inOut", 0.6],
    [STILL + 5, 0.4, "power2.out", 0.7],
    [STILL + 8, 0.9, "power3.inOut", 0],
  ];
  /* How long the knob rests on its first setting each time round. */
  const FIRST_REST = 0.9;

  function dial(visual: Element, layer: Layer) {
    const knob = visual.querySelector<SVGGElement>('[data-part="grip"]');
    const glow = visual.querySelector<SVGCircleElement>(".dial-glow");
    const frames = [
      ...visual.querySelectorAll<SVGCircleElement>("[data-setting]"),
    ];
    const symbols = [
      ...visual.querySelectorAll<SVGPathElement>("[data-symbol]"),
    ];
    const body = visual.querySelector<SVGGElement>(".dial-knob");
    const settings = [...visual.querySelectorAll<SVGGElement>(".dial-setting")];
    const holder = knob?.parentElement;
    if (!knob || !glow || !body || !holder || frames.length === 0) return;
    const still = knob.innerHTML;
    const line =
      frames
        .find((frame) => frame.getAttribute("stroke") !== ACCENT)
        ?.getAttribute("stroke") ?? "currentColor";
    const ink =
      symbols
        .find((symbol) => symbol.getAttribute("fill") !== ACCENT)
        ?.getAttribute("fill") ?? "currentColor";

    /* The setting the pointer rests on turns to the accent, frame and
       symbol, and glows. */
    let lit = STILL;
    const light = (index: number) => {
      if (index === lit) return;
      frames[lit]?.setAttribute("stroke", line);
      symbols[lit]?.setAttribute("fill", ink);
      lit = index;
      const frame = frames[index];
      symbols[index]?.setAttribute("fill", ACCENT);
      if (frame) {
        frame.setAttribute("stroke", ACCENT);
        glow.setAttribute("cx", frame.getAttribute("cx") ?? "0");
        glow.setAttribute("cy", frame.getAttribute("cy") ?? "0");
      }
      glow.setAttribute("opacity", frame ? "0.5" : "0");
    };

    const at = { angle: STILL * STEP };
    const draw = () => {
      knob.innerHTML = grip(at.angle);
      light(settingAt(at.angle));
    };
    const timeline = gsap.timeline({ repeat: -1, paused: true });
    let time = FIRST_REST;
    for (const [to, duration, ease, rest] of TURNS) {
      timeline.to(
        at,
        { angle: to * STEP, duration, ease, onUpdate: draw },
        time,
      );
      time += duration + rest;
    }

    /* The intro, the Services cards' dissolve in reverse: glyphs appear
       green all over the frame and fly in, greying as they land, to make
       the knob in glyphs; it flickers, then dissolves away as the drawn
       knob fades in underneath; the settings fade in round it right after,
       from the top, clockwise. The knob starts turning once they're in. */
    const wrapper = document.createElementNS("http://www.w3.org/2000/svg", "g");
    wrapper.innerHTML = knobGlyphs(STILL * STEP);
    const glyphLayer = wrapper.firstElementChild;
    if (!glyphLayer) return;
    holder.appendChild(glyphLayer);
    const glyphs = [...glyphLayer.children] as SVGTextElement[];
    const vector = [body, knob, glow, ...settings];
    gsap.set(vector, { opacity: 0 });

    const flicker = flickering(glyphs);
    /* The fly-in runs half as slow again as the rest of the intro. */
    const SPREAD = 0.9;
    const FLIGHT = 1.65;
    const LANDED = SPREAD + FLIGHT;

    let ready = false;
    let visible = false;
    const intro = gsap
      .timeline({
        paused: true,
        onStart: layer.hold,
        onComplete: () => {
          layer.release();
          glyphLayer.remove();
          gsap.set(vector, { clearProps: "opacity" });
          ready = true;
          /* Half the usual first rest, so the knob gets going soon after. */
          timeline.seek(FIRST_REST / 2);
          if (visible) timeline.play();
        },
      })
      .to({}, { duration: LANDED + 0.3, onUpdate: flicker }, 0)
      .to(
        [body, knob],
        { opacity: 1, duration: 0.6, ease: "power1.out" },
        LANDED + 0.1,
      )
      .to(
        glyphs,
        {
          opacity: 0,
          duration: 0.12,
          stagger: { amount: 0.6, from: "random" },
        },
        LANDED + 0.1,
      )
      .to(
        settings,
        { opacity: 1, duration: 0.45, ease: "power1.out", stagger: 0.07 },
        LANDED + 0.65,
      )
      .to(glow, { opacity: 0.5, duration: 0.45 }, LANDED + 0.65 + STILL * 0.07)
      /* Twice as fast as the timings above. */
      .timeScale(2);
    assemble(intro, glyphs, {
      box: FRAME_BOUNDS,
      spread: SPREAD,
      flight: FLIGHT,
    });

    const trigger = ScrollTrigger.create({
      trigger: visual,
      start: START,
      once: true,
      onEnter: () => intro.play(),
    });

    const observer = new IntersectionObserver((entries) => {
      const now = entries[entries.length - 1].isIntersecting;
      if (now === visible) return;
      visible = now;
      if (visible) {
        layer.hold();
        if (ready) timeline.play();
      } else {
        layer.release();
        timeline.pause();
      }
    });
    observer.observe(visual);

    return () => {
      observer.disconnect();
      trigger.kill();
      intro.kill();
      timeline.kill();
      if (visible) layer.release();
      glyphLayer.remove();
      gsap.set(vector, { clearProps: "opacity" });
      knob.innerHTML = still;
      light(STILL);
    };
  }

  /* Problem 2's story. The gear's two parts come together out of glyphs
     high up, the hub above the wheel, already falling as they do; the hub
     falls faster, meets the wheel on the way and they land together. The
     hole through them turns green, the light flicks on and the wheel starts
     turning, for good. The two people pop up where they stand, with a slight
     bounce, as it lands; once they are up they take turns asking,
     left first, for good. */
  const GEAR = {
    /* How high each part starts above where it lands. */
    wheelAir: 90,
    hubAir: 200,
    /* The glyph fly-in, quick enough to be done before the parts land. */
    spread: 0.3,
    flight: 0.6,
    /* The parts fall from the first moment, while their glyphs are still
       coming together, and land in one smooth move. */
    fall: 1.2,
    /* Share of the fall by which the hub has caught the wheel: it closes
       the gap slowly at first and quickly at the end, so the two read as
       separate parts until late in the fall. */
    join: 0.9,
    /* When the people pop up where they stand (as the gear lands, once
       it is clear of them), the right one a moment after the left, and how
       long the pop takes. */
    popAt: 1.25,
    popGap: 0.12,
    pop: 0.6,
    /* One full turn of the wheel, in seconds. */
    turn: 30,
    /* Each line shows this long, a new one every `say` seconds. */
    hold: 2.2,
    say: 2.7,
  };
  function gearTeam(visual: Element, layer: Layer) {
    const spin = visual.querySelector<SVGGElement>('[data-part="spin"]');
    const wheelPart = visual.querySelector<SVGGElement>('[data-part="wheel"]');
    const hubPart = visual.querySelector<SVGGElement>('[data-part="hub"]');
    const hubBody = visual.querySelector<SVGGElement>('[data-part="hub-body"]');
    const light = visual.querySelector<SVGRectElement>(".gear-glow");
    const hole = visual.querySelector<SVGEllipseElement>(".gear-hole");
    const left = visual.querySelector<SVGGElement>('[data-part="person-left"]');
    const right = visual.querySelector<SVGGElement>(
      '[data-part="person-right"]',
    );
    const talk = visual.querySelector<HTMLElement>(".problems-main_bubbles");
    const bubbles = [
      ...visual.querySelectorAll<HTMLElement>(".problems-main_bubble"),
    ];
    if (
      !spin ||
      !wheelPart ||
      !hubPart ||
      !hubBody ||
      !light ||
      !hole ||
      !left ||
      !right ||
      !talk ||
      bubbles.length < 2
    )
      return;
    const still = spin.innerHTML;
    const lines = JSON.parse(talk.dataset.said ?? "[]") as string[];
    const words = bubbles.map((bubble) =>
      bubble.querySelector<HTMLElement>(".problems-main_bubble_text")!,
    );
    const said = words.map((word) => word.textContent ?? "");

    /* The two parts in glyphs, inside the parts so they fall with them. */
    const layerOf = (markup: string, part: SVGGElement) => {
      const wrapper = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "g",
      );
      wrapper.innerHTML = markup;
      const glyphs = wrapper.firstElementChild as SVGGElement;
      part.appendChild(glyphs);
      return glyphs;
    };
    const wheelLayer = layerOf(wheelGlyphs(), wheelPart);
    const hubLayer = layerOf(hubGlyphs(), hubPart);
    const wheelGlyphsAll = [...wheelLayer.children] as SVGTextElement[];
    const hubGlyphsAll = [...hubLayer.children] as SVGTextElement[];
    const glyphs = [...wheelGlyphsAll, ...hubGlyphsAll];
    const flicker = flickering(glyphs);

    /* Everything starts out of sight: the drawn parts hidden in the air,
       the light off, the people out past the top corners, nothing said. */
    const solid = [spin, hubBody];
    gsap.set(solid, { opacity: 0 });
    gsap.set(wheelPart, { y: -GEAR.wheelAir });
    gsap.set(hubPart, { y: -GEAR.hubAir });
    const lit = hole.getAttribute("fill") ?? "";
    hole.setAttribute("fill", HOLE);
    gsap.set(light, { opacity: 0 });
    gsap.set([left, right], {
      scale: 0,
      opacity: 0,
      transformOrigin: "50% 100%",
    });
    gsap.set(bubbles, { autoAlpha: 0 });

    /* The wheel turns about 30 times a second, only while on screen. */
    let angle = 0;
    let turning = false;
    let visible = false;
    let last = 0;
    let clock = 0;
    const tick = (_: number, delta: number) => {
      if (!turning || !visible) return;
      clock += Math.min(delta, 100) / 1000;
      if (clock - last < 1 / 30 - 0.004) return;
      angle += ((clock - last) * Math.PI * 2) / GEAR.turn;
      last = clock;
      spin.innerHTML = wheel(angle);
    };
    gsap.ticker.add(tick);

    /* Who says what, in turn, for good. */
    const talking = gsap.timeline({ repeat: -1, paused: true });
    lines.forEach((line, index) => {
      const side = index % 2;
      const bubble = bubbles[side];
      const word = words[side];
      const at = index * GEAR.say;
      talking
        .call(() => (word.textContent = line), [], at)
        .to(bubble, { autoAlpha: 1, duration: 0.4, ease: "power1.out" }, at)
        .to(
          bubble,
          { autoAlpha: 0, duration: 0.35, ease: "power1.in" },
          at + GEAR.hold,
        );
    });
    talking.to({}, { duration: 0 }, lines.length * GEAR.say);

    let talks = false;
    const fall = { p: 0 };
    const wheelEase = gsap.parseEase("sine.inOut");
    const joinEase = gsap.parseEase("power2.in");
    const intro = gsap.timeline({ paused: true, onStart: layer.hold });
    const landed = assemble(intro, wheelGlyphsAll, {
      box: { left: 0, top: 0, right: 568, bottom: 500 },
      spread: GEAR.spread,
      flight: GEAR.flight,
      shift: -GEAR.wheelAir,
    });
    assemble(intro, hubGlyphsAll, {
      box: { left: 0, top: 0, right: 568, bottom: 500 },
      spread: GEAR.spread,
      flight: GEAR.flight,
      shift: -GEAR.hubAir,
    });
    intro
      .to({}, { duration: landed + 0.15, onUpdate: flicker }, 0)
      .to(
        solid,
        { opacity: 1, duration: 0.3, ease: "power1.out" },
        landed + 0.05,
      )
      .to(
        glyphs,
        {
          opacity: 0,
          duration: 0.08,
          stagger: { amount: 0.3, from: "random" },
        },
        landed + 0.05,
      )
      .to(
        fall,
        {
          p: 1,
          duration: GEAR.fall,
          ease: "none",
          onUpdate: () => {
            const wheelY = -GEAR.wheelAir * (1 - wheelEase(fall.p));
            const gap =
              (GEAR.hubAir - GEAR.wheelAir) *
              (1 - joinEase(Math.min(1, fall.p / GEAR.join)));
            gsap.set(wheelPart, { y: wheelY });
            gsap.set(hubPart, { y: wheelY - gap });
          },
        },
        0,
      )
      /* Home: the hole turns green and the light comes on at once, with
         one flicker, and the wheel starts to turn. */
      .call(
        () => {
          turning = true;
        },
        [],
        GEAR.fall,
      )
      .to(hole, { attr: { fill: lit }, duration: 0.1, ease: "none" }, GEAR.fall)
      .to(
        light,
        {
          keyframes: { opacity: [0, 1, 0.3, 1] },
          duration: 0.35,
          ease: "none",
        },
        GEAR.fall,
      );
    /* The people pop up where they stand, from their feet, with a slight
       bounce. */
    [left, right].forEach((person, index) => {
      const at = GEAR.popAt + index * GEAR.popGap;
      intro
        .to(person, { opacity: 1, duration: 0.15, ease: "power1.out" }, at)
        .to(
          person,
          { scale: 1, duration: GEAR.pop, ease: "back.out(2.2)" },
          at,
        );
    });
    intro.call(
      () => {
        layer.release();
        wheelLayer.remove();
        hubLayer.remove();
        talks = true;
        if (visible) talking.play();
      },
      [],
      Math.max(GEAR.fall + 0.35, GEAR.popAt + GEAR.popGap + GEAR.pop) + 0.3,
    );

    const trigger = ScrollTrigger.create({
      trigger: visual,
      start: START,
      once: true,
      onEnter: () => intro.play(),
    });
    const observer = new IntersectionObserver((entries) => {
      const now = entries[entries.length - 1].isIntersecting;
      if (now === visible) return;
      visible = now;
      if (visible) {
        layer.hold();
        if (talks) talking.play();
      } else {
        layer.release();
        talking.pause();
      }
    });
    observer.observe(visual);

    return () => {
      observer.disconnect();
      trigger.kill();
      intro.kill();
      talking.kill();
      gsap.ticker.remove(tick);
      if (visible) layer.release();
      wheelLayer.remove();
      hubLayer.remove();
      spin.innerHTML = still;
      hole.setAttribute("fill", lit);
      /* Only what the script set: the bubbles keep their place, which the
         page writes on them. */
      gsap.set([...solid, light, left, right], { clearProps: "opacity" });
      gsap.set([wheelPart, hubPart, left, right], { clearProps: "transform" });
      gsap.set(bubbles, { clearProps: "opacity,visibility" });
      words.forEach((word, index) => (word.textContent = said[index]));
    };
  }

  /* The headlamp flickers on and throws its beam forward. */
  function lamp(visual: Element, layer: Layer) {
    const beam = visual.querySelector('[data-part="beam"]');
    if (!beam) return;
    gsap
      .timeline({
        delay: 0.3,
        scrollTrigger: { trigger: visual, start: START, once: true },
        onStart: layer.hold,
        onComplete: layer.release,
      })
      .fromTo(
        beam,
        { opacity: 0, scaleX: 0.15, transformOrigin: "100% 50%" },
        {
          keyframes: { opacity: [0, 1, 0.25, 1, 0.5, 1] },
          duration: 0.5,
          ease: "none",
          immediateRender: true,
        },
      )
      .to(beam, { scaleX: 1, duration: 1 }, 0.2);
  }

  const setUps: ((visual: Element, layer: Layer) => (() => void) | void)[] = [
    dial,
    gearTeam,
    lamp,
  ];

  onPage(() => {
    const sections = document.querySelectorAll(".problems-main_wrap");
    if (sections.length === 0) return;
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      if (document.documentElement.classList.contains("stacki-designer"))
        return;
      const stops: (() => void)[] = [];
      sections.forEach((section) =>
        section
          .querySelectorAll<HTMLElement>(".problems-main_visual")
          .forEach((visual, index) => {
            const layer = layered(visual);
            stops.push(layer.stop);
            const stop = setUps[index]?.(visual, layer);
            if (stop) stops.push(stop);
          }),
      );
      return () => stops.forEach((stop) => stop());
    });
    return () => mm.revert();
  });
</script>

