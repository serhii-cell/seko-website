---
import type { HTMLAttributes } from "astro/types";
import Corner from "@/assets/ascii/corner.svg";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <div
      class:list={["ascii-stage_wrap", className]}
      aria-hidden="true"
      {...rest}
    >
      <div class="ascii-stage_lines" />
      <div class="ascii-stage_visual">
        <canvas class="ascii-stage_cubes" />
      </div>
      <Corner class="ascii-stage_corner top-left" />
      <Corner class="ascii-stage_corner top-right" />
      <Corner class="ascii-stage_corner bottom-left" />
      <Corner class="ascii-stage_corner bottom-right" />
    </div>
  )
}

<script>
  import { gsap } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";
  import { onIntroOpen } from "@/utils/intro.ts";
  import {
    GLYPH,
    smoothstep,
    mix,
    toRgb,
    readLook,
    allowsMotion,
    glyphForSize,
    pageGlyph,
    measureRamp,
    pickGlyph,
    createController,
    createTorch,
    rotation,
    sway,
    LIGHT,
    HALF,
    KEY,
    type Rgb,
    type Controller,
    type Look,
  } from "@/utils/ascii.ts";

  /* Still frames for reduced motion: the eight cubes joined into one. */
  const STILL_TIME = 4300;

  type Cubes = {
    /** Shows the cubes after `delay` seconds, flickering on like an old
        screen, and starts their loop. */
    reveal: (delay: number) => void;
    destroy: () => void;
  };

  /* ---------- Cubes: eight cubes slide together, merge, and zoom out to one ---------- */
  function createCubes(
    canvas: HTMLCanvasElement,
    stage: HTMLElement,
    controller: Controller,
    look: Look,
    motion: boolean,
  ): Cubes {
    const context = canvas.getContext("2d");
    if (!context) return { reveal() {}, destroy() {} };

    const green = toRgb(look.accent);
    const HIGHLIGHT: Rgb = [255, 255, 250];
    /* Camera distance, for a real perspective, and the loop length in seconds. */
    const CAM = 9;
    const LOOP = 5.5;
    const SLOTS = [
      [-0.5, -0.5, 0.5],
      [0.5, -0.5, 0.5],
      [-0.5, -0.5, -0.5],
      [0.5, -0.5, -0.5],
      [-0.5, 0.5, 0.5],
      [0.5, 0.5, 0.5],
      [-0.5, 0.5, -0.5],
      [0.5, 0.5, -0.5],
    ];
    const first = SLOTS[0];

    let width = 674;
    let height = 442;
    let cw = 8;
    let ch = 14;
    let cols = 0;
    let rows = 0;
    let ox = 0;
    let oy = 0;
    let font = "";
    let scale = 0;
    let cx = 0;
    let cy = 0;
    let dpr = 1;

    let ramp: string[] = [];
    let coverage: number[] = [];

    let seam = new Uint8Array(0);
    let brightness = new Float32Array(0);
    let specular = new Float32Array(0);
    let depth = new Float32Array(0);
    let hit = new Uint8Array(0);
    let alpha = new Float32Array(0);
    let slot = new Int8Array(0);

    let R = [1, 0, 0, 0, 1, 0, 0, 0, 1];
    function sdBox(
      px: number,
      py: number,
      pz: number,
      bx: number,
      by: number,
      bz: number,
      h: number,
      r: number,
    ) {
      const qx = Math.abs(px - bx) - h;
      const qy = Math.abs(py - by) - h;
      const qz = Math.abs(pz - bz) - h;
      const ax = Math.max(qx, 0);
      const ay = Math.max(qy, 0);
      const az = Math.max(qz, 0);
      return (
        Math.sqrt(ax * ax + ay * ay + az * az) +
        Math.min(Math.max(qx, Math.max(qy, qz)), 0) -
        r
      );
    }

    let zoom = 1;
    let offsetX = 0;
    let offsetY = 0;
    let offsetZ = 0;
    let cubes: number[][] = [];
    let hitCube: number[] | null = null;
    function sdf(x: number, y: number, z: number) {
      const wx = R[0] * x + R[3] * y + R[6] * z;
      const wy = R[1] * x + R[4] * y + R[7] * z;
      const wz = R[2] * x + R[5] * y + R[8] * z;
      const nx = (wx - offsetX) / zoom;
      const ny = (wy - offsetY) / zoom;
      const nz = (wz - offsetZ) / zoom;
      let best = 1e9;
      hitCube = null;
      for (const cube of cubes) {
        const d = sdBox(nx, ny, nz, cube[0], cube[1], cube[2], 0.5, 0.02);
        if (d < best) {
          best = d;
          hitCube = cube;
        }
      }
      return best * zoom;
    }

    const [LX, LY, LZ] = LIGHT;
    const [HX, HY, HZ] = HALF;
    const FL = KEY;
    const ss = (u: number) => smoothstep(0, 1, u);

    const torch = createTorch(stage, canvas, motion);

    let seamFill = 0;
    const SEAM_ORDER = (() => {
      const order = new Float32Array(4099);
      let x = 12345;
      for (let i = 0; i < order.length; i++) {
        x = (x * 1103515245 + 12345) >>> 0;
        order[i] = ((x >>> 8) / 16777216) * 0.8;
      }
      return order;
    })();

    /* The 5.5s loop: seven cubes slide in (0.4–3.8s), the seams between them
       fill glyph by glyph (3.8–4.4s), the block shrinks to a single cube
       (4.4–5.5s), and the next cube shows 0.2s later. The view sways a little
       either side of its resting angle, never turning the block away. */
    function scene(time: number) {
      const T = time % LOOP;
      R = rotation(0.66 + sway(time), 0.44);
      const T0 = 0.4,
        STEP = 0.49,
        SLIDE = 0.45,
        FILL_START = 3.8,
        FILL_END = 4.4;
      const ZOOM_START = 4.4,
        ZOOM_END = 5.5;
      cubes = [];
      const zooming = T >= ZOOM_START;
      seamFill = zooming ? 1 : ss((T - FILL_START) / (FILL_END - FILL_START));
      if (!zooming) {
        zoom = 1;
        offsetX = offsetY = offsetZ = 0;
        cubes.push([first[0], first[1], first[2], 1, 0]);
        for (let k = 0; k < 7; k++) {
          const tk = T0 + k * STEP;
          const s = SLOTS[k + 1];
          if (T >= tk + SLIDE) {
            cubes.push([s[0], s[1], s[2], 1, k + 1]);
          } else if (T >= tk - 0.2) {
            const u = ss((T - tk) / SLIDE);
            const x = 1.9 + (s[0] - 1.9) * u;
            const a = Math.min(1, (T - (tk - 0.2)) / 0.2);
            cubes.push([x, s[1], s[2], a, k + 1]);
          }
        }
      } else {
        const uz = ss((T - ZOOM_START) / (ZOOM_END - ZOOM_START));
        zoom = 2 - uz;
        offsetX = -2 * first[0] * (1 - uz);
        offsetY = -2 * first[1] * (1 - uz);
        offsetZ = -2 * first[2] * (1 - uz);
        cubes.push([first[0], first[1], first[2], 1, 0]);
      }

      brightness.fill(0);
      hit.fill(0);
      for (let gy = 0; gy < rows; gy++) {
        for (let gx = 0; gx < cols; gx++) {
          const X = (ox + gx * cw + cw / 2 - cx) / scale;
          const Y = (cy - (oy + gy * ch + ch / 2)) / scale;
          /* A ray from the camera through this cell of the image plane. */
          const rl = Math.sqrt(X * X + Y * Y + CAM * CAM);
          const rx = X / rl;
          const ry = Y / rl;
          const rz = -CAM / rl;
          let t = CAM - 3.4;
          let found = false;
          let px = 0;
          let py = 0;
          let z = 0;
          for (let step = 0; step < 64; step++) {
            px = rx * t;
            py = ry * t;
            z = CAM + rz * t;
            const d = sdf(px, py, z);
            if (d < 0.004) {
              found = true;
              break;
            }
            if (t > CAM + 3.4) break;
            t += Math.max(d * 0.95, 0.006);
          }
          const cube = hitCube as number[] | null;
          if (!found || !cube) continue;
          const i = gy * cols + gx;
          hit[i] = 1;
          depth[i] = z;
          alpha[i] = cube[3];
          slot[i] = cube[4];
          const e = 0.008;
          let nx = sdf(px + e, py, z) - sdf(px - e, py, z);
          let ny = sdf(px, py + e, z) - sdf(px, py - e, z);
          let nz = sdf(px, py, z + e) - sdf(px, py, z - e);
          const nl = Math.sqrt(nx * nx + ny * ny + nz * nz) || 1;
          nx /= nl;
          ny /= nl;
          nz /= nl;
          const diffuse = Math.max(0, nx * LX + ny * LY + nz * LZ);
          const spec = Math.pow(Math.max(0, nx * HX + ny * HY + nz * HZ), 16);
          /* Face tone from the normal in cube space, so all six faces read as
             different values from any camera angle. */
          const wnx = R[0] * nx + R[3] * ny + R[6] * nz;
          const wny = R[1] * nx + R[4] * ny + R[7] * nz;
          const wnz = R[2] * nx + R[5] * ny + R[8] * nz;
          const tone = 0.5 + 0.5 * (wnx * FL[0] + wny * FL[1] + wnz * FL[2]);
          brightness[i] =
            Math.min(1, 0.1 + 0.62 * tone + 0.18 * diffuse + 0.3 * spec) *
            cube[3];
          specular[i] = spec;
        }
      }

      const total = cols * rows;
      for (let i = 0; i < total; i++) {
        if (!hit[i] || alpha[i] < 0.9) continue;
        for (const j of [i - 1, i + 1, i - cols, i + cols]) {
          if (j < 0 || j >= total) continue;
          if (!hit[j] || Math.abs(depth[j] - depth[i]) > 0.12) {
            brightness[i] = Math.max(brightness[i], 0.5);
            break;
          }
        }
      }

      /* A cell whose right or lower neighbour shows a different cube is left
         empty, a one-glyph line between cubes until they merge. */
      seam.fill(0);
      if (cubes.length > 1) {
        for (let gy = 0; gy < rows; gy++) {
          for (let gx = 0; gx < cols; gx++) {
            const i = gy * cols + gx;
            if (!hit[i]) continue;
            if (
              (gx < cols - 1 && hit[i + 1] && slot[i + 1] !== slot[i]) ||
              (gy < rows - 1 && hit[i + cols] && slot[i + cols] !== slot[i])
            ) {
              seam[i] = 1;
            }
          }
        }
      }
    }

    function draw() {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      context.font = font;
      context.textBaseline = "top";
      const lit = torch.lit();
      for (let gy = 0; gy < rows; gy++) {
        for (let gx = 0; gx < cols; gx++) {
          const i = gy * cols + gx;
          let b: number;
          let color: Rgb;
          if (seam[i]) {
            const threshold = SEAM_ORDER[i % SEAM_ORDER.length];
            if (seamFill <= threshold) continue;
            b = brightness[i] * Math.min(1, (seamFill - threshold) * 4);
            if (b <= 0.003) continue;
            color = green;
          } else {
            b = brightness[i];
            if (b <= 0.003) continue;
            color = green;
            if (specular[i] > 0.3)
              color = mix(
                color,
                HIGHLIGHT,
                Math.min(1, (specular[i] - 0.3) * 1.3) * 0.7,
              );
          }
          let boost = 0;
          if (lit) {
            ({ b, color, boost } = torch.light(
              ox + gx * cw + cw / 2,
              oy + gy * ch + ch / 2,
              b,
              color,
            ));
          }
          const lum = Math.min(1.25, 0.55 + 0.45 * b + boost);
          const glyphChar = pickGlyph(ramp, coverage, b, gx, gy);
          if (glyphChar === " ") continue;
          context.fillStyle = `rgb(${Math.min(255, color[0] * lum) | 0},${Math.min(255, color[1] * lum) | 0},${Math.min(255, color[2] * lum) | 0})`;
          context.fillText(glyphChar, ox + gx * cw, oy + gy * ch);
        }
      }
    }

    /* Sized to the container's real size on screen, so glyphs are true
       pixels, with the glyph size every model on the page shares. The canvas
       fills the whole container, so cubes sliding in from the right have
       room; scaled to the height, everything in the loop stays in view at
       any sway (it reaches 2.75 units right, 1.5 left, 1.66 up or down). */
    function configure(w: number, h: number) {
      width = Math.max(160, Math.round(w));
      height = Math.max(120, Math.round(h));
      const g = glyphForSize(Math.min(width, height));
      cw = g * GLYPH.cellW;
      ch = g * GLYPH.cellH;
      cols = Math.floor(width / cw);
      rows = Math.floor(height / ch);
      ox = (width - cols * cw) / 2;
      oy = (height - rows * ch) / 2;
      font = `${g}px ${look.font}`;
      const n = cols * rows;
      seam = new Uint8Array(n);
      brightness = new Float32Array(n);
      specular = new Float32Array(n);
      depth = new Float32Array(n);
      hit = new Uint8Array(n);
      alpha = new Float32Array(n);
      slot = new Int8Array(n);
      scale = Math.min(0.21 * height, (width / 2 - 12) / 2.75);
      cx = width / 2;
      cy = height / 2 + 2;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
      ({ ramp, coverage } = measureRamp(font, cw, ch));
      pageGlyph.set(g);
    }
    let measured = { w: 0, h: 0 };
    function watchSize() {
      const rect = canvas.getBoundingClientRect();
      if (
        Math.abs(rect.width - measured.w) < 1 &&
        Math.abs(rect.height - measured.h) < 1
      )
        return;
      measured = { w: rect.width, h: rect.height };
      configure(rect.width, rect.height);
    }

    /* Its own clock: after a pause the cubes carry on from the same moment.
       It holds at the start until the cubes are revealed. */
    let revealed = false;
    let frame = 0;
    let simTime = motion ? 0 : STILL_TIME;
    let clock = 0;
    let lastNow = 0;
    let lastStep = -1e9;
    function loop(now: number) {
      frame = requestAnimationFrame(loop);
      const delta = Math.min(100, now - lastNow);
      lastNow = now;
      clock += delta;
      if (revealed) simTime += delta;
      if (clock - lastStep < 33) return;
      const dt = Math.min(0.1, (clock - lastStep) / 1000);
      lastStep = clock;
      torch.step(dt);
      scene(simTime / 1000);
      draw();
    }
    function play() {
      if (!motion || frame || !controller.running()) return;
      lastNow = performance.now();
      frame = requestAnimationFrame(loop);
    }
    function pause() {
      cancelAnimationFrame(frame);
      frame = 0;
    }
    function still() {
      if (frame) return;
      scene(simTime / 1000);
      draw();
    }

    canvas.style.opacity = "0";
    watchSize();
    const observer = new ResizeObserver(() => {
      watchSize();
      still();
    });
    observer.observe(canvas);
    still();
    controller.onChange((running) => (running ? play() : pause()));
    play();

    let flicker: gsap.core.Timeline | undefined;
    return {
      reveal(delay) {
        if (!motion) {
          revealed = true;
          canvas.style.opacity = "1";
          return;
        }
        flicker = gsap
          .timeline({ delay, onStart: () => (revealed = true) })
          .set(canvas, { opacity: 1 })
          .set(canvas, { opacity: 0.12 }, 0.07)
          .set(canvas, { opacity: 1 }, 0.12)
          .set(canvas, { opacity: 0.35 }, 0.22)
          .set(canvas, { opacity: 1 }, 0.27);
      },
      destroy() {
        flicker?.kill();
        pause();
        observer.disconnect();
        torch.destroy();
      },
    };
  }

  /* The container opens from its centre like a window, from 1px and
     transparent to full size, as the first-load curtain is half up (or at
     once without it). Then the CRT lines start drifting and, half a second
     later, the cubes flicker on. */
  const OPEN = 0.7;
  const AFTER_OPEN = 0.5;

  const started = new WeakMap<HTMLElement, () => void>();

  function start(stage: HTMLElement) {
    const canvas = stage.querySelector<HTMLCanvasElement>(".ascii-stage_cubes");
    if (!canvas) return () => {};

    const look = readLook(stage);
    const motion = allowsMotion();
    const controller = createController(stage);
    let cubes: Cubes | null = null;
    let revealAt: number | null = null;
    let stopped = false;
    let opening: gsap.core.Tween | undefined;

    const reveal = (delay: number) => {
      if (cubes) cubes.reveal(delay);
      else revealAt = delay;
    };

    const open = () => {
      if (!motion) {
        stage.classList.add("open");
        reveal(0);
        return;
      }
      const { width, height } = stage.getBoundingClientRect();
      opening = gsap.fromTo(
        stage,
        { scaleX: 1 / width, scaleY: 1 / height, opacity: 0 },
        {
          scaleX: 1,
          scaleY: 1,
          opacity: 1,
          duration: OPEN,
          ease: "expo.out",
          clearProps: "transform,opacity",
          onComplete: () => {
            stage.classList.add("open");
            reveal(AFTER_OPEN);
          },
        },
      );
    };

    if (motion) gsap.set(stage, { opacity: 0 });
    const stopWaiting = motion ? onIntroOpen(open) : (open(), () => {});

    document.fonts
      .load(`12px ${look.font}`)
      .catch(() => {})
      .then(() => {
        if (stopped) return;
        cubes = createCubes(canvas, stage, controller, look, motion);
        if (revealAt !== null) cubes.reveal(revealAt);
      });

    return () => {
      stopped = true;
      stopWaiting();
      opening?.kill();
      cubes?.destroy();
      controller.destroy();
    };
  }

  onPage(() => {
    const stages = [
      ...document.querySelectorAll<HTMLElement>(".ascii-stage_wrap"),
    ].filter((stage) => !started.has(stage));
    for (const stage of stages) started.set(stage, start(stage));

    return () => {
      for (const stage of stages) {
        started.get(stage)?.();
        started.delete(stage);
      }
    };
  });
</script>

<style is:global>
  @layer components {
    .ascii-stage_wrap {
      --_glyph: var(--dark-700);
      --_accent: var(--brand-500);
      --_glyph-font: var(--font-jetbrains-mono, monospace);
      --_line: color-mix(in lab, var(--light-100) 2%, transparent);
      position: relative;
      display: grid;
      place-items: center;
      width: 100%;
      aspect-ratio: 674 / 442;
      min-height: 15rem;
      isolation: isolate;
      container-type: size;
      background-color: var(--background-2);
      border: var(--border-width) solid var(--stroke);
    }

    /* CRT lines: 1px every 8px, drifting down once the container is open. */
    .ascii-stage_lines {
      position: absolute;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      background: repeating-linear-gradient(
        to bottom,
        var(--_line) 0 1px,
        transparent 1px 0.5rem
      );
      .ascii-stage_wrap.open & {
        animation: ascii-stage-lines 1.15s linear infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        animation: none !important;
      }
    }

    @keyframes ascii-stage-lines {
      to {
        background-position: 0 0.5rem;
      }
    }

    .ascii-stage_visual {
      width: 100%;
      height: 100%;
    }

    .ascii-stage_cubes {
      display: block;
      width: 100%;
      height: 100%;
    }

    .ascii-stage_corner {
      position: absolute;
      color: var(--light-100);
      &.top-left {
        top: -0.03125rem;
        left: -0.03125rem;
      }
      &.top-right {
        top: -0.03125rem;
        right: -0.03125rem;
        scale: -1 1;
      }
      &.bottom-left {
        bottom: -0.03125rem;
        left: -0.03125rem;
        scale: 1 -1;
      }
      &.bottom-right {
        right: -0.03125rem;
        bottom: -0.03125rem;
        scale: -1 -1;
      }
    }
  }
</style>
