<style is:global>
  @layer components {
    .work-scene_wrap {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: clip;
      background-color: var(--background-2);
      container-type: inline-size;
    }

    .work-scene_wrap > .image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .work-scene_imac,
    .work-scene_phone {
      position: absolute;
      display: block;
      height: auto;
      overflow: visible;
    }

    .work-scene_imac {
      left: calc(262.08 / 1249 * 100%);
      top: calc(72.92 / 725 * 100%);
      width: calc(684.06 / 1249 * 100%);
    }

    .work-scene_phone {
      left: calc(859.63 / 1249 * 100%);
      top: calc(272.94 / 725 * 100%);
      width: calc(181.37 / 1249 * 100%);
    }
  }
</style>
