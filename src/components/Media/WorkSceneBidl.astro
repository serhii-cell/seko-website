---
import type { HTMLAttributes } from "astro/types";
import Img from "@/components/Media/Img.astro";
import mountains from "@/assets/home/works/work-bidl-bg-mountains-clean.jpg";
import ridges from "@/assets/home/works/work-bidl-front-ridges.png";
import mountainGlyphs from "@/assets/home/works/work-bidl-bg-mountains-glyphs.png?url";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Describes the scene for screen readers. Leave unset when it is decorative. */
  alt?: string;
}

const { render = true, alt, class: className, ...rest } = Astro.props;

const sizes = "(min-width: 64rem) 65vw, 90vw";

const rows = [0, 28.5, 57, 86, 115, 144, 172];
const cards = [
  { y: 120, status: "In Progress", tone: "#e7ab53", name: "Wade Warren", amount: "$3,744.00", paid: "30%" },
  { y: 189, status: "Paid", tone: "#7ad08d", name: "Esther Howard", amount: "$1,285.00", paid: "100%" },
  { y: 277, status: "In Progress", tone: "#e7ab53", name: "Cody Fisher", amount: "$8,420.50", paid: "45%" },
  { y: 347, status: "Overdue", tone: "#ea7272", name: "Jenny Wilson", amount: "$2,016.00", paid: "0%" },
];
---

{
  render && (
    <div
      class:list={["work-scene_wrap", className]}
      role={alt ? "img" : undefined}
      aria-label={alt}
      aria-hidden={alt ? undefined : "true"}
      {...rest}
    >
      <Img class="work-scene_back" src={mountains} variant="constrained" sizes={sizes} />
      {/* The mountains' ASCII, drawn on hover (see Card), behind the devices. */}
      <canvas
        class="card_glyphs work-scene_glyphs"
        aria-hidden="true"
        data-src={mountainGlyphs}
        data-grid="10.0,16.995,9.67,16.29"
      />

      <svg
        class="work-scene_imac"
        viewBox="0 0 684.06 580.55"
        xmlns="http://www.w3.org/2000/svg"
        font-family="Inter, Archivo, Arial, sans-serif"
      >
        <defs>
          <linearGradient id="bidl-imac-rim" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#6b6e76" stop-opacity="0.9" />
            <stop offset="0.5" stop-color="#2c2e33" stop-opacity="0.8" />
            <stop offset="1" stop-color="#17181b" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="bidl-imac-chin" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#26282e" />
            <stop offset="0.5" stop-color="#1d1e23" />
            <stop offset="1" stop-color="#141518" />
          </linearGradient>
          <linearGradient id="bidl-imac-stand" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0e0f12" />
            <stop offset="0.08" stop-color="#2c2e34" />
            <stop offset="0.6" stop-color="#23252a" />
            <stop offset="1" stop-color="#1a1b1f" />
          </linearGradient>
          <linearGradient id="bidl-imac-shade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#000" stop-opacity="0.7" />
            <stop offset="1" stop-color="#000" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="bidl-imac-foot" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#4a4d55" />
            <stop offset="0.5" stop-color="#2a2c32" />
            <stop offset="1" stop-color="#121316" />
          </linearGradient>
          <linearGradient id="bidl-imac-glare" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0.08" />
            <stop offset="0.4" stop-color="#fff" stop-opacity="0.01" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <clipPath id="bidl-imac-display">
            <rect x="18" y="18" width="648.06" height="364.53" rx="1.8" />
          </clipPath>
        </defs>

        <rect x="267.77" y="447.34" width="148.51" height="117.91" fill="url(#bidl-imac-stand)" />
        <rect x="267.77" y="447.34" width="148.51" height="31.5" fill="url(#bidl-imac-shade)" />
        <rect x="216.02" y="563.45" width="252.02" height="9" rx="2.7" fill="url(#bidl-imac-foot)" />

        <rect x="0.56" y="0.56" width="682.94" height="448.92" rx="9.9" fill="#0a0a0c" stroke="url(#bidl-imac-rim)" stroke-width="1.125" />
        <path d="M1.13 382.53h681.81v58.51a9 9 0 0 1-9 9H10.13a9 9 0 0 1-9-9z" fill="url(#bidl-imac-chin)" />
        <rect x="1.13" y="382.53" width="681.81" height="0.68" fill="#3a3c43" />
        <circle cx="342.03" cy="9" r="1.8" fill="#1a1c22" />

        <g clip-path="url(#bidl-imac-display)">
          <rect x="18" y="18" width="648.06" height="364.53" fill="#000" />
          <g transform="translate(18 18)">
            <rect width="648" height="450" fill="#0d0e14" />
            <rect width="153" height="450" fill="#111219" />
            <rect x="153" width="495" height="40" fill="#15161f" />

            <rect x="13" y="18" width="14" height="14" rx="3.6" fill="#5d60f4" />
            <text x="17" y="28.5" font-size="7.7" font-weight="700" fill="#fff">b</text>
            <text x="31" y="29" font-size="10.8" font-weight="700" fill="#f5f6fa">BIDL</text>

            <rect x="11" y="56" width="131" height="22" rx="4" fill="#1d1e3d" />
            <rect x="17" y="63" width="7" height="7" rx="1.5" fill="#5d60f4" />
            <text x="31" y="69.5" font-size="6.6" fill="#5d60f4">Dashboard</text>
            <circle cx="20.5" cy="90" r="2.6" fill="none" stroke="#a3a9b8" stroke-width="0.8" />
            <text x="31" y="94.5" font-size="6.6" fill="#a3a9b8">Contacts</text>
            <circle cx="20.5" cy="114.5" r="3" fill="none" stroke="#a3a9b8" stroke-width="0.8" />
            <text x="31" y="118" font-size="6.6" fill="#a3a9b8">Reports</text>
            <path d="M22 425h3v8h-3M16 429h6" fill="none" stroke="#ea7272" stroke-width="0.9" />
            <text x="31" y="431.5" font-size="6.6" fill="#ea7272">Logout</text>

            <text x="574" y="22.5" font-size="6" fill="#cbd0da">Taleo Coles</text>
            <circle cx="627" cy="20" r="11" fill="#2a2c38" />
            <circle cx="627" cy="17" r="4" fill="#4a4d5c" />
            <path d="M619 28a8 6 0 0 1 16 0" fill="#4a4d5c" />

            <text x="165" y="63.5" font-size="12.5" font-weight="700" fill="#f5f6fa">Dashboard</text>
            <rect x="164" y="79" width="473" height="482" rx="6" fill="#15161f" />
            <text x="175" y="99" font-size="8.6" font-weight="600" fill="#f5f6fa">Overview</text>

            <g>
              <rect x="175.5" y="113.5" width="142" height="90" rx="6" fill="#ebaa2d" fill-opacity="0.13" stroke="#ebaa2d" stroke-opacity="0.28" />
              <circle cx="196" cy="135" r="11" fill="#0f172a" />
              <path d="M196 130v10M193.5 132.5h4a1.5 1.5 0 0 1 0 3h-3a1.5 1.5 0 0 0 0 3h4.5" fill="none" stroke="#ebaa2d" stroke-width="0.9" />
              <rect x="269" y="128" width="38" height="14" rx="3" fill="#1f2130" />
              <text x="273" y="137.5" font-size="5.6" fill="#7ad08d">+ 15%</text>
              <text x="186" y="177" font-size="20" font-weight="700" fill="#f5f6fa">$12,236</text>
              <text x="186" y="191" font-size="6.6" fill="#a3a9b8">Revenue</text>
            </g>
            <g>
              <rect x="329.5" y="113.5" width="142" height="90" rx="6" fill="#3ab9e1" fill-opacity="0.13" stroke="#3ab9e1" stroke-opacity="0.28" />
              <circle cx="351" cy="135" r="11" fill="#0f172a" />
              <rect x="347.5" y="131" width="7" height="8" rx="1" fill="none" stroke="#3ab9e1" stroke-width="0.9" />
              <rect x="425" y="128" width="36" height="14" rx="3" fill="#1f2130" />
              <text x="429" y="137.5" font-size="5.6" fill="#ea7272">- 15%</text>
              <text x="340" y="174" font-size="16.5" font-weight="700" fill="#f5f6fa">364</text>
              <text x="340" y="191" font-size="6.6" fill="#a3a9b8">Estimates</text>
            </g>
            <g>
              <rect x="483.5" y="113.5" width="142" height="90" rx="6" fill="#5d60f4" fill-opacity="0.26" stroke="#5d60f4" stroke-opacity="0.28" />
              <circle cx="505" cy="135" r="11" fill="#0f172a" />
              <rect x="502" y="131.5" width="6" height="7.5" rx="1" fill="none" stroke="#818cf8" stroke-width="0.9" />
              <rect x="581" y="128" width="35" height="14" rx="3" fill="#1f2130" />
              <text x="585" y="137.5" font-size="5.6" fill="#7ad08d">+ 15%</text>
              <text x="495" y="174" font-size="16.5" font-weight="700" fill="#f5f6fa">287</text>
              <text x="494" y="191" font-size="6.6" fill="#a3a9b8">Invoices</text>
            </g>

            <text x="175" y="230" font-size="7" font-weight="600" fill="#f5f6fa">Users of the last month</text>
            <rect x="573" y="224" width="6.5" height="7" rx="1" fill="none" stroke="#5d60f4" stroke-width="0.8" />
            <text x="584" y="230" font-size="5.6" fill="#5d60f4">Download CSV</text>

            <rect x="175" y="246" width="452" height="17" fill="#15161f" />
            <rect x="175" y="262" width="452" height="1" fill="#2a2c38" />
            <g font-size="5.2" fill="#a3a9b8">
              <text x="180" y="253">ID</text>
              <text x="248" y="253">Name</text>
              <text x="355" y="253">Email</text>
              <text x="475" y="253">Phone Number</text>
              <text x="563" y="253">Date of registration</text>
            </g>
            {rows.map((dy) => (
              <g font-size="5.6" fill="#a3a9b8" transform={`translate(0 ${dy})`}>
                <text x="180" y="282">102029</text>
                <text x="248" y="282" fill="#f5f6fa">Wade Warren</text>
                <text x="354" y="282">testemail1111111@gmail.com</text>
                <text x="474" y="282">+1 111 234 555</text>
                <text x="563" y="282">29 August, 2022</text>
              </g>
            ))}
          </g>
          <rect x="18" y="18" width="648.06" height="364.53" fill="url(#bidl-imac-glare)" />
        </g>
      </svg>

      <svg
        class="work-scene_phone"
        viewBox="0 0 181.37 378.03"
        xmlns="http://www.w3.org/2000/svg"
        font-family="Inter, Archivo, Arial, sans-serif"
      >
        <defs>
          <linearGradient id="bidl-phone-frame" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#3d3f45" />
            <stop offset="0.5" stop-color="#1b1c20" />
            <stop offset="1" stop-color="#2c2e33" />
          </linearGradient>
          <linearGradient id="bidl-phone-rim" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8a8d95" />
            <stop offset="0.5" stop-color="#2a2c31" />
            <stop offset="1" stop-color="#5a5d64" />
          </linearGradient>
          <linearGradient id="bidl-phone-button" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#50535a" />
            <stop offset="1" stop-color="#1e1f23" />
          </linearGradient>
          <linearGradient id="bidl-phone-glare" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0.07" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <clipPath id="bidl-phone-screen">
            <rect x="6.3" y="6.3" width="168.77" height="365.43" rx="22.5" />
          </clipPath>
        </defs>

        <rect x="0" y="70" width="1.8" height="14" rx="0.9" fill="url(#bidl-phone-button)" />
        <rect x="0" y="96" width="1.8" height="26" rx="0.9" fill="url(#bidl-phone-button)" />
        <rect x="0" y="128" width="1.8" height="26" rx="0.9" fill="url(#bidl-phone-button)" />
        <rect x="179.57" y="110" width="1.8" height="40" rx="0.9" fill="url(#bidl-phone-button)" />

        <rect x="0.9" y="0.45" width="179.57" height="377.13" rx="28.8" fill="url(#bidl-phone-frame)" stroke="url(#bidl-phone-rim)" stroke-width="0.9" />
        <rect x="2.7" y="1.8" width="175.97" height="374.43" rx="27" fill="#030304" />

        <g clip-path="url(#bidl-phone-screen)">
          <g transform="translate(6.3 6.3)">
            <rect width="169" height="366" fill="#0d0e14" />
            <rect width="169" height="42" fill="#15161f" />
            <text x="14" y="13" font-size="6" font-weight="600" fill="#f5f6fa">9:41</text>
            <rect x="140" y="8.5" width="11" height="5" rx="1.2" fill="none" stroke="#f5f6fa" stroke-width="0.6" />
            <rect x="141" y="9.5" width="8" height="3" rx="0.6" fill="#f5f6fa" />
            <text x="84.5" y="33" font-size="7" font-weight="600" fill="#f5f6fa" text-anchor="middle">Invoices</text>

            <rect x="7" y="50" width="154" height="18" rx="4" fill="#1d1f2a" />
            <circle cx="17.5" cy="59.5" r="2.3" fill="none" stroke="#6b7282" stroke-width="0.7" />
            <text x="25" y="61.5" font-size="5" fill="#8b92a3">Search your Company</text>

            <rect x="7.25" y="78.25" width="153.5" height="17.5" rx="4" fill="#15161f" stroke="#2a2c38" stroke-width="0.5" />
            <rect x="9" y="79.5" width="75" height="15" rx="3" fill="#5d60f4" />
            <text x="46.5" y="89" font-size="5.4" fill="#fff" text-anchor="middle">New</text>
            <text x="120" y="89" font-size="5.4" fill="#8b92a3" text-anchor="middle">Paid</text>

            <text x="7" y="109" font-size="5.2" fill="#8b92a3">June 2022</text>
            <text x="161" y="109.5" font-size="6.2" font-weight="600" fill="#f5f6fa" text-anchor="end">$16,583.80</text>
            <text x="8" y="267" font-size="5.2" fill="#8b92a3">May 2022</text>
            <text x="161" y="267.5" font-size="6.2" font-weight="600" fill="#f5f6fa" text-anchor="end">$12,940.00</text>

            {cards.map((card) => (
              <g transform={`translate(0 ${card.y})`}>
                <rect x="7" width="154" height="63" rx="5" fill="#15161f" />
                <text x="13" y="11.5" font-size="4.8" fill={card.tone}>{card.status}</text>
                <text x="13" y="24" font-size="6.4" font-weight="600" fill="#f5f6fa">{card.name}</text>
                <text x="13" y="33" font-size="4.8" fill="#a3a9b8">Invoice #10{card.y}</text>
                <text x="156" y="25" font-size="7" font-weight="700" fill="#f5f6fa" text-anchor="end">{card.amount}</text>
                <text x="156" y="37" font-size="4.6" fill="#a3a9b8" text-anchor="end">Total amount</text>
                <text x="22" y="54.5" font-size="4.6" fill="#a3a9b8">17 March 2022</text>
                <text x="73" y="54.5" font-size="4.6" fill="#a3a9b8">London, England</text>
                <text x="141" y="54.5" font-size="4.6" fill="#818cf8" text-anchor="end">Paid:</text>
                <text x="156" y="54.5" font-size="4.6" fill="#e6e8ee" text-anchor="end">{card.paid}</text>
              </g>
            ))}

            <circle cx="149.5" cy="306.5" r="11.5" fill="#5d60f4" />
            <path d="M149.5 303v7M146 306.5h7" stroke="#fff" stroke-width="1" />

            <rect y="321" width="169" height="45" fill="#15161f" />
            <g font-size="4.2" text-anchor="middle">
              <rect x="23" y="328" width="7" height="9" rx="1" fill="none" stroke="#8b92a3" stroke-width="0.6" />
              <text x="27" y="345" fill="#cbd0da">Estimate</text>
              <rect x="62" y="328" width="7" height="8.5" rx="1" fill="#5d60f4" />
              <text x="65.5" y="345" fill="#5d60f4">Invoice</text>
              <circle cx="103" cy="330" r="2" fill="none" stroke="#8b92a3" stroke-width="0.6" />
              <path d="M100 337a3 2.5 0 0 1 6 0" fill="none" stroke="#8b92a3" stroke-width="0.6" />
              <text x="103.5" y="345" fill="#cbd0da">Contacts</text>
