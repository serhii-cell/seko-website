---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;
---

{/*
  Osmo's Progressive Blur: five blurred layers, each masked to a band that
  sits lower and blurs harder, so what is behind fades from sharp to soft
  towards the bottom edge. It lies along the bottom of its positioned
  parent; set its height there.
*/}
{
  render && (
    <div
      class:list={["progressive-blur_wrap", className]}
      aria-hidden="true"
      {...rest}
    >
      <div class="progressive-blur_layer" />
      <div class="progressive-blur_layer" />
      <div class="progressive-blur_layer" />
      <div class="progressive-blur_layer" />
      <div class="progressive-blur_layer" />
    </div>
  )
}

<style is:global>
  @layer components {
    .progressive-blur_wrap {
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      height: 50%;
      pointer-events: none;
      isolation: isolate;
      contain: paint;
      overflow: hidden;
      transform: translateZ(0);
    }

    .progressive-blur_layer {
      position: absolute;
      inset: 0;

      &:nth-child(1) {
        backdrop-filter: blur(0.09375rem);
        mask: linear-gradient(#0000 50%, #000 62.5% 75%, #0000 87.5%);
      }
      &:nth-child(2) {
        backdrop-filter: blur(0.1875rem);
        mask: linear-gradient(#0000 62.5%, #000 75% 87.5%, #0000 100%);
      }
      &:nth-child(3) {
        backdrop-filter: blur(0.375rem);
        mask: linear-gradient(#0000 75%, #000 87.5% 100%);
      }
      &:nth-child(4) {
        backdrop-filter: blur(0.75rem);
        mask: linear-gradient(#0000 82%, #000 92% 100%);
      }
      &:nth-child(5) {
        backdrop-filter: blur(1.5rem);
        mask: linear-gradient(#0000 88%, #000 100%);
      }
    }
  }
</style>
