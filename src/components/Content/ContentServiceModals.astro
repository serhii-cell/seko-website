}

<script>
  import { onPage } from "@/utils/lifecycle.ts";
  import { asciiParticles } from "@/utils/ascii-particles.ts";

  /* Each sheet's particles run only while that sheet is open. */
  onPage(() => {
    const modals = document.querySelectorAll<HTMLDialogElement>(".service-modal_wrap");
    const stops: (() => void)[] = [];
    modals.forEach((modal) => {
      const canvas = modal.querySelector<HTMLCanvasElement>(".service-modal_particles");
      if (!canvas) return;
      const particles = asciiParticles(canvas);
      const start = () => particles.start();
      const stop = () => particles.stop();
      modal.addEventListener("modal-open", start);
      modal.addEventListener("modal-close", stop);
      /* Opened before this ran (a `?modal=` link opens it on load). */
      if (modal.open) requestAnimationFrame(start);
      stops.push(() => {
        particles.stop();
        modal.removeEventListener("modal-open", start);
        modal.removeEventListener("modal-close", stop);
      });
    });
    return () => stops.forEach((stop) => stop());
  });

  const kyiv = new Intl.DateTimeFormat("en-US", {
    timeZone: "Europe/Kyiv",
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
  });

  onPage(() => {
    const clocks = document.querySelectorAll<HTMLTimeElement>(
      ".service-modal_time",
    );
    if (clocks.length === 0) return;

    let timer = 0;
    const tick = () => {
      const now = new Date();
      const text = kyiv.format(now).replace(/\s+/g, " ");
      for (const clock of clocks) {
        clock.textContent = text;
        clock.dateTime = now.toISOString();
      }
      timer = window.setTimeout(tick, 60000 - (now.getTime() % 60000) + 5);
    };
    tick();

    return () => clearTimeout(timer);
  });
</script>

<style is:global>
  @layer components {
    .service-modal_wrap {
      --_gap: 7.5rem;
      --_inset: 5rem;
      --_band: var(--space-7);
      --button-focus: var(--text);

