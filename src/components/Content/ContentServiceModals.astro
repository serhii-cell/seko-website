            <Button
              element="link"
              href="#contact"
              class="service-modal_cta"
              data-modal-close
            >
              Book a Call
            </Button>
          </div>
        </header>

        <div class="service-modal_process">
          <Paragraph variant="label" class="color-faded">
            process
          </Paragraph>
          <Paragraph
            variant="h4"
            class="service-modal_process-text heading-accent"
          >
            <Fragment set:html={service.process} />
          </Paragraph>
        </div>

        <div class="service-modal_stages dashed dashed-block">
          <ol class="service-modal_stage-list dashed dashed-inline">
            {service.stages.map((stage, index) => (
              <li class="service-modal_stage dashed">
                <div class="service-modal_stage-head dashed dashed-bottom">
                  <Paragraph variant="label" class="color-faded">
                    {`Stage ${index + 1}`}
                  </Paragraph>
                  <Heading tag="h3" variant="h5">
                    {stage.name}
                  </Heading>
                </div>
                <ul class="service-modal_stage-items">
                  {stage.items.map((item) => (
                    <li class="color-faded">{item}</li>
                  ))}
                </ul>
              </li>
            ))}
