                    </Paragraph>
                  </div>
                  {service.cardButtons && (
                    <Button
                      element="link"
                      href="#contact"
                      size="medium"
                      class="service-modal_card-button"
                      data-modal-close
                    >
                      Book a Call
                    </Button>
