              ))}
            </ul>
          </div>
          {!service.cardButtons && (
            <Button element="link" href="#contact" data-modal-close>
              Book a Call
            </Button>
          )}
        </div>

        <figure class="service-modal_quote hatched dashed dashed-block">
          <blockquote>
            <Paragraph variant="h4" class="service-modal_quote-text">
              {QUOTE}
