const ANSWER = QUOTE;
---

{
  render &&
    SERVICES.map((service) => (
      <Modal
        id={service.id}
        label={service.title}
        variant="sheet"
        class="service-modal_wrap theme-light"
        data-reveal="own"
      >
        {/* Green ASCII embers rising over the blurred page, behind the sheet. */}
        <canvas slot="backdrop" class="service-modal_particles" />
        <header class="service-modal_header dashed dashed-block dashed-inline">
          <div class="service-modal_intro">
            <div class="service-modal_icon hatched">
