import crtMonitor from "@/assets/home/modals/icon-website-crt-monitor.svg";
import openBox from "@/assets/home/modals/icon-product-open-box.svg";
import magnifyingGlass from "@/assets/home/modals/icon-audit-magnifying-glass.svg";
import suitcase from "@/assets/home/modals/card-website-corporate-suitcase.svg";
import cart from "@/assets/home/modals/card-website-ecommerce-cart.svg";
