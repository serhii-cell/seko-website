      }
    }

    .service-modal_quote-text {
      max-width: 40rem;
    }

    .service-modal_author {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    /* FAQ */
    .service-modal_faq-title {
      padding: 0 var(--_inset) var(--space-7);
    }

    .service-modal_faq-list {
      padding-inline: 10rem;

      @media (width < 64rem) {
        padding-inline: var(--_band);
