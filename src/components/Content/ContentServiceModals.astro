        </div>

        <div class="service-modal_offer">
          <Heading tag="h3" variant="h4" class="service-modal_centered">
            {service.offerHeading}
          </Heading>
          <div class="service-modal_band dashed dashed-block">
            <ul class="service-modal_cards">
              {service.cards.map((card) => (
                <li class="service-modal_card hatched dashed dashed-inline">
                  <div class="service-modal_art">
                    <img
                      src={card.art.src}
                      width={card.art.width}
                      height={card.art.height}
