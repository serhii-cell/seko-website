        display: flex;
        flex-direction: column;
        gap: var(--_gap);
      }

      & :is(.heading, .text) {
        margin-block: 0;
      }

      & :is(.text-style-h5, .text-style-main, .text-style-label) {
        --_trim-top: 0.5lh;
        --_trim-bottom: 0.5lh;
      }

      @media (width < 64rem) {
        --_gap: 4.5rem;
        --_inset: var(--space-5);
        --_band: var(--space-3);
      }
    }

    .service-modal_centered {
      text-align: center;
    }

    /* Header */
