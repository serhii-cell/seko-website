        to bottom,
        var(--stroke) 0 var(--dash),
        transparent 0 calc(var(--dash) * 2)
      );
      background-position: right top;
      background-size: var(--border-width) 100%;
      background-repeat: no-repeat;

      @media (width < 64rem) {
        gap: var(--space-4);
        padding-block: var(--space-8) var(--space-6);
        padding-inline-end: 4.5rem;
        background-image: none;
      }
    }

    .service-modal_actions {
      justify-content: end;

      @media (width < 64rem) {
        justify-content: space-between;
        padding-block: var(--space-5);
        background-image: repeating-linear-gradient(
          to right,
          var(--stroke) 0 var(--dash),
          transparent 0 calc(var(--dash) * 2)
        );
        background-size: 100% var(--border-width);
        background-repeat: no-repeat;
      }
    }

    .service-modal_icon {
      --_hatch: 2%;
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 7.5rem;
      height: 7.5rem;
      background-color: var(--background-2);
      overflow: clip;

      & img {
        width: auto;
        max-width: 92%;
        height: auto;
      }

      @media (width < 64rem) {
        width: 5rem;
        height: 5rem;
      }
    }

    .service-modal_title {
      flex: none;
      width: 17.4375rem;

      @media (width < 64rem) {
        flex: 1;
        width: auto;
      }
    }

    .service-modal_cta {
      flex: none;
    }

    .service-modal_clock {
      color: var(--text-2);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-huge);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    /* Process */
    .service-modal_process {
      display: grid;
      grid-template-columns: 10.5rem minmax(0, 39.5625rem);
      align-items: start;
      padding-inline: var(--_inset);

      @media (width < 64rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-4);
      }
    }

    /* Stages */
    .service-modal_stages {
      --dash: 0.125rem;
      padding-inline: var(--_band);
    }

    .service-modal_stage-list {
      --dash: 0.1875rem;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));

      @media (width < 64rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @media (width < 48rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .service-modal_stage {
      display: flex;
      flex-direction: column;

      &:not(:last-child) {
        --_dash-right: var(--border-width);
      }

      @media (width < 64rem) {
        &:nth-child(2n) {
          --_dash-right: 0px;
        }
        &:nth-child(-n + 2) {
          --_dash-bottom: var(--border-width);
        }
      }

      @media (width < 48rem) {
        --_dash-right: 0px;
        --_dash-bottom: var(--border-width);
        &:last-child {
          --_dash-bottom: 0px;
        }
      }
    }

    .service-modal_stage-head {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding: var(--space-5) var(--space-5) var(--space-3);
      background-color: var(--background-2);
    }

    .service-modal_stage-items {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin: 0;
      padding: var(--space-5);
    }

    /* Cards */
    .service-modal_offer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);

      & > .service-modal_centered {
        padding-inline: var(--_inset);
      }
    }

    .service-modal_band {
      align-self: stretch;
      padding-inline: var(--_band);
    }

    .service-modal_cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
      margin: 0;

      @media (width < 64rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .service-modal_card {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-5);
      background-color: var(--background-2);
    }

    .service-modal_art {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 14.8125rem;
      background-color: var(--background);

      & img {
        width: auto;
        max-width: 80%;
        height: auto;
        max-height: 80%;
      }
    }

    .service-modal_card-text {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .service-modal_card-button {
      width: 100%;
      margin-top: auto;
    }

    /* Testimonial */
    .service-modal_quote {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-7);
      margin: 0;
      padding: var(--_gap) var(--_inset);
      background-color: var(--background-2);
      text-align: center;

      & blockquote {
