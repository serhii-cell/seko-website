---
import type { ImageMetadata } from "astro";
import type { SvgComponent } from "astro/types";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Icon from "@/components/Media/Icon.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The line above the logos. */
  text?: string;
  /**
   * One cell per logo: the SVG, the client's name for screen readers, and
   * optionally a `scale` to even out a logo that still looks heavier or
   * lighter than the rest (1 is as is).
   */
  logos?: { src: SvgComponent & ImageMetadata; name: string; scale?: number }[];
}

const { render = true, text, logos = [] } = Astro.props;

/* Logos are balanced by area rather than width or height: each is sized so
   it covers about the same space, so a long word mark doesn't come out
   bigger than a compact one. */
const AREA = 2900;
const widths = logos.map((logo) => {
  const ratio = logo.src.width / logo.src.height;
  return Math.sqrt(AREA * ratio) * (logo.scale ?? 1);
});
const widest = Math.max(...widths, 1);
/* Each logo's width, and its share of the widest, so that in narrow cells
   they all shrink together and keep their balance. */
const sizeOf = (index: number) =>
  `--_width: ${widths[index] / 16}rem; --_share: ${widths[index] / widest}`;
---

{
  render && logos.length > 0 && (
    <div class="logos-main_wrap" data-reveal="own">
      <div class="logos-main_head" data-step="5">
        <span class="logos-main_guide" aria-hidden="true" />
        <Paragraph
          variant="mono"
          class="logos-main_text color-faded"
          render={!!text}
        >
          {text}
        </Paragraph>
      </div>
      <div class="logos-main_band" data-step="6">
        <ul class="logos-main_list">
          {logos.map((logo, index) => (
            <li class="logos-main_item">
              <span class="logos-main_logo" style={sizeOf(index)}>
                <Icon
                  src={logo.src}
                  variant="full-width"
                  role="img"
                  aria-label={logo.name}
                />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<script>
  import { gsap, ScrollTrigger } from "@/utils/gsap.ts";
  import { onPage } from "@/utils/lifecycle.ts";
  import { onIntroStep, stepOf } from "@/utils/intro.ts";
  import { createLines } from "@/utils/lines.ts";

  /* The line rises in over a single rule; the rule opens downward into the
     cells while the hatch inside drifts left to right, then the logos fade
     in one after another. On the first screen it starts as the hero's ASCII
     page's first-screen sequence; further down, when it scrolls into view. */
  function setUp(wrap: HTMLElement) {
    const text = wrap.querySelector<HTMLElement>(".logos-main_text");
    const band = wrap.querySelector<HTMLElement>(".logos-main_band");
    const list = wrap.querySelector<HTMLElement>(".logos-main_list");
    const logos = gsap.utils.toArray<HTMLElement>(".logos-main_logo", wrap);
    if (!band || !list) return () => {};

    const lines = text ? createLines(text) : null;
    gsap.set(band, { borderBottomColor: "transparent" });
    gsap.set(list, { height: 0, overflow: "hidden", "--_hatch": "0rem" });
    gsap.set(logos, { autoAlpha: 0 });

    let timeline: gsap.core.Timeline | undefined;
    const showLine = () => lines?.play();
    const openBand = (delay = 0) => {
      timeline = gsap
        .timeline({ delay })
        .set(band, { clearProps: "borderBottomColor" })
        .to(list, { height: "auto", duration: 0.9, ease: "power3.inOut" })
        .to(
          list,
          { "--_hatch": "3rem", duration: 0.9, ease: "power2.out" },
          "<",
        )
        .set(list, { clearProps: "height,overflow" })
        .to(
          logos,
          {
            autoAlpha: 1,
            duration: 0.4,
            stagger: 0.06,
            clearProps: "opacity,visibility",
          },
          "-=0.2",
        );
    };

    /* On the first screen the line and the strip each take their step in the
       page's sequence; further down they play together on scroll. */
    let trigger: ScrollTrigger | undefined;
    const waits: (() => void)[] = [];
    if (ScrollTrigger.isInViewport(band)) {
      if (text) waits.push(onIntroStep(stepOf(text), showLine));
      waits.push(onIntroStep(stepOf(band), () => openBand()));
    } else {
      trigger = ScrollTrigger.create({
        trigger: wrap,
        start: "top 85%",
        once: true,
        onEnter: () => {
          showLine();
          openBand(0.15);
        },
      });
    }

    return () => {
      waits.forEach((stop) => stop());
      trigger?.kill();
      timeline?.kill();
      lines?.revert();
      gsap.set([band, list, ...logos], { clearProps: "all" });
    };
  }

  onPage(() => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const cleanups = [
      ...document.querySelectorAll<HTMLElement>(".logos-main_wrap"),
    ].map(setUp);
    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>

<style is:global>
  @layer components {
    .logos-main_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      width: 100%;
    }

    /* Carries the hero's vertical guide on from the top of this section to
       the strip: on the working area it runs through the middle of the
       hero's ASCII container, 1303px in from the left at 1640px wide. */
    .logos-main_head {
      position: relative;
    }

    .logos-main_guide {
      display: none;
      @media (width >= 64rem) {
        display: block;
        position: absolute;
        top: 0;
        bottom: calc(var(--space-5) * -1);
        clip-path: inset(0 0 calc((1 - var(--_draw-y, 1)) * 100%) 0);
        left: calc(1303 / 1640 * 100%);
        width: var(--border-width);
        background: repeating-linear-gradient(
          to bottom,
          var(--stroke) 0 var(--dash),
          transparent 0 calc(var(--dash) * 2)
        );
      }
    }

    .logos-main_text {
      margin: 0;
    }

    /* A full-width band, ruled above and below; the cells sit in the
       working area under a faint diagonal hatch. */
    .logos-main_band {
      position: relative;
      width: 100vw;
      margin-inline: calc(50% - 50vw);
      border-block: var(--border-width) solid var(--stroke);
    }

    .logos-main_list {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: min(var(--site-width), var(--max-width-main));
      margin-inline: auto;
      border-right: var(--border-width) solid var(--stroke);
      @media (width >= 48rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(6, minmax(0, 1fr));
      }
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-linear-gradient(
          -60deg,
          color-mix(in lab, var(--light-100) 2%, transparent) 0 1px,
          transparent 1px 0.5rem
        );
        background-position: var(--_hatch, 0rem) 0;
      }
    }

    .logos-main_item {
      container-type: inline-size;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-5);
      background-color: var(--background-2);
      border-left: var(--border-width) solid var(--stroke);
      border-bottom: var(--border-width) solid var(--stroke);
      @media (width >= 64rem) {
        border-bottom: 0;
      }
    }

    /* Grey, so the logos read without pulling focus. */
    .logos-main_logo {
      flex: none;
      width: min(var(--_width, 9.125rem), 100cqw * var(--_share, 1));
      color: color-mix(in lab, var(--light-100) 40%, transparent);
    }
  }
</style>
