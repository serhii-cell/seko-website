---
import type { SvgComponent } from "astro/types";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Icon from "@/components/Media/Icon.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The line above the logos. */
  text?: string;
  /** One item per logo: the SVG, and the client's name for screen readers. */
  logos?: { src: SvgComponent; name: string }[];
}

const { render = true, text, logos = [] } = Astro.props;
---

{
  render && logos.length > 0 && (
    <div class="logos-main_wrap">
      <Eyebrow
        class="logos-main_text color-faded"
        data-marker="off"
        render={!!text}
      >
        {text}
      </Eyebrow>
      <ul class="logos-main_list">
        {logos.map((logo) => (
          <li class="logos-main_item">
            <Icon src={logo.src} role="img" aria-label={logo.name} />
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Out to the page frame's lines, ruled above and below so the text and the
       logos read as one band. */
    .logos-main_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      /* The container lays its children out from the start, so the band has to
         claim the full width before the insets are pulled back. */
      align-self: stretch;
      margin-inline: calc(var(--content-inset) * -1);
      padding-block: var(--space-6);
      background:
        linear-gradient(var(--border-faint) 0 0) top / 100% var(--border-width)
          no-repeat,
        linear-gradient(var(--border-faint) 0 0) bottom / 100%
          var(--border-width) no-repeat;
    }

    /* A label rather than a sentence: mono caps, small and tracked out, with no
       marker beside it and no margin of its own, so the band's padding holds it
       the same distance from both lines. */
    .logos-main_text {
      align-self: center;
      margin-block: 0;
      text-align: center;
      & .eyebrow_marker {
        display: none;
      }
      & .eyebrow_text {
        font-family: var(--mono-family);
        font-size: 0.75rem;
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
      }
    }

    /* One row spread across the band, wrapping onto a second where a narrow
       screen leaves no room. */
    .logos-main_list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: var(--space-5) var(--space-6);
      padding-inline: var(--content-inset);
      /* Spread only where they fit on one line; wrapped rows read better
         centred. */
      @media (width >= 48rem) {
        justify-content: space-between;
      }
    }

    /* Grey, so the logos read without pulling focus. */
    .logos-main_item {
      display: flex;
      align-items: center;
      color: color-mix(in lab, var(--text) 40%, transparent);
      & .icon {
        /* A wordmark is wider than it is tall, so its own ratio decides the
           width rather than the icon default's square. */
        aspect-ratio: auto;
        width: auto;
        height: 1.75rem;
      }
    }
  }
</style>
