---
import type { SvgComponent } from "astro/types";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Icon from "@/components/Media/Icon.astro";
import Marquee from "@/components/Interactive/Marquee.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The line above the logos. */
  text?: string;
  /** One item per logo: the SVG, and the client's name for screen readers. */
  logos?: { src: SvgComponent; name: string }[];
  /** Which way the logos travel. Defaults to `forwards`, which runs them leftwards. */
  direction?: "forwards" | "backwards";
}

const { render = true, text, logos = [], direction = "forwards" } = Astro.props;
---

{
  render && logos.length > 0 && (
    <div class="logos-main_wrap">
      <Paragraph
        variant="main"
        class="logos-main_text color-faded"
        data-marker="off"
        render={!!text}
      >
        {text}
      </Paragraph>
      <Marquee label="Clients" direction={direction} class="logos-main_strip">
        {logos.map((logo) => (
          <span class="logos-main_logo">
            <Icon src={logo.src} role="img" aria-label={logo.name} />
          </span>
        ))}
      </Marquee>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Out to the page frame's lines, ruled above and below so the text and the
       logos read as one band. */
    .logos-main_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      /* The container lays its children out from the start, so the band has to
         claim the full width before the insets are pulled back. */
      align-self: stretch;
      margin-inline: calc(var(--content-inset) * -1);
      padding-block: var(--space-6);
      background:
        linear-gradient(var(--border-faint) 0 0) top / 100% var(--border-width)
          no-repeat,
        linear-gradient(var(--border-faint) 0 0) bottom / 100%
          var(--border-width) no-repeat;
    }

    .logos-main_text {
      align-self: center;
      text-align: center;
    }

    /* The strip runs edge to edge, so a logo leaves the page rather than
       stopping at the content's inset. It drifts rather than scrolls. */
    .logos-main_strip {
      --_gap-size: var(--space-8);
      --_item-height: 1.25rem;
      --_speed: 8s;
    }

    /* The control stays for anyone who needs to stop the motion, and comes
       back into view on focus, but it is out of the way of the logos. */
    .logos-main_strip .marquee_toggle {
      white-space: nowrap;
      clip: rect(0, 0, 0, 0);
      border-width: 0;
      width: 1px;
      height: 1px;
      margin-inline: auto;
      padding: 0;
      position: absolute;
      inset: 0% 0% auto;
      overflow: hidden;
      &:focus-visible {
        clip: auto;
        width: auto;
        height: auto;
        position: static;
        overflow: visible;
      }
    }

    /* Each mark keeps its own width at a shared height, as a row of real
       logos does. Grey, so they read without pulling focus. */
    .logos-main_logo {
      display: flex;
      align-items: center;
      color: color-mix(in lab, var(--text) 40%, transparent);
      & .icon {
        /* A wordmark is wider than it is tall, so its own ratio decides the
           width rather than the icon default's square. */
        aspect-ratio: auto;
        width: auto;
        height: var(--_item-height);
      }
    }
  }
</style>
