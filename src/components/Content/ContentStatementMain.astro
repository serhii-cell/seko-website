---
import Heading from "@/components/Typography/Heading.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The statement. Nothing is output without it. */
  heading?: string;
}

const { render = true, heading } = Astro.props;
---

{
  render && heading && (
    <Heading tag="h2" class="statement-main_title">
      {heading}
    </Heading>
  )
}

<style is:global>
  @layer components {
    /* A fixed-width box in the middle, so it never shifts when the marker
       reveal's line wrappers come and go. */
    .statement-main_title {
      align-self: center;
      width: 100%;
      max-width: 53.75rem;
    }
  }
</style>
