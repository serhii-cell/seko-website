---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Img from "@/components/Media/Img.astro";
import Overlay from "@/components/Media/Overlay.astro";
import ProgressiveBlur from "@/components/Media/ProgressiveBlur.astro";
import { slotContent } from "@/utils/slots.ts";

type CardVariant = "default" | "cover" | "stacked" | "work";
type CardTheme = "inherit" | "light" | "dark" | "brand" | "invert";
type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type ImageSource = ImageMetadata | string;

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Small line of text above the heading. Inline markup is rendered. */
  eyebrow?: string;
  /** The card's title. Inline markup is rendered. */
  heading?: string;
  /** Heading level, for the page outline. Every card heading is the same size. */
  headingTag?: HeadingTag;
  /**
   * Body copy under the heading. Inline markup is rendered, so it can carry a
   * link — one inside a clickable card stays clickable on its own.
   */
  text?: string;
  /** Label of the closing button. Nothing renders without one. */
  buttonLabel?: string;
  /** Where the button leads. Left out, it renders as a plain button. */
  buttonHref?: string;
  /**
   * Where the image sits.
   *
   * - `default` — no image, text only (default)
   * - `cover` — image fills the card, text over it
   * - `stacked` — image above the text, bleeding to the edges
   * - `work` — a case study: a visual that fills the screen's height, its
   *   tags in the top corner and its title and subtitle along the bottom
   *   over a progressive blur; the whole card links to `href`
   */
  variant?: CardVariant;
  /** Colors the card carries with it, whatever section it sits in. */
  theme?: CardTheme;
};

type Props = Base &
  (
    | {
        variant?: "default";
        image?: never;
        imageAlt?: never;
        tags?: never;
        subtitle?: never;
        href?: never;
        cursor?: never;
      }
    | {
        variant: "cover";
        /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
        image?: ImageSource;
        /** Leave unset on decorative images — renders `alt=""`. */
        imageAlt?: string;
        tags?: never;
        subtitle?: never;
        href?: never;
        cursor?: never;
      }
    | {
        variant: "stacked";
        /** A stacked card has no surface of its own, so it keeps the theme around it. */
        theme?: never;
        /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
        image?: ImageSource;
        /** Leave unset on decorative images — renders `alt=""`. */
        imageAlt?: string;
        tags?: never;
        subtitle?: never;
        href?: never;
        cursor?: never;
      }
    | {
        variant: "work";
        /** A work card sits on the section's own surface, so it keeps the theme around it. */
        theme?: never;
        /** A work card says what it is through its hover facts, not body text. */
        text?: never;
        buttonLabel?: never;
        buttonHref?: never;
        /**
         * An imported asset, a remote `http(s)` URL, or a path to a file in
         * `public/`. A `media` slot, when filled, takes its place.
         */
        image?: ImageSource;
        /** Leave unset on decorative images — renders `alt=""`. */
        imageAlt?: string;
        /** Short labels in hairline tags above the visual. */
        tags?: string[];
        /** Line under the heading, such as the kind of work done. */
        subtitle?: string;
        /** The case study the card leads to. */
        href?: string;
        /** Short facts the scramble cursor cycles through while the card is hovered, such as a result, the platform and "Open case". `BaseLayout` renders the cursor. */
        cursor?: string[];
        /**
         * ASCII drawn over the image on hover: the URL of a glyph layer the
         * image's size (white glyphs on transparent), and its character
         * grid as `[width, height, x offset, y offset]` in the layer's px.
         * Leave unset for no ASCII. A `media` slot draws its own.
         */
        glyphs?: { src: string; grid: [number, number, number, number] };
      }
  );

type AllProps = Base & {
  image?: ImageSource;
  imageAlt?: string;
  tags?: string[];
  subtitle?: string;
  href?: string;
  cursor?: string[];
  glyphs?: { src: string; grid: [number, number, number, number] };
};

const {
  render = true,
  eyebrow,
  heading,
  headingTag = "h3",
  text,
  buttonLabel,
  buttonHref,
  variant = "default",
  theme = "inherit",
  image,
  imageAlt,
  tags = [],
  subtitle,
  href,
  cursor = [],
  glyphs,
  class: className,
  ...rest
} = Astro.props as AllProps;

const isWork = variant === "work";
const media = isWork ? await slotContent(Astro.slots, "media") : "";
const hasImage = variant !== "default" && !!(image || media);
const hasContent = !!(eyebrow || heading || text || buttonLabel);
const hasTheme = variant !== "stacked" && !isWork && theme !== "inherit";

/* The button each variant closes with, so a set of cards reads as one system.
   A link carries no emphasis of its own, so the two are picked together. */
const buttonKind =
  variant === "stacked"
    ? ({ variant: "link" } as const)
    : ({ emphasis: variant === "cover" ? "primary" : "secondary" } as const);

if (import.meta.env.DEV && render) {
  if ((variant === "stacked" || isWork) && theme !== "inherit") {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no surface to color, so \`theme\` was dropped. It keeps the theme around it.`,
    );
  }
  if (variant === "default" && image) {
    console.warn(
      '[lumos] <Card variant="default"> holds no image, so `image` was dropped. Use the cover or stacked variant to show it.',
    );
  }
  if (variant !== "default" && !image && !media) {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no \`image\`, so it renders as a plain card.`,
    );
  }
}
---

{
  render && isWork && heading && (
    <div
      class:list={["card_wrap", "work", className]}
      data-cursor-hover={cursor.length > 0 ? "" : undefined}
      data-cursor-text={cursor.length > 0 ? cursor.join("|") : undefined}
      {...rest}
    >
      {hasImage && (
        <div class="card_visual">
          <div class="card_media">
            {media ? (
              <Fragment set:html={media} />
            ) : (
              <Img
                src={image!}
                alt={imageAlt}
                variant="constrained"
                sizes="(min-width: 64rem) 80vw, 90vw"
              />
            )}
            {!media && glyphs && (
              <canvas
                class="card_glyphs"
                aria-hidden="true"
                data-src={glyphs.src}
                data-grid={glyphs.grid.join(",")}
              />
            )}
          </div>
          <ProgressiveBlur class="card_blur" />
          <span class="card_shade" aria-hidden="true" />
          {tags.length > 0 && (
            <ul class="card_tags" role="list">
              {tags.map((tag) => (
                <li class="card_tag text-style-label">{tag}</li>
              ))}
            </ul>
          )}
          <div class="card_caption" data-lines="off">
            <Heading tag={headingTag} variant="h3">
              {href ? (
                <a class="card_link" href={href}>
                  <Fragment set:html={heading} />
                </a>
              ) : (
                <Fragment set:html={heading} />
              )}
            </Heading>
            <Paragraph class="card_subtitle" variant="label">
              <Fragment set:html={subtitle} />
            </Paragraph>
          </div>
        </div>
      )}
    </div>
  )
}

{
  render && !isWork && (hasContent || hasImage) && (
    <div
      class:list={[
        "card_wrap",
        variant !== "default" && variant,
        hasTheme && `theme-${theme}`,
        className,
      ]}
      {...rest}
    >
      {hasImage && (
        <div class="card_visual">
          <Img src={image!} alt={imageAlt} />
          {variant === "cover" && <Overlay variant="gradient" />}
        </div>
      )}
      {hasContent && (
        <div class="card_content margin-trim">
          <Eyebrow>
            <Fragment set:html={eyebrow} />
          </Eyebrow>
          <Heading tag={headingTag} variant="h5">
            <Fragment set:html={heading} />
          </Heading>
          <Paragraph>
            <Fragment set:html={text} />
          </Paragraph>
          <ButtonWrapper>
            {buttonHref ? (
              <Button element="link" href={buttonHref} {...buttonKind}>
                {buttonLabel}
              </Button>
            ) : (
              <Button {...buttonKind}>{buttonLabel}</Button>
            )}
          </ButtonWrapper>
        </div>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .card_wrap {
      --_padding: var(--space-6);
      --_min-height: 20rem;
      --_visual-ratio: 3 / 2;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--_padding);
      position: relative;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      overflow: clip;

      &.cover {
        min-height: var(--_min-height);
      }
      &.stacked {
        background-color: transparent;
        overflow: visible;
      }
    }

    .card_visual {
      position: relative;
      width: 100%;
      flex: none;
      border-radius: inherit;
      overflow: clip;

      .stacked > & {
        aspect-ratio: var(--_visual-ratio);
      }

      .cover > & {
        position: absolute;
        inset: 0;
        height: 100%;
        pointer-events: none;
      }

      > :is(.image, .video) {
        width: 100%;
        height: 100%;
      }
    }

    /* Media fills its box, be that the whole card or the band across its top.
       The component layer puts this above the `height: auto` every image and
       video starts from. */
    .card_visual > :is(.image, .video) {
      width: 100%;
      height: 100%;
    }

    /* Buttons closing a card sit on its floor, however tall the row around it
       grows. This outranks the margin `.button-wrapper` sets for itself. */
    .card_content > .button-wrapper:last-child {
      margin-top: auto;
      padding-top: var(--space-6);
    }

    .card_content {
      display: flex;
      flex-direction: column;
      align-items: var(--_alignment, start);
      text-align: var(--_alignment, start);
      flex-grow: 1;
      width: 100%;
      max-width: 100%;
      padding: var(--_padding);

      .cover > & {
        z-index: 1;
      }

      .stacked > & {
        padding-inline: 0;
        padding-top: 0;
      }
    }

    /* Work: a case study, the whole card one link. The card is its picture,
       at the design's 1249 × 725, as wide as the row makes it; the tags and
       the name sit on it. */
    .card_wrap.work {
      --_visual-ratio: 1249 / 725;
      container: card / inline-size;
      gap: 0;
      background-color: transparent;
      border-radius: 0.125rem;
      overflow: visible;
      outline: var(--focus-width) solid transparent;
      outline-offset: 0;
      transition: outline-color var(--hover-duration) var(--hover-ease);

      &:has(.card_link:focus-visible) {
        outline-color: var(--brand-500);
      }
    }

    /* The media, blur and shade are stacked layers; the caption is the one
       grid item, so its link's cover reaches the whole visual. */
    .work > .card_visual {
      display: grid;
      aspect-ratio: var(--_visual-ratio);
      border-radius: 0;
      isolation: isolate;
    }

    .card_media {
      position: absolute;
      inset: 0;
      transition: scale calc(var(--hover-duration) * 3) var(--hover-ease);

      > * {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .card_blur {
      height: 80%;
    }

    /* The ASCII drawn on hover, over the picture and scaled with it. */
    .card_glyphs {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    /* A soft, eased darkening under the name, so it reads on bright images
       and shows no top edge. */
    .card_shade {
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      height: 75%;
      pointer-events: none;
      background-image: linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--dark-950) 2%, transparent) 20%,
        color-mix(in srgb, var(--dark-950) 8%, transparent) 40%,
        color-mix(in srgb, var(--dark-950) 19%, transparent) 60%,
        color-mix(in srgb, var(--dark-950) 33%, transparent) 80%,
        color-mix(in srgb, var(--dark-950) 48%, transparent) 100%
      );
    }

    /* Tags in the top corner, the name in the bottom one, both inset the
       same. Clicks pass through the tags to the card's link. */
    .card_tags {
      position: absolute;
      top: var(--space-4);
      left: var(--space-4);
      right: var(--space-4);
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin: 0;
      padding: 0;
      list-style: none;
      pointer-events: none;
    }

    /* Square hairline tags on a dark plate, like the scramble cursor. */
    .card_tag {
      padding: 0.5em 0.65em;
      background-color: var(--dark-950);
      border: var(--border-width) solid
        color-mix(in srgb, var(--light-100) 18%, transparent);
      color: color-mix(in srgb, var(--light-100) 75%, transparent);
      line-height: 1;
    }

    .card_caption {
      z-index: 1;
      align-self: end;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-4);
      color: var(--light-100);
      text-align: start;

      > .heading {
        margin: 0;
        transition: color var(--hover-duration) var(--hover-ease);
      }
    }

    /* The subtitle keeps its full line box; only the heading is trimmed to
       its caps. */
    .card_subtitle {
      --_trim-top: 0.5lh;
      --_trim-bottom: 0.5lh;
      margin: 0;
      color: color-mix(in srgb, var(--light-100) 70%, transparent);
    }

    .card_link {
      color: inherit;
      text-decoration: none;
      outline: none;

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
      }
    }

    .work:has(.card_link:focus-visible) .card_caption > .heading {
      color: var(--brand-500);
    }

    @media (hover: hover) {
      .work:has(.card_link):hover .card_media {
        scale: 1.04;
      }
    }

    .card_wrap:has(.button_wrap) {
      .button_wrap::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      .card_content a:not(.button_wrap) {
        position: relative;
        z-index: 1;
      }

      .image {
        transition: scale calc(var(--hover-duration) * 2) var(--hover-ease);
      }

      @media (hover: hover) {
        &:hover .image {
          scale: 1.04;
        }
      }
    }
  }
</style>

<script>
  import { onPage } from "@/utils/lifecycle.ts";
  import { glyphHover } from "@/utils/glyph-hover.ts";

  /* Work cards with ASCII bring it in on hover. */
  onPage(() => {
    const stops = [...document.querySelectorAll<HTMLElement>(".card_wrap.work")]
      .filter((card) => card.querySelector(".card_glyphs"))
      .map(glyphHover);
    return () => stops.forEach((stop) => stop());
  });
</script>
